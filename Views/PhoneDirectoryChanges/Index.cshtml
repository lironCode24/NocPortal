    // ─── עצב טבלת שינויים ────────────────────────────────────────
    renderChanges() {
        const el = document.getElementById('changesContent');
        if (!el) return;

        // ─── סנן לפי פילטר פעיל ──────────────────────────────────
        const filtered = this.getFilteredChanges();

        // ─── עדכן מספרים בטאבים ──────────────────────────────────
        this.updateTabCounts();

        if (filtered.length === 0) {
            el.innerHTML = `
                <div class="changes-empty">
                    <i class="fas fa-check-circle"
                       style="color:var(--clr-new)"></i>
                    <p>אין שינויים להצגה</p>
                </div>`;
            return;
        }

        // ─── בנה טבלה ────────────────────────────────────────────
        let html = `
            <div class="changes-table-wrap">
                <table class="changes-table" id="changesTable">
                    <thead>
                        <tr>
                            <th style="width:36px">
                                <input type="checkbox"
                                       id="selectAllChanges"
                                       title="בחר הכל"
                                       onchange="ChangesManager
                                           .toggleSelectAll(this.checked)">
                            </th>
                            <th>שם עובד</th>
                            <th>מזהה עובד</th>
                            <th>סוג שינוי</th>
                            <th>שדה</th>
                            <th>ערך קודם</th>
                            <th>ערך חדש</th>
                            <th>סטטוס</th>
                            <th>פעולות</th>
                        </tr>
                    </thead>
                    <tbody>
        `;

        filtered.forEach(change => {
            const isPending   = change.status === 0;
            const isApproved  = change.status === 1;
            const isRejected  = change.status === 2;

            const typeBadge   = this.getTypeBadge(change.changeType);
            const statusBadge = this.getStatusBadge(change.status);

            const oldVal = change.oldValue
                ? `<span class="value-old">
                       ${escHtml(change.oldValue)}
                   </span>`
                : `<span class="value-empty">ריק</span>`;

            const newVal = change.newValue
                ? `<span class="value-new">
                       ${escHtml(change.newValue)}
                   </span>`
                : `<span class="value-empty">ריק</span>`;

            const processedInfo = !isPending && change.processedBy
                ? `<div class="processed-info">
                       <i class="fas fa-user" style="font-size:.65rem"></i>
                       ${escHtml(change.processedBy)}
                       ${change.processedAt
                           ? ' · ' + formatDate(change.processedAt)
                           : ''}
                   </div>`
                : '';

            html += `
                <tr data-change-id="${escHtml(change.changeId)}"
                    data-status="${change.status}">
                    <td>
                        <input type="checkbox"
                               class="change-checkbox"
                               data-change-id="${escHtml(change.changeId)}"
                               ${!isPending ? 'disabled' : ''}
                               ${!isPending ? 'style="opacity:.3"' : ''}>
                    </td>
                    <td>
                        <div class="employee-name-cell">
                            ${escHtml(change.employeeName)}
                        </div>
                    </td>
                    <td>
                        <div class="employee-id-cell">
                            ${change.employeeId
                                ? escHtml(change.employeeId)
                                : '<span style="color:rgba(255,255,255,.2)">—</span>'}
                        </div>
                    </td>
                    <td>${typeBadge}</td>
                    <td style="color:rgba(255,255,255,.6);font-size:.82rem">
                        ${escHtml(change.fieldName)}
                    </td>
                    <td>${oldVal}</td>
                    <td>${newVal}</td>
                    <td>
                        ${statusBadge}
                        ${processedInfo}
                    </td>
                    <td>
                        <div class="row-actions">
                            <button class="btn-approve-row"
                                    onclick="ChangesManager.approveOne(
                                        '${escHtml(change.changeId)}')"
                                    ${!isPending ? 'disabled' : ''}
                                    title="אשר שינוי">
                                <i class="fas fa-check"></i>
                                אשר
                            </button>
                            <button class="btn-reject-row"
                                    onclick="ChangesManager.rejectOne(
                                        '${escHtml(change.changeId)}')"
                                    ${!isPending ? 'disabled' : ''}
                                    title="דחה שינוי">
                                <i class="fas fa-times"></i>
                                דחה
                            </button>
                        </div>
                    </td>
                </tr>
            `;
        });

        html += `
                    </tbody>
                </table>
            </div>
        `;

        el.innerHTML = html;
    },

    // ─── קבל שינויים מסוננים ─────────────────────────────────────
    getFilteredChanges() {
        switch (this.activeFilter) {
            case 'new':
                return this.allChanges.filter(c => c.changeType === 0);
            case 'removed':
                return this.allChanges.filter(c => c.changeType === 1);
            case 'changed':
                return this.allChanges.filter(c =>
                    c.changeType !== 0 && c.changeType !== 1);
            case 'pending':
                return this.allChanges.filter(c => c.status === 0);
            case 'approved':
                return this.allChanges.filter(c => c.status === 1);
            case 'rejected':
                return this.allChanges.filter(c => c.status === 2);
            default:
                return this.allChanges;
        }
    },

    // ─── עדכן מספרים בטאבים ──────────────────────────────────────
    updateTabCounts() {
        const counts = {
            all:      this.allChanges.length,
            new:      this.allChanges.filter(c => c.changeType === 0).length,
            removed:  this.allChanges.filter(c => c.changeType === 1).length,
            changed:  this.allChanges.filter(c =>
                          c.changeType !== 0 && c.changeType !== 1).length,
            pending:  this.allChanges.filter(c => c.status === 0).length,
            approved: this.allChanges.filter(c => c.status === 1).length,
            rejected: this.allChanges.filter(c => c.status === 2).length
        };

        Object.entries(counts).forEach(([key, val]) => {
            const el = document.getElementById(`count-${key}`);
            if (el) el.textContent = val;
        });
    },

    // ─── תגית סוג שינוי ──────────────────────────────────────────
    getTypeBadge(changeType) {
        const types = {
            0: { cls: 'new',     icon: 'fa-user-plus',  label: 'עובד חדש'    },
            1: { cls: 'removed', icon: 'fa-user-minus', label: 'עובד שהוסר'  },
            2: { cls: 'changed', icon: 'fa-font',       label: 'שינוי שם'    },
            3: { cls: 'changed', icon: 'fa-briefcase',  label: 'שינוי תפקיד' },
            4: { cls: 'changed', icon: 'fa-phone',      label: 'שינוי טלפון' },
            5: { cls: 'changed', icon: 'fa-phone-alt',  label: 'שינוי שלוחה' },
            6: { cls: 'changed', icon: 'fa-edit',       label: 'שינוי פרטים' }
        };

        const t = types[changeType] ?? types[6];
        return `
            <span class="change-type-badge ${t.cls}">
                <i class="fas ${t.icon}"></i>
                ${t.label}
            </span>`;
    },

    // ─── תגית סטטוס ──────────────────────────────────────────────
    getStatusBadge(status) {
        const statuses = {
            0: { cls: 'pending',  icon: 'fa-clock',        label: 'ממתין לאישור' },
            1: { cls: 'approved', icon: 'fa-check-circle', label: 'אושר'         },
            2: { cls: 'rejected', icon: 'fa-times-circle', label: 'נדחה'         },
            3: { cls: 'failed',   icon: 'fa-exclamation',  label: 'נכשל'         }
        };

        const s = statuses[status] ?? statuses[0];
        return `
            <span class="status-badge ${s.cls}">
                <i class="fas ${s.icon}"></i>
                ${s.label}
            </span>`;
    },

    // ─── אשר שינוי בודד ──────────────────────────────────────────
    async approveOne(changeId) {
        const change = this.allChanges.find(c => c.changeId === changeId);
        if (!change) return;

        if (!confirm(
            `לאשר את השינוי עבור ${change.employeeName}?\n` +
            `שדה: ${change.fieldName}`
        )) return;

        await this.sendAction(
            '/PhoneDirectoryChanges/ApproveChange',
            this.buildRequest(change),
            'אושר בהצלחה',
            changeId,
            1
        );
    },

    // ─── דחה שינוי בודד ──────────────────────────────────────────
    async rejectOne(changeId) {
        const change = this.allChanges.find(c => c.changeId === changeId);
        if (!change) return;

        if (!confirm(
            `לדחות את השינוי עבור ${change.employeeName}?`
        )) return;

        await this.sendAction(
            '/PhoneDirectoryChanges/RejectChange',
            this.buildRequest(change),
            'נדחה בהצלחה',
            changeId,
            2
        );
    },

    // ─── אשר את כל הנבחרים ───────────────────────────────────────
    async approveSelected() {
        const selected = this.getSelectedChanges();

        if (selected.length === 0) {
            showToast('לא נבחרו שינויים', 'warning');
            return;
        }

        if (!confirm(
            `לאשר ${selected.length} שינויים נבחרים?`
        )) return;

        await this.sendBulkAction(
            '/PhoneDirectoryChanges/ApproveAll',
            selected,
            1
        );
    },

    // ─── דחה את כל הנבחרים ───────────────────────────────────────
    async rejectSelected() {
        const selected = this.getSelectedChanges();

        if (selected.length === 0) {
            showToast('לא נבחרו שינויים', 'warning');
            return;
        }

        if (!confirm(
            `לדחות ${selected.length} שינויים נבחרים?`
        )) return;

        await this.sendBulkAction(
            '/PhoneDirectoryChanges/RejectAll',
            selected,
            2
        );
    },

    // ─── שלח פעולה בודדת ─────────────────────────────────────────
    async sendAction(url, body, successMsg, changeId, newStatus) {
        try {
            const res  = await fetch(url, {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify(body)
            });
            const data = await res.json();

            if (data.success) {
                showToast(successMsg, 'success');
                // ─── עדכן סטטוס מקומי ────────────────────────────
                const change = this.allChanges.find(
                    c => c.changeId === changeId);
                if (change) {
                    change.status      = newStatus;
                    change.processedBy = data.processedBy || '';
                    change.processedAt = new Date().toISOString();
                }
                this.renderChanges();
                this.renderSummaryFromChanges();
            } else {
                showToast(data.message || 'שגיאה', 'error');
            }
        } catch (err) {
            console.error('sendAction error:', err);
            showToast('שגיאת רשת', 'error');
        }
    },

    // ─── שלח פעולה מרובה ─────────────────────────────────────────
    async sendBulkAction(url, changes, newStatus) {
        try {
            const res  = await fetch(url, {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify({
                    changes: changes.map(c => this.buildRequest(c))
                })
            });
            const data = await res.json();

            if (data.success) {
                showToast(data.message, 'success');

                // ─── עדכן סטטוסים מקומית ─────────────────────────
                changes.forEach(c => {
                    const change = this.allChanges.find(
                        x => x.changeId === c.changeId);
                    if (change) {
                        change.status      = newStatus;
                        change.processedAt = new Date().toISOString();
                    }
                });

                this.renderChanges();
                this.renderSummaryFromChanges();

                // ─── בטל בחירה ───────────────────────────────────
                const selectAll = document.getElementById(
                    'selectAllChanges');
                if (selectAll) selectAll.checked = false;

            } else {
                showToast(data.message || 'שגיאה', 'error');
            }
        } catch (err) {
            console.error('sendBulkAction error:', err);
            showToast('שגיאת רשת', 'error');
        }
    },

    // ─── בנה אובייקט בקשה ────────────────────────────────────────
    buildRequest(change) {
        return {
            changeId:     change.changeId,
            changeType:   change.changeType,
            employeeName: change.employeeName,
            email:        change.email        || '', 
            employeeId:   change.employeeId   || '',
            fieldName:    change.fieldName    || '',
            oldValue:     change.oldValue     || '',
            newValue:     change.newValue     || ''
        };
    },

    // ─── קבל שינויים נבחרים ──────────────────────────────────────
    getSelectedChanges() {
        const checked = document.querySelectorAll(
            '.change-checkbox:checked');
        const ids = [...checked].map(
            cb => cb.dataset.changeId);
        return this.allChanges.filter(
            c => ids.includes(c.changeId) && c.status === 0);
    },

    // ─── בחר/בטל הכל ─────────────────────────────────────────────
    toggleSelectAll(checked) {
        document.querySelectorAll(
            '.change-checkbox:not(:disabled)'
        ).forEach(cb => cb.checked = checked);
    },

    // ─── החלף פילטר ──────────────────────────────────────────────
    setFilter(filter) {
        this.activeFilter = filter;

        document.querySelectorAll('.filter-tab').forEach(btn => {
            btn.classList.toggle(
                'active',
                btn.dataset.filter === filter
            );
        });

        this.renderChanges();
    },

    // ─── החלף טאב ראשי ───────────────────────────────────────────
    setMainTab(tab) {
        this.activeMainTab = tab;

        document.querySelectorAll('.main-tab').forEach(btn => {
            btn.classList.toggle(
                'active',
                btn.dataset.tab === tab
            );
        });

        document.getElementById('panelChanges').style.display =
            tab === 'changes' ? 'block' : 'none';
        document.getElementById('panelHistory').style.display =
            tab === 'history' ? 'block' : 'none';

        if (tab === 'history') this.loadHistory();
    },

    // ─── טען היסטוריה ────────────────────────────────────────────
    async loadHistory() {
        const el = document.getElementById('historyContent');
        if (!el) return;

        el.innerHTML = `
            <div class="changes-loading">
                <i class="fas fa-spinner fa-spin"></i>
                <p>טוען היסטוריה...</p>
            </div>`;

        try {
            const res  = await fetch(
                '/PhoneDirectoryChanges/GetHistory?days=30');
            const data = await res.json();

            if (!data.success || data.history.length === 0) {
                el.innerHTML = `
                    <div class="changes-empty">
                        <i class="fas fa-history"></i>
                        <p>אין היסטוריה להצגה</p>
                    </div>`;
                return;
            }

            let html = `
                <div class="changes-table-wrap">
                    <table class="changes-table">
                        <thead>
                            <tr>
                                <th>תאריך</th>
                                <th>שם עובד</th>
                                <th>סוג שינוי</th>
                                <th>שדה</th>
                                <th>ערך קודם</th>
                                <th>ערך חדש</th>
                                <th>סטטוס</th>
                                <th>בוצע על ידי</th>
                            </tr>
                        </thead>
                        <tbody>
            `;

            data.history.forEach(entry => {
                html += `
                    <tr class="history-row">
                        <td style="white-space:nowrap">
                            ${formatDate(entry.processedAt)}
                        </td>
                        <td>
                            <div class="employee-name-cell">
                                ${escHtml(entry.employeeName)}
                            </div>
                        </td>
                        <td>${this.getTypeBadge(entry.changeType)}</td>
                        <td>${escHtml(entry.fieldName)}</td>
                        <td>
                            ${entry.oldValue
                                ? `<span class="value-old">
                                       ${escHtml(entry.oldValue)}
                                   </span>`
                                : '<span class="value-empty">ריק</span>'}
                        </td>
                        <td>
                            ${entry.newValue
                                ? `<span class="value-new">
                                       ${escHtml(entry.newValue)}
                                   </span>`
                                : '<span class="value-empty">ריק</span>'}
                        </td>
                        <td>${this.getStatusBadge(entry.status)}</td>
                        <td style="font-size:.78rem;
                                   color:rgba(255,255,255,.45)">
                            ${escHtml(entry.processedBy || '')}
                        </td>
                    </tr>
                `;
            });

            html += `</tbody></table></div>`;
            el.innerHTML = html;

        } catch (err) {
            el.innerHTML = `
                <div class="changes-empty">
                    <i class="fas fa-exclamation-triangle"
                       style="color:#ef4444"></i>
                    <p>שגיאה בטעינת היסטוריה</p>
                </div>`;
        }
    },

    // ─── עדכן סיכום מהנתונים המקומיים ───────────────────────────
    renderSummaryFromChanges() {
        const summary = {
            newEmployees:     this.allChanges.filter(
                c => c.changeType === 0).length,
            removedEmployees: this.allChanges.filter(
                c => c.changeType === 1).length,
            fieldChanges:     this.allChanges.filter(
                c => c.changeType !== 0 && c.changeType !== 1).length,
            totalChanges:     this.allChanges.length
        };
        this.renderSummary(summary);
    },

    // ─── קשר אירועים ─────────────────────────────────────────────
    bindEvents() {
        // כפתור רענון
        const refreshBtn = document.getElementById('btnRefresh');
        if (refreshBtn) {
            refreshBtn.addEventListener('click', () => {
                this.loadChanges();
            });
        }

        // כפתור אשר נבחרים
        const approveBtn = document.getElementById('btnApproveSelected');
        if (approveBtn) {
            approveBtn.addEventListener('click', () => {
                this.approveSelected();
            });
        }

        // כפתור דחה נבחרים
        const rejectBtn = document.getElementById('btnRejectSelected');
        if (rejectBtn) {
            rejectBtn.addEventListener('click', () => {
                this.rejectSelected();
            });
        }
        const searchInput = document.getElementById('searchInput');
        if (searchInput) {
            searchInput.addEventListener('input', (e) => {
                this.onSearchInput(e.target.value);
            });
        }
    }
};

// ══ פונקציות עזר ══════════════════════════════════════════════════
function escHtml(str) {
    return String(str ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

function formatDate(dateStr) {
    if (!dateStr) return '';
    try {
        return new Date(dateStr).toLocaleString('he-IL', {
            timeZone: 'Asia/Jerusalem',
            day:    '2-digit',
            month:  '2-digit',
            year:   '2-digit',
            hour:   '2-digit',
            minute: '2-digit'
        });
    } catch { return dateStr; }
}

function showToast(msg, type = 'success') {
    const colors = {
        success: '#238636',
        error:   '#da3633',
        warning: '#d29922',
        info:    '#388bfd'
    };

    const toast = document.createElement('div');
    toast.style.cssText = `
        position:fixed; bottom:1.5rem; left:50%;
        transform:translateX(-50%);
        background:${colors[type] ?? colors.info};
        color:#fff; padding:.7rem 1.4rem;
        border-radius:8px; font-size:.9rem;
        z-index:99999;
        box-shadow:0 4px 12px rgba(0,0,0,.4);
        display:flex; align-items:center; gap:.5rem;
        max-width:90vw; text-align:center;
    `;

    const icons = {
        success: 'check-circle',
        error:   'exclamation-circle',
        warning: 'exclamation-triangle',
        info:    'info-circle'
    };

    toast.innerHTML = `
        <i class="fas fa-${icons[type] ?? 'info-circle'}"></i>
        ${escHtml(msg)}`;

    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 3500);
}

// ── אתחול ─────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
    ChangesManager.init();
});
</script>
}

