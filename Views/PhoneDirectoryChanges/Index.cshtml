@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "ניהול שינויים - ספר טלפונים";
}

@section Styles {
    <link rel="icon" type="image/x-icon"
          href="https://www.menoramivt.co.il/customers-homepage/static/img/favicon.ico">
    <link rel="stylesheet" href="https://cdn.menoramivt.co.il/public/fonts/fonts.css">
    <link rel="stylesheet" href="/lib/font-awesome/css/all.min.css">
    <link rel="stylesheet" href="~/css/admin-panel.css">
    <style>
        /* ══ משתני צבע ══════════════════════════════════════════════ */
        :root {
            --clr-new:      #22c55e;
            --clr-new-bg:   rgba(34,197,94,.12);
            --clr-removed:  #ef4444;
            --clr-removed-bg: rgba(239,68,68,.12);
            --clr-changed:  #f59e0b;
            --clr-changed-bg: rgba(245,158,11,.12);
            --clr-pending:  #6366f1;
            --clr-approved: #22c55e;
            --clr-rejected: #ef4444;
        }

        /* ══ כרטיסי סיכום ════════════════════════════════════════════ */
        .changes-summary-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .summary-card {
            background: rgba(255,255,255,.05);
            border: 1px solid rgba(255,255,255,.1);
            border-radius: 12px;
            padding: 1.2rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            transition: transform .2s;
        }

        .summary-card:hover {
            transform: translateY(-2px);
        }

        .summary-card-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            flex-shrink: 0;
        }

        .summary-card-icon.new      { background: var(--clr-new-bg);     color: var(--clr-new); }
        .summary-card-icon.removed  { background: var(--clr-removed-bg); color: var(--clr-removed); }
        .summary-card-icon.changed  { background: var(--clr-changed-bg); color: var(--clr-changed); }
        .summary-card-icon.total    { background: rgba(99,102,241,.15);   color: #6366f1; }

        .summary-card-info {
            display: flex;
            flex-direction: column;
            gap: .2rem;
        }

        .summary-card-value {
            font-size: 1.8rem;
            font-weight: 700;
            line-height: 1;
        }

        .summary-card-label {
            font-size: .78rem;
            color: rgba(255,255,255,.45);
        }

        /* ══ סרגל כלים ═══════════════════════════════════════════════ */
        .changes-toolbar {
            display: flex;
            align-items: center;
            gap: .8rem;
            margin-bottom: 1rem;
            flex-wrap: wrap;
        }

        .changes-toolbar-right {
            display: flex;
            align-items: center;
            gap: .6rem;
            flex: 1;
        }

        .changes-toolbar-left {
            display: flex;
            align-items: center;
            gap: .6rem;
        }

        /* ══ פילטר טאבים ════════════════════════════════════════════ */
        .changes-filter-tabs {
            display: flex;
            gap: .4rem;
            margin-bottom: 1rem;
            flex-wrap: wrap;
        }

        .filter-tab {
            padding: .4rem 1rem;
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,.15);
            background: transparent;
            color: rgba(255,255,255,.6);
            font-size: .82rem;
            cursor: pointer;
            transition: all .2s;
            display: flex;
            align-items: center;
            gap: .4rem;
        }

        .filter-tab:hover {
            background: rgba(255,255,255,.08);
            color: #fff;
        }

        .filter-tab.active {
            background: rgba(99,102,241,.2);
            border-color: #6366f1;
            color: #a5b4fc;
        }

        .filter-tab .tab-count {
            background: rgba(255,255,255,.15);
            border-radius: 10px;
            padding: .1rem .45rem;
            font-size: .72rem;
            font-weight: 600;
        }

        .filter-tab.active .tab-count {
            background: rgba(99,102,241,.3);
        }

        /* ══ טבלת שינויים ════════════════════════════════════════════ */
        .changes-table-wrap {
            overflow-x: auto;
            border-radius: 10px;
            border: 1px solid rgba(255,255,255,.08);
        }

        .changes-table {
            width: 100%;
            border-collapse: collapse;
            font-size: .85rem;
        }

        .changes-table th {
            background: rgba(255,255,255,.06);
            padding: .75rem 1rem;
            text-align: right;
            font-weight: 600;
            font-size: .78rem;
            color: rgba(255,255,255,.5);
            white-space: nowrap;
            border-bottom: 1px solid rgba(255,255,255,.08);
        }

        .changes-table td {
            padding: .7rem 1rem;
            border-bottom: 1px solid rgba(255,255,255,.05);
            vertical-align: middle;
        }

        .changes-table tr:last-child td {
            border-bottom: none;
        }

        .changes-table tr:hover td {
            background: rgba(255,255,255,.03);
        }

        /* ══ תגיות סוג שינוי ════════════════════════════════════════ */
        .change-type-badge {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            padding: .25rem .7rem;
            border-radius: 20px;
            font-size: .75rem;
            font-weight: 600;
            white-space: nowrap;
        }

        .change-type-badge.new {
            background: var(--clr-new-bg);
            color: var(--clr-new);
            border: 1px solid rgba(34,197,94,.25);
        }

        .change-type-badge.removed {
            background: var(--clr-removed-bg);
            color: var(--clr-removed);
            border: 1px solid rgba(239,68,68,.25);
        }

        .change-type-badge.changed {
            background: var(--clr-changed-bg);
            color: var(--clr-changed);
            border: 1px solid rgba(245,158,11,.25);
        }

        /* ══ תגיות סטטוס ════════════════════════════════════════════ */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: .3rem;
            padding: .2rem .65rem;
            border-radius: 20px;
            font-size: .73rem;
            font-weight: 600;
        }

        .status-badge.pending {
            background: rgba(99,102,241,.15);
            color: #a5b4fc;
            border: 1px solid rgba(99,102,241,.3);
        }

        .status-badge.approved {
            background: rgba(34,197,94,.12);
            color: #4ade80;
            border: 1px solid rgba(34,197,94,.25);
        }

        .status-badge.rejected {
            background: rgba(239,68,68,.12);
            color: #f87171;
            border: 1px solid rgba(239,68,68,.25);
        }

        .status-badge.failed {
            background: rgba(239,68,68,.12);
            color: #f87171;
            border: 1px solid rgba(239,68,68,.25);
        }

        /* ══ ערכים ישן/חדש ══════════════════════════════════════════ */
        .value-old {
            color: rgba(255,255,255,.35);
            text-decoration: line-through;
            font-size: .8rem;
        }

        .value-new {
            color: rgba(255,255,255,.9);
            font-size: .85rem;
        }

        .value-arrow {
            color: rgba(255,255,255,.25);
            margin: 0 .3rem;
            font-size: .7rem;
        }

        .value-empty {
            color: rgba(255,255,255,.2);
            font-style: italic;
            font-size: .78rem;
        }

        /* ══ כפתורי פעולה בשורה ════════════════════════════════════ */
        .row-actions {
            display: flex;
            gap: .4rem;
            align-items: center;
        }

        .btn-approve-row {
            padding: .3rem .7rem;
            border-radius: 6px;
            border: 1px solid rgba(34,197,94,.3);
            background: rgba(34,197,94,.1);
            color: #4ade80;
            font-size: .75rem;
            cursor: pointer;
            transition: all .2s;
            display: flex;
            align-items: center;
            gap: .3rem;
        }

        .btn-approve-row:hover {
            background: rgba(34,197,94,.2);
            border-color: rgba(34,197,94,.5);
        }

        .btn-reject-row {
            padding: .3rem .7rem;
            border-radius: 6px;
            border: 1px solid rgba(239,68,68,.3);
            background: rgba(239,68,68,.1);
            color: #f87171;
            font-size: .75rem;
            cursor: pointer;
            transition: all .2s;
            display: flex;
            align-items: center;
            gap: .3rem;
        }

        .btn-reject-row:hover {
            background: rgba(239,68,68,.2);
            border-color: rgba(239,68,68,.5);
        }

        .btn-approve-row:disabled,
        .btn-reject-row:disabled {
            opacity: .35;
            cursor: not-allowed;
        }

        /* ══ מידע על הקובץ ══════════════════════════════════════════ */
        .file-info-bar {
            display: flex;
            align-items: center;
            gap: .8rem;
            padding: .7rem 1rem;
            background: rgba(99,102,241,.08);
            border: 1px solid rgba(99,102,241,.2);
            border-radius: 8px;
            margin-bottom: 1.2rem;
            font-size: .82rem;
            color: rgba(255,255,255,.6);
            flex-wrap: wrap;
        }

        .file-info-bar i {
            color: #6366f1;
        }

        .file-info-bar strong {
            color: rgba(255,255,255,.85);
        }

        /* ══ Loading ════════════════════════════════════════════════ */
        .changes-loading {
            text-align: center;
            padding: 3rem;
            color: rgba(255,255,255,.4);
        }

        .changes-loading i {
            font-size: 2rem;
            margin-bottom: .8rem;
            display: block;
        }

        /* ══ Empty state ════════════════════════════════════════════ */
        .changes-empty {
            text-align: center;
            padding: 3rem;
            color: rgba(255,255,255,.3);
        }

        .changes-empty i {
            font-size: 2.5rem;
            margin-bottom: .8rem;
            display: block;
        }

        /* ══ היסטוריה ═══════════════════════════════════════════════ */
        .history-row td {
            font-size: .8rem;
            color: rgba(255,255,255,.55);
        }

        /* ══ Checkbox ═══════════════════════════════════════════════ */
        .changes-table input[type="checkbox"] {
            accent-color: #6366f1;
            width: 14px;
            height: 14px;
            cursor: pointer;
        }

        /* ══ כפתורי Bulk ════════════════════════════════════════════ */
        .btn-bulk-approve {
            background: rgba(34,197,94,.15);
            border: 1px solid rgba(34,197,94,.3);
            color: #4ade80;
            padding: .5rem 1.1rem;
            border-radius: 8px;
            font-size: .83rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: .4rem;
            transition: all .2s;
        }

        .btn-bulk-approve:hover {
            background: rgba(34,197,94,.25);
        }

        .btn-bulk-reject {
            background: rgba(239,68,68,.12);
            border: 1px solid rgba(239,68,68,.25);
            color: #f87171;
            padding: .5rem 1.1rem;
            border-radius: 8px;
            font-size: .83rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: .4rem;
            transition: all .2s;
        }

        .btn-bulk-reject:hover {
            background: rgba(239,68,68,.22);
        }

        .btn-refresh {
            background: rgba(99,102,241,.12);
            border: 1px solid rgba(99,102,241,.25);
            color: #a5b4fc;
            padding: .5rem 1.1rem;
            border-radius: 8px;
            font-size: .83rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: .4rem;
            transition: all .2s;
        }

        .btn-refresh:hover {
            background: rgba(99,102,241,.22);
        }

        /* ══ טאבים ראשיים ═══════════════════════════════════════════ */
        .main-tabs {
            display: flex;
            gap: 0;
            border-bottom: 1px solid rgba(255,255,255,.1);
            margin-bottom: 1.5rem;
        }

        .main-tab {
            padding: .7rem 1.4rem;
            border: none;
            background: transparent;
            color: rgba(255,255,255,.45);
            font-size: .88rem;
            cursor: pointer;
            border-bottom: 2px solid transparent;
            margin-bottom: -1px;
            transition: all .2s;
            display: flex;
            align-items: center;
            gap: .5rem;
        }

        .main-tab:hover {
            color: rgba(255,255,255,.75);
        }

        .main-tab.active {
            color: #a5b4fc;
            border-bottom-color: #6366f1;
        }

        /* ══ שם עובד ════════════════════════════════════════════════ */
        .employee-name-cell {
            font-weight: 600;
            color: rgba(255,255,255,.9);
        }

        .employee-id-cell {
            font-size: .72rem;
            color: rgba(255,255,255,.3);
            margin-top: .15rem;
        }

        /* ══ processed info ═════════════════════════════════════════ */
        .processed-info {
            font-size: .72rem;
            color: rgba(255,255,255,.3);
            margin-top: .2rem;
        }
        /* ══ תיבת חיפוש ══════════════════════════════════════════════ */
        .search-box-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }

        .search-box-wrap .search-icon {
            position: absolute;
            right: .75rem;
            color: rgba(255,255,255,.3);
            font-size: .82rem;
            pointer-events: none;
            transition: color .2s;
        }

        .search-input {
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 8px;
            color: rgba(255,255,255,.85);
            font-size: .83rem;
            padding: .48rem 2.1rem .48rem .9rem;
            width: 240px;
            transition: border-color .2s, background .2s, width .25s;
            outline: none;
            direction: rtl;
        }

        .search-input::placeholder {
            color: rgba(255,255,255,.25);
        }

        .search-input:focus {
            border-color: rgba(99,102,241,.55);
            background: rgba(99,102,241,.08);
            width: 300px;
        }

        .search-box-wrap:focus-within .search-icon {
            color: #a5b4fc;
        }

        .search-clear {
            position: absolute;
            left: .6rem;
            background: none;
            border: none;
            color: rgba(255,255,255,.25);
            cursor: pointer;
            font-size: .75rem;
            padding: 0;
            display: none;
            line-height: 1;
            transition: color .2s;
        }

        .search-clear:hover   { color: rgba(255,255,255,.6); }
        .search-clear.visible { display: block; }

        .search-highlight {
            background: rgba(245,158,11,.35);
            color: #fde68a;
            border-radius: 2px;
            padding: 0 1px;
        }

        .search-results-count {
            font-size: .78rem;
            color: rgba(255,255,255,.35);
            white-space: nowrap;
        }

        .search-results-count strong {
            color: rgba(255,255,255,.65);
        }

        /* ══ פילטר תפקידים ═══════════════════════════════════════════ */
        .role-filter-bar {
            display: none;
            align-items: center;
            gap: .7rem;
            margin-bottom: 1rem;
            padding: .6rem 1rem;
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 8px;
            flex-wrap: wrap;
        }

        .role-filter-bar.visible { display: flex; }

        .role-filter-label {
            display: flex;
            align-items: center;
            gap: .4rem;
            font-size: .82rem;
            color: rgba(255,255,255,.4);
            white-space: nowrap;
        }

        .role-filter-label i { color: rgba(99,102,241,.7); }

        .role-select {
            background: rgba(255,255,255,.07);
            border: 1px solid rgba(255,255,255,.15);
            color: rgba(255,255,255,.8);
            border-radius: 6px;
            padding: .32rem .75rem;
            font-size: .82rem;
            cursor: pointer;
            min-width: 200px;
            max-width: 320px;
            outline: none;
            transition: border-color .2s, background .2s;
            direction: rtl;
        }

        .role-select:focus {
            border-color: rgba(99,102,241,.5);
            background: rgba(99,102,241,.1);
        }

        .role-select option {
            background: #1e1e2e;
            color: rgba(255,255,255,.85);
        }

        .role-active-badge {
            display: none;
            align-items: center;
            gap: .35rem;
            padding: .2rem .65rem;
            background: rgba(99,102,241,.18);
            border: 1px solid rgba(99,102,241,.35);
            border-radius: 20px;
            font-size: .75rem;
            color: #a5b4fc;
        }

        .role-active-badge.visible { display: inline-flex; }

        .role-active-badge .badge-clear {
            background: none;
            border: none;
            color: rgba(165,180,252,.6);
            cursor: pointer;
            padding: 0;
            font-size: .7rem;
            transition: color .2s;
        }

        .role-active-badge .badge-clear:hover { color: #f87171; }

        /* שורה מוסתרת בחיפוש */
        .changes-table tr.search-hidden { display: none; }
    </style>
}

@section Scripts {
<script>
// ══════════════════════════════════════════════════════════════════
// PhoneDirectoryChangesManager
// ══════════════════════════════════════════════════════════════════
const ChangesManager = {

    // ─── מצב ─────────────────────────────────────────────────────
    allChanges:    [],
    activeFilter:  'all',
    activeMainTab: 'changes',
    activeRoleFilter: 'all',
    availableRoles:   [],
    searchQuery:      '',      // ← חדש
    _searchTimer:     null,    // ← חדש

    // ─── אתחול ───────────────────────────────────────────────────
    async init() {
        await this.loadChanges();
        this.bindEvents();
    },

    // ─── טען שינויים ─────────────────────────────────────────────
    async loadChanges() {
        this.showLoading();
        try {
            // ← הוסף role לפרמטרים
            const roleParam = this.activeRoleFilter !== 'all'
                ? `?role=${encodeURIComponent(this.activeRoleFilter)}`
                : '';

            const res  = await fetch(
                `/PhoneDirectoryChanges/CompareDirectories${roleParam}`
            );
            const data = await res.json();

            if (!data.success) {
                this.showError(data.message);
                return;
            }

            this.allChanges    = data.changes || [];
            this.availableRoles = data.roles  || [];

            this.renderSummary(data.summary);
            this.renderFileInfo(data.sourceFile, data.fileDate);
            this.renderRoleFilter();   // ← חדש
            this.renderChanges();

        } catch (err) {
            console.error('loadChanges error:', err);
            this.showError('שגיאה בטעינת הנתונים');
        }
    },

    // ─── עצב פילטר תפקידים ───────────────────────────────────────
    renderRoleFilter() {
        const el = document.getElementById('roleFilterContainer');
        if (!el) return;

        if (this.availableRoles.length === 0) {
            el.classList.remove('visible');
            return;
        }

        el.classList.add('visible');

        let optionsHtml = `<option value="all">כל התפקידים</option>`;
        this.availableRoles.forEach(role => {
            const sel = this.activeRoleFilter === role ? 'selected' : '';
            optionsHtml += `
                <option value="${escHtml(role)}" ${sel}>
                    ${escHtml(role)}
                </option>`;
        });

        const isFiltered = this.activeRoleFilter !== 'all';

        el.innerHTML = `
            <span class="role-filter-label">
                <i class="fas fa-briefcase"></i>
                סנן לפי תפקיד:
            </span>

            <select class="role-select"
                    id="roleSelect"
                    onchange="ChangesManager.setRoleFilter(this.value)">
                ${optionsHtml}
            </select>

            <span class="role-active-badge ${isFiltered ? 'visible' : ''}"
                id="roleActiveBadge">
                <i class="fas fa-filter"></i>
                ${isFiltered ? escHtml(this.activeRoleFilter) : ''}
                <button class="badge-clear"
                        onclick="ChangesManager.setRoleFilter('all')"
                        title="נקה סינון">
                    <i class="fas fa-times"></i>
                </button>
            </span>
        `;
    },

    // ─── הפעל חיפוש (עם debounce) ────────────────────────────────
    onSearchInput(val) {
        this.searchQuery = val.trim();

        // ─── הצג/הסתר כפתור ניקוי ────────────────────────────────
        const clearBtn = document.getElementById('searchClearBtn');
        if (clearBtn) {
            clearBtn.classList.toggle(
                'visible',
                this.searchQuery.length > 0
            );
        }

        // ─── debounce 200ms ───────────────────────────────────────
        clearTimeout(this._searchTimer);
        this._searchTimer = setTimeout(() => {
            this.applySearch();
        }, 200);
    },

    // ─── נקה חיפוש ───────────────────────────────────────────────
    clearSearch() {
        this.searchQuery = '';
        const input = document.getElementById('searchInput');
        if (input) input.value = '';

        const clearBtn = document.getElementById('searchClearBtn');
        if (clearBtn) clearBtn.classList.remove('visible');

        this.applySearch();
    },

    // ─── החל חיפוש על הטבלה ──────────────────────────────────────
    applySearch() {
        const query = this.searchQuery.toLowerCase();
        const rows  = document.querySelectorAll(
            '#changesTable tbody tr[data-change-id]'
        );

        let visibleCount = 0;

        rows.forEach(row => {
            if (!query) {
                row.classList.remove('search-hidden');
                // ─── הסר הדגשות ──────────────────────────────────
                this.removeHighlights(row);
                visibleCount++;
                return;
            }

            // ─── חפש בכל הטקסט של השורה ──────────────────────────
            const text = row.textContent.toLowerCase();
            const match = text.includes(query);

            row.classList.toggle('search-hidden', !match);

            if (match) {
                visibleCount++;
                this.highlightRow(row, query);
            } else {
                this.removeHighlights(row);
            }
        });

        // ─── עדכן מונה תוצאות ────────────────────────────────────
        this.updateSearchCount(visibleCount, rows.length, query);
    },

    // ─── הדגש טקסט בשורה ─────────────────────────────────────────
    highlightRow(row, query) {
        // ─── הדגש רק בתאים רלוונטיים ─────────────────────────────
        const cells = row.querySelectorAll(
            'td:nth-child(2), td:nth-child(3), ' +
            'td:nth-child(5), td:nth-child(6), td:nth-child(7)'
        );

        cells.forEach(cell => {
            this.removeHighlights(cell);
            this.highlightText(cell, query);
        });
    },

    // ─── הדגש טקסט ברקורסיה ──────────────────────────────────────
    highlightText(node, query) {
        if (node.nodeType === Node.TEXT_NODE) {
            const text  = node.textContent;
            const lower = text.toLowerCase();
            const idx   = lower.indexOf(query);

            if (idx === -1) return;

            const before  = text.substring(0, idx);
            const match   = text.substring(idx, idx + query.length);
            const after   = text.substring(idx + query.length);

            const span = document.createElement('span');
            span.className   = 'search-highlight';
            span.textContent = match;

            const frag = document.createDocumentFragment();
            if (before) frag.appendChild(
                document.createTextNode(before));
            frag.appendChild(span);
            if (after)  frag.appendChild(
                document.createTextNode(after));

            node.parentNode.replaceChild(frag, node);
            return;
        }

        if (node.nodeType === Node.ELEMENT_NODE &&
            !node.classList.contains('search-highlight'))
        {
            [...node.childNodes].forEach(child => {
                this.highlightText(child, query);
            });
        }
    },

    // ─── הסר הדגשות ──────────────────────────────────────────────
    removeHighlights(el) {
        el.querySelectorAll('.search-highlight').forEach(span => {
            span.replaceWith(
                document.createTextNode(span.textContent)
            );
        });
    },

    // ─── עדכן מונה תוצאות ────────────────────────────────────────
    updateSearchCount(visible, total, query) {
        const el = document.getElementById('searchResultsCount');
        if (!el) return;

        if (!query) {
            el.textContent = '';
            return;
        }

        el.innerHTML = visible === 0
            ? `<span style="color:#f87171">לא נמצאו תוצאות</span>`
            : `נמצאו <strong>${visible}</strong> מתוך ${total}`;
    },

    // ─── החלף פילטר תפקיד ────────────────────────────────────────
    setRoleFilter(role) {
        this.activeRoleFilter = role;
        this.loadChanges();   // ← טען מחדש עם הפילטר
    },

