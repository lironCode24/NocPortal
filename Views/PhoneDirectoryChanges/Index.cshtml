    // ─── עצב מידע קובץ ───────────────────────────────────────────
    renderFileInfo(sourceFile, fileDate) {
        const el = document.getElementById('fileInfoBar');
        if (!el) return;

        el.innerHTML = `
            <i class="fas fa-file-csv"></i>
            <span>קובץ מקור:</span>
            <strong>${escHtml(sourceFile || '')}</strong>
