@{
    Layout = null;
    var systemId = ViewBag.SystemId as string ?? "";
}
<!DOCTYPE html>
<html dir="rtl" lang="he">
<head>
    <meta charset="UTF-8"/>
    <link rel="icon" type="image/x-icon"
          href="https://www.menoramivt.co.il/customers-homepage/static/img/favicon.ico">
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>תיקוף נתוני מערכת</title>
    <link rel="stylesheet" href="https://cdn.menoramivt.co.il/public/fonts/fonts.css">
    <link rel="stylesheet" href="/lib/font-awesome/css/all.min.css">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #0f0f1a;
            color: #e0e0e0;
            font-family: 'Segoe UI', Arial, sans-serif;
            direction: rtl;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 30px 16px 60px;
        }

        /* ── Header ── */
        .vld-header {
            width: 100%;
            max-width: 780px;
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 28px;
            padding-bottom: 18px;
            border-bottom: 1px solid #2a2a4e;
        }
        .vld-header-icon {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg,#4f46e5,#7c3aed);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            color: white;
            flex-shrink: 0;
        }
        .vld-header-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: #e0e0e0;
        }
        .vld-header-sub {
            font-size: 0.8rem;
            color: #666;
            margin-top: 3px;
        }
        .vld-system-badge {
            margin-right: auto;
            padding: 4px 14px;
            background: rgba(99,102,241,0.15);
            border: 1px solid rgba(99,102,241,0.4);
            border-radius: 20px;
            font-size: 0.82rem;
            color: #a5b4fc;
            font-weight: 600;
        }

        /* ── Card ── */
        .vld-card {
            width: 100%;
            max-width: 780px;
            background: #1e1e2e;
            border: 1px solid #3a3a5a;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 8px 32px rgba(0,0,0,0.5);
        }
        .vld-card-header {
            padding: 16px 22px;
            background: rgba(99,102,241,0.08);
            border-bottom: 1px solid #2a2a4e;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .vld-card-header i { color: #6366f1; }
        .vld-card-header-title {
            font-size: 0.95rem;
            font-weight: 700;
            color: #c4b5fd;
        }
        .vld-system-name-badge {
            margin-right: auto;
            padding: 3px 12px;
            background: rgba(245,158,11,0.15);
            border: 1px solid rgba(245,158,11,0.35);
            border-radius: 8px;
            color: #fcd34d;
            font-size: 0.85rem;
            font-weight: 700;
        }

        /* ── Form ── */
        .vld-form {
            padding: 22px;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }
        .vld-row {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
            align-items: flex-end;
        }
        .vld-field {
            display: flex;
            flex-direction: column;
            gap: 5px;
            flex: 1;
            min-width: 140px;
        }
        .vld-field-wide  { flex: 2; min-width: 200px; }
        .vld-field-full  { width: 100%; flex: none; }
        .vld-label {
            font-size: 0.75rem;
            font-weight: 600;
            color: #888;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .vld-label i { color: #6366f1; font-size: 0.68rem; }
        .vld-input {
            background: #252535;
            border: 1px solid #3a3a5a;
            border-radius: 7px;
            color: #e0e0e0;
            padding: 9px 12px;
            font-size: 0.85rem;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
            direction: rtl;
            width: 100%;
            font-family: inherit;
        }
        .vld-input:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99,102,241,0.15);
        }
        .vld-input::placeholder { color: #444; }
        .vld-input[dir="ltr"] { direction: ltr; text-align: left; }
        .vld-textarea {
            background: #252535;
            border: 1px solid #3a3a5a;
            border-radius: 7px;
            color: #e0e0e0;
            padding: 9px 12px;
            font-size: 0.85rem;
            outline: none;
            resize: vertical;
            min-height: 70px;
            font-family: inherit;
            direction: rtl;
            transition: border-color 0.2s, box-shadow 0.2s;
            width: 100%;
        }
        .vld-textarea:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99,102,241,0.15);
        }
        .vld-select {
            background: #252535;
            border: 1px solid #3a3a5a;
            border-radius: 7px;
            color: #e0e0e0;
            padding: 9px 12px;
            font-size: 0.85rem;
            outline: none;
            cursor: pointer;
            direction: rtl;
            width: 100%;
            transition: border-color 0.2s;
        }
        .vld-select:focus { border-color: #6366f1; }
        .vld-select option { background: #252535; }

        /* ── Divider ── */
        .vld-section-title {
            font-size: 0.78rem;
            font-weight: 700;
            color: #6366f1;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            display: flex;
            align-items: center;
            gap: 8px;
            padding-bottom: 6px;
            border-bottom: 1px solid #2a2a4e;
        }
        .vld-section-title::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #2a2a4e;
        }

        /* ── Footer ── */
        .vld-footer {
            padding: 16px 22px;
            border-top: 1px solid #2a2a4e;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            background: rgba(0,0,0,0.2);
        }
        .vld-footer-info {
            font-size: 0.78rem;
            color: #555;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .vld-btn {
            padding: 8px 20px;
            background: linear-gradient(135deg,rgba(245,158,11,0.8),rgba(217,119,6,0.9));
            border: 1px solid rgba(245,158,11,0.6);
            border-radius: 6px;
            color: #1a1000;
            font-size: 0.85rem;
            font-weight: 700;
            cursor: pointer;
            display: flex;
        }
        .vld-reset-btn {
            padding: 8px 16px;
            background: transparent;
            border: 1px solid #444;
            border-radius: 6px;
            color: #999;
            font-size: 0.85rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
            position: relative;
            right: 14%;
        }
        .vld-save-btn {
            padding: 8px 20px;
            background: linear-gradient(135deg,rgba(245,158,11,0.8),rgba(217,119,6,0.9));
            border: 1px solid rgba(245,158,11,0.6);
            border-radius: 6px;
            color: #1a1000;
            font-size: 0.85rem;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
        }
        .vld-save-btn:hover:not(:disabled) {
            box-shadow: 0 4px 14px rgba(245,158,11,0.35);
            transform: translateY(-1px);
        }

        .vld-reset-btn:hover {
            background:#2a2a3a; color:#ccc;
        }

        /* ── States ── */
        .vld-loading {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 16px;
            padding: 60px 20px;
            color: #666;
        }
        .vld-loading i { font-size: 2rem; color: #6366f1; }
        .vld-error-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 14px;
            padding: 60px 20px;
            color: #f87171;
            text-align: center;
        }
        .vld-error-state i { font-size: 2.5rem; }

        /* ── Toast ── */
        .vld-toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            padding: 12px 28px;
            border-radius: 10px;
            font-size: 0.9rem;
            font-weight: 600;
            opacity: 0;
            pointer-events: none;
            transition: all 0.3s ease;
            z-index: 9999;
            direction: rtl;
            white-space: nowrap;
        }
        .vld-toast-show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }
        .vld-toast-success {
            background: #166534;
            border: 1px solid #22c55e;
            color: #4ade80;
        }
        .vld-toast-error {
            background: #7f1d1d;
            border: 1px solid #ef4444;
            color: #fca5a5;
        }
        .vld-toast-info {
            background: #1e3a5f;
            border: 1px solid #3b82f6;
            color: #93c5fd;
        }

        /* ── Success overlay ── */
        .vld-success-overlay {
            display: none;
            flex-direction: column;
            align-items: center;
            gap: 16px;
            padding: 50px 20px;
            text-align: center;
        }
        .vld-success-overlay i {
            font-size: 3rem;
            color: #22c55e;
        }
        .vld-success-overlay h2 {
            font-size: 1.3rem;
            color: #86efac;
        }
        .vld-success-overlay p {
            font-size: 0.85rem;
            color: #666;
        }
        
        /* ══ Field Label Tooltips ══ */
        .vld-label {
            cursor: help;
            position: relative;
            width: fit-content;
        }

        .vld-label:hover::after {
            content: attr(data-tooltip);
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            background: #1a1a2e;
            border: 1px solid #6366f1;
            border-radius: 8px;
            padding: 8px 14px;
            font-size: 0.78rem;
            font-weight: 400;
            color: #e0e0e0;
            white-space: normal;
            max-width: 280px;
            z-index: 9999;
            box-shadow: 0 4px 20px rgba(0,0,0,0.6);
            pointer-events: none;
            direction: rtl;
            text-align: right;
            line-height: 1.6;
            min-width: 160px;
        }

        .vld-label:hover::before {
            content: '';
            position: absolute;
            top: calc(100% + 3px);
            right: 10px;
            border: 5px solid transparent;
            border-bottom-color: #6366f1;
            z-index: 9999;
            pointer-events: none;
        }

        /* ══ Automation Section ══ */
        .vld-automation-note-disabled {
            opacity: 0.4;
            pointer-events: none;
        }

        .vld-select option { background: #252535; }

        /* Badge אוטומציה */
        .vld-auto-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px;
            border-radius: 10px;
            font-size: 0.75rem;
            font-weight: 700;
            border: 1px solid;
        }
        .vld-auto-badge-yes {
            background: rgba(34,197,94,0.12);
            border-color: rgba(34,197,94,0.3);
            color: #4ade80;
        }
        .vld-auto-badge-no {
            background: rgba(107,114,128,0.1);
            border-color: rgba(107,114,128,0.2);
            color: #9ca3af;
        }
        .vld-auto-badge-na {
            background: rgba(245,158,11,0.1);
            border-color: rgba(245,158,11,0.25);
            color: #fcd34d;
        }
                /* ══ Auto-fill Button ══ */
        .vld-autofill-btn {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px;
            background: rgba(99,102,241,0.12);
            border: 1px solid rgba(99,102,241,0.35);
            border-radius: 6px;
            color: #a5b4fc;
            font-size: 0.72rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            margin-right: 8px;
            vertical-align: middle;
            font-family: inherit;
        }

        .vld-autofill-btn:hover:not(:disabled) {
            background: rgba(99,102,241,0.25);
            border-color: rgba(99,102,241,0.6);
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(99,102,241,0.25);
        }

        .vld-autofill-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

        .vld-autofill-btn i {
            font-size: 0.68rem;
        }

        /* ─── שדה שמולא אוטומטית ─── */
        .vld-autofilled {
            border-color: #6366f1 !important;
            box-shadow: 0 0 0 3px rgba(99,102,241,0.2) !important;
            background: rgba(99,102,241,0.06) !important;
            transition: all 0.3s ease !important;
        }

        /* Light mode */
        [data-theme="light"] .vld-autofill-btn {
            background: rgba(99,102,241,0.08);
            border-color: rgba(99,102,241,0.25);
            color: #4338ca;
        }

        [data-theme="light"] .vld-autofill-btn:hover:not(:disabled) {
            background: rgba(99,102,241,0.15);
            border-color: rgba(99,102,241,0.45);
        }

        [data-theme="light"] .vld-autofilled {
            border-color: #6366f1 !important;
            box-shadow: 0 0 0 3px rgba(99,102,241,0.15) !important;
            background: rgba(99,102,241,0.04) !important;
        }
        @@media (max-width: 600px) {
            .vld-row { flex-direction: column; }
            .vld-field, .vld-field-wide { min-width: 100%; }
            .vld-system-badge { display: none; }
        }
        
        /* ══ Required Fields ══ */
        .vld-field[data-required="true"] .vld-label {
            color: #e0e0e0;
        }
        
        .vld-required-star {
            color: #ef4444;
            margin-right: 3px;
            font-weight: 700;
        }
        
        /* הדגש שדה חובה ריק */
        .vld-field[data-required="true"] .vld-input:invalid,
        .vld-field[data-required="true"] .vld-input[data-empty="true"] {
            border-color: rgba(239,68,68,0.4);
        }
        
        /* אינדיקטור חובה בפינה */
        .vld-field[data-required="true"] {
            position: relative;
        }

        /* ══ Multi-Select Field (Validation Page) ══ */
        .vld-multiselect-wrap {
            position: relative;
            width: 100%;
        }

        .vld-multiselect-display {
            display: flex;
            align-items: center;
            gap: 6px;
            min-height: 42px;
            padding: 6px 12px;
            background: #252535;
            border: 1px solid #3a3a5a;
            border-radius: 7px;
            cursor: pointer;
            transition: border-color 0.2s, box-shadow 0.2s;
            flex-wrap: wrap;
            position: relative;
        }

        .vld-multiselect-display:hover {
            border-color: #6366f1;
            box-shadow: 0 0 0 2px rgba(99,102,241,0.1);
        }

        /* ── תווית "בחירה מרובה" ── */
        .vld-multiselect-hint {
            position: absolute;
            top: -9px;
            left: 10px;
            background: #1e1e2e;
            padding: 0 6px;
            font-size: 0.62rem;
            font-weight: 700;
            color: #6366f1;
            border: 1px solid rgba(99,102,241,0.3);
            border-radius: 4px;
            letter-spacing: 0.03em;
            pointer-events: none;
            white-space: nowrap;
        }

        .vld-multiselect-display-text {
            flex: 1;
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            min-width: 0;
        }

        .vld-multiselect-tag {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 8px;
            background: rgba(99,102,241,0.18);
            border: 1px solid rgba(99,102,241,0.4);
            border-radius: 8px;
            color: #a5b4fc;
            font-size: 0.75rem;
            font-weight: 600;
            white-space: nowrap;
        }

        .vld-multiselect-tag i {
            font-size: 0.55rem;
            opacity: 0.7;
        }

        .vld-multiselect-chevron {
            color: #6366f1;
            font-size: 0.7rem;
            flex-shrink: 0;
            transition: transform 0.2s;
            padding: 3px 5px;
        }

        /* ── Dropdown ── */
        .vld-multiselect-dropdown {
            position: absolute;
            top: calc(100% + 4px);
            right: 0;
            left: 0;
            z-index: 9999;
            background: #1e1e2e;
            border: 1px solid rgba(99,102,241,0.35);
            border-radius: 10px;
            box-shadow: 0 8px 28px rgba(0,0,0,0.6),
                        0 0 0 1px rgba(99,102,241,0.1);
            overflow: hidden;
            max-height: 260px;
        }

        /* ── כותרת ה-dropdown ── */
        .vld-multiselect-dropdown-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 12px;
            background: rgba(99,102,241,0.08);
            border-bottom: 1px solid rgba(99,102,241,0.2);
            font-size: 0.72rem;
            color: #888;
            flex-shrink: 0;
        }

        .vld-multiselect-dropdown-header span {
            display: flex;
            align-items: center;
            gap: 5px;
            color: #a5b4fc;
            font-weight: 600;
        }

        .vld-multiselect-dropdown-header span i {
            color: #6366f1;
        }

        /* כפתור "בחר הכל / נקה" */
        .vld-multi-ctrl-btn {
            background: none;
            border: 1px solid rgba(99,102,241,0.3);
            border-radius: 4px;
            color: #6366f1;
            font-size: 0.68rem;
            padding: 2px 7px;
            cursor: pointer;
            transition: all 0.15s;
            font-family: inherit;
        }

        .vld-multi-ctrl-btn:hover {
            background: rgba(99,102,241,0.15);
            border-color: rgba(99,102,241,0.55);
            color: #a5b4fc;
        }

        /* ── רשימת אפשרויות ── */
        .vld-multiselect-options-list {
            max-height: 200px;
            overflow-y: auto;
            padding: 4px;
        }

        .vld-multiselect-options-list::-webkit-scrollbar { width: 5px; }
        .vld-multiselect-options-list::-webkit-scrollbar-track { background: #111; }
        .vld-multiselect-options-list::-webkit-scrollbar-thumb {
            background: #333; border-radius: 3px;
        }

        .vld-multiselect-option {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 12px;
            border-radius: 7px;
            cursor: pointer;
            font-size: 0.85rem;
            color: #ccc;
            transition: all 0.12s;
            user-select: none;
            border: 1px solid transparent;
            margin-bottom: 2px;
        }

        .vld-multiselect-option:last-child {
            margin-bottom: 0;
        }

        .vld-multiselect-option:hover {
            background: rgba(99,102,241,0.1);
            color: #e0e0e0;
            border-color: rgba(99,102,241,0.2);
        }

        /* ── תיבת סימון מותאמת ── */
        .vld-multi-checkbox {
            width: 18px;
            height: 18px;
            border: 2px solid #444;
            border-radius: 4px;
            background: #252535;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: all 0.15s;
        }

        .vld-multi-checkbox i {
            font-size: 0.6rem;
            color: transparent;
            transition: all 0.15s;
        }

        /* מצב נבחר */
        .vld-multiselect-selected {
            background: rgba(99,102,241,0.12) !important;
            color: #c4b5fd !important;
            border-color: rgba(99,102,241,0.3) !important;
            font-weight: 600;
        }

        .vld-multiselect-selected .vld-multi-checkbox {
            background: #6366f1;
            border-color: #6366f1;
            box-shadow: 0 0 6px rgba(99,102,241,0.5);
        }

        .vld-multiselect-selected .vld-multi-checkbox i {
            color: white;
        }

        /* ── Footer: מונה ── */
        .vld-multiselect-dropdown-footer {
            padding: 6px 12px;
            background: rgba(0,0,0,0.2);
            border-top: 1px solid rgba(255,255,255,0.05);
            font-size: 0.72rem;
            color: #555;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .vld-multi-count-badge {
            background: rgba(99,102,241,0.15);
            border: 1px solid rgba(99,102,241,0.3);
            color: #a5b4fc;
            padding: 1px 8px;
            border-radius: 8px;
            font-weight: 700;
            font-size: 0.72rem;
        }

        /* ── placeholder כשריק ── */
        .vld-multiselect-placeholder {
            color: #444;
            font-size: 0.82rem;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .vld-multiselect-placeholder i {
            color: #555;
            font-size: 0.75rem;
        }

    </style>
</head>
<body>

    <!-- Header -->
    <div class="vld-header">
        <div class="vld-header-icon">
            <i class="fas fa-clipboard-check"></i>
        </div>
        <div>
            <div class="vld-header-title">תיקוף נתוני מערכת</div>
            <div class="vld-header-sub">
                עדכן ואמת את פרטי המערכת
            </div>
        </div>
