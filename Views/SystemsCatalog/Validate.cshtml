@{
    Layout = null;
    var systemId = ViewBag.SystemId as string ?? "";
}
<!DOCTYPE html>
<html dir="rtl" lang="he">
<head>
    <meta charset="UTF-8"/>
    <link rel="icon" type="image/x-icon" href="https://www.menoramivt.co.il/customers-homepage/static/img/favicon.ico">
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>תיקוף נתוני מערכת</title>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #0f0f1a;
            color: #e0e0e0;
            font-family: 'Segoe UI', Arial, sans-serif;
            direction: rtl;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 30px 16px 60px;
        }

        /* ── Header ── */
        .vld-header {
            width: 100%;
            max-width: 780px;
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 28px;
            padding-bottom: 18px;
            border-bottom: 1px solid #2a2a4e;
        }
        .vld-header-icon {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg,#4f46e5,#7c3aed);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            color: white;
            flex-shrink: 0;
        }
        .vld-header-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: #e0e0e0;
        }
        .vld-header-sub {
            font-size: 0.8rem;
            color: #666;
            margin-top: 3px;
        }
        .vld-system-badge {
            margin-right: auto;
            padding: 4px 14px;
            background: rgba(99,102,241,0.15);
            border: 1px solid rgba(99,102,241,0.4);
            border-radius: 20px;
            font-size: 0.82rem;
            color: #a5b4fc;
            font-weight: 600;
        }

        /* ── Card ── */
        .vld-card {
            width: 100%;
            max-width: 780px;
            background: #1e1e2e;
            border: 1px solid #3a3a5a;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 8px 32px rgba(0,0,0,0.5);
        }
        .vld-card-header {
            padding: 16px 22px;
            background: rgba(99,102,241,0.08);
            border-bottom: 1px solid #2a2a4e;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .vld-card-header i { color: #6366f1; }
        .vld-card-header-title {
            font-size: 0.95rem;
            font-weight: 700;
            color: #c4b5fd;
        }
        .vld-system-name-badge {
            margin-right: auto;
            padding: 3px 12px;
            background: rgba(245,158,11,0.15);
            border: 1px solid rgba(245,158,11,0.35);
            border-radius: 8px;
            color: #fcd34d;
            font-size: 0.85rem;
            font-weight: 700;
        }

        /* ── Form ── */
        .vld-form {
            padding: 22px;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }
        .vld-row {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
            align-items: flex-end;
        }
        .vld-field {
            display: flex;
            flex-direction: column;
            gap: 5px;
            flex: 1;
            min-width: 140px;
        }
        .vld-field-wide  { flex: 2; min-width: 200px; }
        .vld-field-full  { width: 100%; flex: none; }
        .vld-label {
            font-size: 0.75rem;
            font-weight: 600;
            color: #888;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .vld-label i { color: #6366f1; font-size: 0.68rem; }
        .vld-input {
            background: #252535;
            border: 1px solid #3a3a5a;
            border-radius: 7px;
            color: #e0e0e0;
            padding: 9px 12px;
            font-size: 0.85rem;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
            direction: rtl;
            width: 100%;
            font-family: inherit;
        }
        .vld-input:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99,102,241,0.15);
        }
        .vld-input::placeholder { color: #444; }
        .vld-input[dir="ltr"] { direction: ltr; text-align: left; }
        .vld-textarea {
            background: #252535;
            border: 1px solid #3a3a5a;
            border-radius: 7px;
            color: #e0e0e0;
            padding: 9px 12px;
            font-size: 0.85rem;
            outline: none;
            resize: vertical;
            min-height: 70px;
            font-family: inherit;
            direction: rtl;
            transition: border-color 0.2s, box-shadow 0.2s;
            width: 100%;
        }
        .vld-textarea:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99,102,241,0.15);
        }
        .vld-select {
            background: #252535;
            border: 1px solid #3a3a5a;
            border-radius: 7px;
            color: #e0e0e0;
            padding: 9px 12px;
            font-size: 0.85rem;
            outline: none;
            cursor: pointer;
            direction: rtl;
            width: 100%;
            transition: border-color 0.2s;
        }
        .vld-select:focus { border-color: #6366f1; }
        .vld-select option { background: #252535; }

        /* ── Divider ── */
        .vld-section-title {
            font-size: 0.78rem;
            font-weight: 700;
            color: #6366f1;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            display: flex;
            align-items: center;
            gap: 8px;
            padding-bottom: 6px;
            border-bottom: 1px solid #2a2a4e;
        }
        .vld-section-title::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #2a2a4e;
        }

        /* ── Footer ── */
        .vld-footer {
            padding: 16px 22px;
            border-top: 1px solid #2a2a4e;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            background: rgba(0,0,0,0.2);
        }
        .vld-footer-info {
            font-size: 0.78rem;
            color: #555;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .vld-btn {
            padding: 8px 20px;
            background: linear-gradient(135deg,rgba(245,158,11,0.8),rgba(217,119,6,0.9));
            border: 1px solid rgba(245,158,11,0.6);
            border-radius: 6px;
            color: #1a1000;
            font-size: 0.85rem;
            font-weight: 700;
            cursor: pointer;
            display: flex;
        }
        .vld-reset-btn {
            padding: 8px 16px;
            background: transparent;
            border: 1px solid #444;
            border-radius: 6px;
            color: #999;
            font-size: 0.85rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
            position: relative;
            right: 14%;
        }
        .vld-save-btn {
            padding: 8px 20px;
            background: linear-gradient(135deg,rgba(245,158,11,0.8),rgba(217,119,6,0.9));
            border: 1px solid rgba(245,158,11,0.6);
            border-radius: 6px;
            color: #1a1000;
            font-size: 0.85rem;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
        }
        .vld-save-btn:hover:not(:disabled) {
            box-shadow: 0 4px 14px rgba(245,158,11,0.35);
            transform: translateY(-1px);
        }

        .vld-reset-btn:hover {
            background:#2a2a3a; color:#ccc;
        }

        /* ── States ── */
        .vld-loading {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 16px;
            padding: 60px 20px;
            color: #666;
        }
        .vld-loading i { font-size: 2rem; color: #6366f1; }
        .vld-error-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 14px;
            padding: 60px 20px;
            color: #f87171;
            text-align: center;
        }
        .vld-error-state i { font-size: 2.5rem; }

        /* ── Toast ── */
        .vld-toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            padding: 12px 28px;
            border-radius: 10px;
            font-size: 0.9rem;
            font-weight: 600;
            opacity: 0;
            pointer-events: none;
            transition: all 0.3s ease;
            z-index: 9999;
            direction: rtl;
            white-space: nowrap;
        }
        .vld-toast-show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }
        .vld-toast-success {
            background: #166534;
            border: 1px solid #22c55e;
            color: #4ade80;
        }
        .vld-toast-error {
            background: #7f1d1d;
            border: 1px solid #ef4444;
            color: #fca5a5;
        }
        .vld-toast-info {
            background: #1e3a5f;
            border: 1px solid #3b82f6;
            color: #93c5fd;
        }

        /* ── Success overlay ── */
        .vld-success-overlay {
            display: none;
            flex-direction: column;
            align-items: center;
            gap: 16px;
            padding: 50px 20px;
            text-align: center;
        }
        .vld-success-overlay i {
            font-size: 3rem;
            color: #22c55e;
        }
        .vld-success-overlay h2 {
            font-size: 1.3rem;
            color: #86efac;
        }
        .vld-success-overlay p {
            font-size: 0.85rem;
            color: #666;
        }
        
        /* ══ Field Label Tooltips ══ */
        .vld-label {
            cursor: help;
            position: relative;
            width: fit-content;
        }

        .vld-label:hover::after {
            content: attr(data-tooltip);
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            background: #1a1a2e;
            border: 1px solid #6366f1;
            border-radius: 8px;
            padding: 8px 14px;
            font-size: 0.78rem;
            font-weight: 400;
            color: #e0e0e0;
            white-space: normal;
            max-width: 280px;
            z-index: 9999;
            box-shadow: 0 4px 20px rgba(0,0,0,0.6);
            pointer-events: none;
            direction: rtl;
            text-align: right;
            line-height: 1.6;
            min-width: 160px;
        }

        .vld-label:hover::before {
            content: '';
            position: absolute;
            top: calc(100% + 3px);
            right: 10px;
            border: 5px solid transparent;
            border-bottom-color: #6366f1;
            z-index: 9999;
            pointer-events: none;
        }

        /* ══ Automation Section ══ */
        .vld-automation-note-disabled {
            opacity: 0.4;
            pointer-events: none;
        }

        .vld-select option { background: #252535; }

        /* Badge אוטומציה */
        .vld-auto-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px;
            border-radius: 10px;
            font-size: 0.75rem;
            font-weight: 700;
            border: 1px solid;
        }
        .vld-auto-badge-yes {
            background: rgba(34,197,94,0.12);
            border-color: rgba(34,197,94,0.3);
            color: #4ade80;
        }
        .vld-auto-badge-no {
            background: rgba(107,114,128,0.1);
            border-color: rgba(107,114,128,0.2);
            color: #9ca3af;
        }
        .vld-auto-badge-na {
            background: rgba(245,158,11,0.1);
            border-color: rgba(245,158,11,0.25);
            color: #fcd34d;
        }
                /* ══ Auto-fill Button ══ */
        .vld-autofill-btn {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px;
            background: rgba(99,102,241,0.12);
            border: 1px solid rgba(99,102,241,0.35);
            border-radius: 6px;
            color: #a5b4fc;
            font-size: 0.72rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            margin-right: 8px;
            vertical-align: middle;
            font-family: inherit;
        }

        .vld-autofill-btn:hover:not(:disabled) {
            background: rgba(99,102,241,0.25);
            border-color: rgba(99,102,241,0.6);
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(99,102,241,0.25);
        }

        .vld-autofill-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

        .vld-autofill-btn i {
            font-size: 0.68rem;
        }

        /* ─── שדה שמולא אוטומטית ─── */
        .vld-autofilled {
            border-color: #6366f1 !important;
            box-shadow: 0 0 0 3px rgba(99,102,241,0.2) !important;
            background: rgba(99,102,241,0.06) !important;
            transition: all 0.3s ease !important;
        }

        /* Light mode */
        [data-theme="light"] .vld-autofill-btn {
            background: rgba(99,102,241,0.08);
            border-color: rgba(99,102,241,0.25);
            color: #4338ca;
        }

        [data-theme="light"] .vld-autofill-btn:hover:not(:disabled) {
            background: rgba(99,102,241,0.15);
            border-color: rgba(99,102,241,0.45);
        }

        [data-theme="light"] .vld-autofilled {
            border-color: #6366f1 !important;
            box-shadow: 0 0 0 3px rgba(99,102,241,0.15) !important;
            background: rgba(99,102,241,0.04) !important;
        }
        @@media (max-width: 600px) {
            .vld-row { flex-direction: column; }
            .vld-field, .vld-field-wide { min-width: 100%; }
            .vld-system-badge { display: none; }
        }
    </style>
</head>
<body>

    <!-- Header -->
    <div class="vld-header">
        <div class="vld-header-icon">
            <i class="fas fa-clipboard-check"></i>
        </div>
        <div>
            <div class="vld-header-title">תיקוף נתוני מערכת</div>
            <div class="vld-header-sub">
                עדכן ואמת את פרטי המערכת
            </div>
        </div>
        <div class="vld-system-badge" id="vldSystemBadge">
            טוען...
        </div>
    </div>

    <!-- Main Card -->
    <div class="vld-card" id="vldCard">

        <!-- Loading -->
        <div class="vld-loading" id="vldLoading">
            <i class="fas fa-spinner fa-spin"></i>
            <span>טוען נתוני מערכת...</span>
        </div>

        <!-- Error -->
        <div class="vld-error-state" id="vldErrorState" style="display:none">
            <i class="fas fa-exclamation-circle"></i>
            <div id="vldErrorMsg">שגיאה בטעינת הנתונים</div>
        </div>

        <!-- Success overlay (after save) -->
        <div class="vld-success-overlay" id="vldSuccessOverlay">
            <i class="fas fa-check-circle"></i>
            <h2>הנתונים נשמרו בהצלחה!</h2>
            <p id="vldSuccessMsg"></p>
        </div>

        <!-- Form (hidden until loaded) -->
        <div id="vldFormWrap" style="display:none">

            <div class="vld-card-header">
                <i class="fas fa-edit"></i>
                <span class="vld-card-header-title">פרטי המערכת</span>
                <span class="vld-system-name-badge" id="vldNameBadge">
                    טוען...
                </span>
            </div>

            <div class="vld-form">

                <!-- שורה 1: מספר + שם + שם אנגלית -->
                <div class="vld-row">
                    <div class="vld-field">
                        <label class="vld-label"
                            data-tooltip="מספר קטלוג של המערכת">
                            <i class="fas fa-hashtag"></i> מספר
                        </label>
                        <input type="text" id="vldNumber"
                            class="vld-input" placeholder="מספר מערכת"/>
                    </div>
                    <div class="vld-field vld-field-wide">
                        <label class="vld-label"
                            data-tooltip="שם המערכת">
                            <i class="fas fa-layer-group"></i> שם מערכת
                        </label>
                        <input type="text" id="vldName"
                            class="vld-input" placeholder="שם המערכת"/>
                    </div>
                    <div class="vld-field vld-field-wide">
                        <label class="vld-label"
                            data-tooltip="שם המערכת באנגלית">
                            <i class="fas fa-font"></i> שם אנגלית
                        </label>
                        <input type="text" id="vldNameEn"
                            class="vld-input" dir="ltr"
                            placeholder="System name in English"/>
                    </div>
                </div>

                <!-- תיאור -->
                <div class="vld-field vld-field-full">
                    <label class="vld-label"
                        data-tooltip="מלל שמסביר בקצרה על מהות המערכת ותפקידה">
                        <i class="fas fa-align-left"></i> תיאור
                    </label>
                    <textarea id="vldDesc" class="vld-textarea"
                            rows="3"
                            placeholder="תיאור המערכת..."></textarea>
                </div>

                <div class="vld-section-title">
                    <i class="fas fa-info-circle"></i> מצב ואחריות
                </div>

                <!-- שורה 2: סטטוס + מנהל + סביבה -->
                <div class="vld-row">
                    <div class="vld-field">
                        <label class="vld-label"
                            data-tooltip="סטטוס המערכת - האם המערכת פעילה, בהקמה, מבוטלת וכו'">
                            <i class="fas fa-circle-dot"></i> סטטוס
                        </label>
                        <select id="vldStatus" class="vld-select">
                            <option value="">— לא הוגדר —</option>
                            <option value="פעיל">פעיל</option>
                            <option value="פעילה">פעילה</option>
                            <option value="לא פעיל">לא פעיל</option>
                            <option value="לא פעילה">לא פעילה</option>
                            <option value="בפיתוח">בפיתוח</option>
                            <option value="בהקמה">בהקמה</option>
                            <option value="פיילוט">פיילוט</option>
                            <option value="בהקפאה">בהקפאה</option>
                            <option value="מיועד לסגירה">מיועד לסגירה</option>
                            <option value="מבוטלת">מבוטלת</option>
                        </select>
                    </div>
                    <div class="vld-field vld-field-wide">
                        <label class="vld-label"
                            data-tooltip="מנהל המערכת האחראי על המערכת">
                            <i class="fas fa-user-tie"></i> מנהל מערכת
                            <button type="button"
                                    id="vldAutoFillBtn"
                                    class="vld-autofill-btn"
                                    title="מלא אוטומטית צוות/מחלקה/תחום לפי שם המנהל">
                                <i class="fas fa-magic"></i>
                            </button>
                        </label>
                        <input type="text" id="vldManager"
                            class="vld-input" placeholder="שם מנהל המערכת"/>
                    </div>
                    <div class="vld-field">
                        <label class="vld-label"
                            data-tooltip="על איזו תשתית המערכת מותקנת - ייצור, פיתוח, בדיקות וכו'">
                            <i class="fas fa-industry"></i> סביבה
                        </label>
                        <select id="vldEnv" class="vld-select vld-dynamic-select"
                                data-field="environment">
                            <option value="">— בחר סביבה —</option>
                        </select>
                    </div>
                </div>

                <div class="vld-section-title">
                    <i class="fas fa-sitemap"></i> שיוך ארגוני
                </div>

                <!-- שורה 3: תחום + מחלקה + צוות -->
                <div class="vld-row">
                    <div class="vld-field vld-field-wide">
                        <label class="vld-label"
                            data-tooltip="התחום הארגוני אליו שייכת המערכת">
                            <i class="fas fa-sitemap"></i> תחום
                        </label>
                        <select id="vldDomain" class="vld-select vld-dynamic-select"
                                data-field="domain">
                            <option value="">— בחר תחום —</option>
                        </select>
                    </div>
                    <div class="vld-field vld-field-wide">
                        <label class="vld-label"
                            data-tooltip="המחלקה הארגונית האחראית על המערכת">
                            <i class="fas fa-building"></i> מחלקה
                        </label>
                        <select id="vldDept" class="vld-select vld-dynamic-select"
                                data-field="department">
                            <option value="">— בחר מחלקה —</option>
                        </select>
                    </div>
                    <div class="vld-field vld-field-wide">
                        <label class="vld-label"
                            data-tooltip="הצוות שאחראי על המערכת או השירות">
                            <i class="fas fa-users"></i> צוות
                        </label>
                        <select id="vldTeam" class="vld-select vld-dynamic-select"
                                data-field="team">
                            <option value="">— בחר צוות —</option>
                        </select>
                    </div>
                </div>

                <!-- שורה 4: אגף + סיווג + סוג -->
                <div class="vld-row">
                    <div class="vld-field vld-field-wide">
                        <label class="vld-label"
                            data-tooltip="האגף העסקי הראשי אליו שייכת המערכת">
                            <i class="fas fa-briefcase"></i> אגף עסקי
                        </label>
                        <select id="vldBizDiv" class="vld-select vld-dynamic-select"
                                data-field="businessDivision">
                            <option value="">— בחר אגף עסקי —</option>
                        </select>
                    </div>
                    <div class="vld-field vld-field-wide">
                        <label class="vld-label"
                            data-tooltip="סיווג היישום - חיצונית (SaaS), מוצר מדף, מחשוב משתמש קצה (EUC) או פנימית">
                            <i class="fas fa-tag"></i> סיווג יישום
                        </label>
                        <select id="vldAppClass" class="vld-select vld-dynamic-select"
                                data-field="appClassification">
                            <option value="">— בחר סיווג —</option>
                        </select>
                    </div>
                    <div class="vld-field vld-field-wide">
                        <label class="vld-label"
                            data-tooltip="סוג היישום - מודול, ממשק, שירות דיגיטלי, שירות חיצוני, תוכנה או תשתית">
                            <i class="fas fa-cube"></i> סוג יישום
                        </label>
                        <select id="vldAppType" class="vld-select vld-dynamic-select"
                                data-field="appType">
                            <option value="">— בחר סוג —</option>
                        </select>
                    </div>
                </div>

                <div class="vld-section-title">
                    <i class="fas fa-shield-alt"></i> דרישות עסקיות
                </div>

                <!-- שורה 5: קריטיות + זמינות -->
                <div class="vld-row">
                    <div class="vld-field vld-field-wide">
                        <label class="vld-label"
                            data-tooltip="קריטיות עסקית - רמת החשיבות של המערכת לפעילות הארגון: גבוהה, בינונית או נמוכה">
                            <i class="fas fa-exclamation-triangle"></i>
                            קריטיות עסקית
                        </label>
                        <select id="vldCriticality" class="vld-select vld-dynamic-select"
                                data-field="businessCriticality">
                            <option value="">— בחר קריטיות —</option>
                        </select>
                    </div>
                    <div class="vld-field vld-field-wide">
                        <label class="vld-label"
                            data-tooltip="דרישת זמינות - שעות הפעילות הנדרשות של המערכת: 24x7, 12x6 או 12x5">
                            <i class="fas fa-clock"></i> דרישת זמינות
                        </label>
                        <select id="vldAvailability" class="vld-select vld-dynamic-select"
                                data-field="availabilityRequirement">
                            <option value="">— בחר זמינות —</option>
                        </select>
                    </div>
                </div>

                <div class="vld-section-title">
                    <i class="fas fa-handshake"></i> ספקים
                </div>

                <!-- שורה 6: מפרסם + ספק תמיכה -->
                <div class="vld-row">
                    <div class="vld-field vld-field-wide">
                        <label class="vld-label"
                            data-tooltip="הגורם המפרסם או המשווק של המערכת">
                            <i class="fas fa-building-user"></i> מפרסם
                        </label>
                        <input type="text" id="vldPublisher"
                            class="vld-input" placeholder="מפרסם"/>
                    </div>
                    <div class="vld-field vld-field-wide">
                        <label class="vld-label"
                            data-tooltip="שם הספק שמעניק שירותי תמיכה למערכת">
                            <i class="fas fa-headset"></i> ספק תמיכה
                        </label>
                        <input type="text" id="vldVendor"
                            class="vld-input" placeholder="ספק תמיכה"/>
                    </div>
                </div>

                <div class="vld-section-title">
                    <i class="fas fa-robot"></i> אוטומציה
                </div>

                <!-- שורה 7: אוטומציה + הערת אוטומציה -->
                <div class="vld-row">
                    <div class="vld-field">
                        <label class="vld-label"
                            data-tooltip="האם קיימות בדיקות אוטומטיות למערכת זו">
                            <i class="fas fa-robot"></i> בדיקות אוטומטיות
                        </label>
                        <select id="vldHasAutomation" class="vld-select">
                            <option value="לא קיימות">לא קיימות</option>
                            <option value="קיימות">קיימות</option>
                            <option value="לא רלוונטי">לא רלוונטי</option>
                        </select>
                    </div>
                    <div class="vld-field vld-field-wide" id="vldAutomationNoteWrap">
                        <label class="vld-label"
                            data-tooltip="פרטים נוספים על הבדיקות האוטומטיות - סוג הבדיקות, כלים וכו'">
                            <i class="fas fa-sticky-note"></i> הערת אוטומציה
                        </label>
                        <input type="text" id="vldAutomationNote"
                            class="vld-input"
                            placeholder="פרטים על הבדיקות האוטומטיות..."/>
                    </div>
                </div>
            </div><!-- /vld-form -->

            <!-- Footer -->
            <div class="vld-footer">
                <div class="vld-footer-info">
                    <i class="fas fa-info-circle"></i>
                    השינויים יישמרו מיידית במערכת
                </div>

                <!-- ← הוסף כפתור ביטול -->
                <button class="vld-btn vld-reset-btn" id="vldResetBtn">
                    <i class="fas fa-undo"></i>
                    בטל שינויים
                </button>

                <button class="vld-btn vld-save-btn" id="vldSaveBtn">
                    <i class="fas fa-save"></i>
                    שמור ואשר נתונים
                </button>
            </div>

        </div><!-- /vldFormWrap -->
    </div><!-- /vld-card -->

    <div class="vld-toast" id="vldToast"></div>

    <script>
        const SYSTEM_ID = '@systemId';
        let _toastTimer = null;
        let _originalData = null; // ← שמירת נתוני המקור לביטול שינויים

        function showToast(msg, type = 'info') {
            const t = document.getElementById('vldToast');
            if (!t) return;
            t.textContent = msg;
            t.className = `vld-toast vld-toast-${type} vld-toast-show`;
            clearTimeout(_toastTimer);
            _toastTimer = setTimeout(() => {
                t.classList.remove('vld-toast-show');
            }, 3500);
        }

        // ── קרא ערך משדה (input או select) ──────────────────
        function _getFieldValue(elId) {
            const el = document.getElementById(elId);
            if (!el) return null;
            const val = el.value ? el.value.trim() : '';
            return val || null;
        }

        function escHtml(str) {
            if (!str) return '';
            return str
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        // ── טען ערכים דינמיים לכל ה-select ──────────────────
        async function loadDynamicOptions() {
            try {
                const res = await fetch(
                    '/SystemsCatalog/GetSystems',
                    { credentials: 'include' }
                );
                const data = await res.json();
                if (!data.success || !data.systems) return;

                const systems = data.systems;

                // ─── בנה ערכים ייחודיים לכל שדה ───
                const fieldMap = {
                    'environment':            'vldEnv',
                    'domain':                 'vldDomain',
                    'department':             'vldDept',
                    'team':                   'vldTeam',
                    'businessDivision':       'vldBizDiv',
                    'appClassification':      'vldAppClass',
                    'appType':                'vldAppType',
                    'businessCriticality':    'vldCriticality',
                    'availabilityRequirement':'vldAvailability',
                };

                Object.entries(fieldMap).forEach(([field, elId]) => {
                    const selectEl = document.getElementById(elId);
                    if (!selectEl) return;

                    // ─── אסוף ערכים ייחודיים ───
                    const uniqueValues = [...new Set(
                        systems
                            .map(s => s[field])
                            .filter(v => v && String(v).trim() !== '')
                    )].sort((a, b) =>
                        String(a).localeCompare(String(b), 'he')
                    );

                    // ─── שמור ערך נוכחי לפני בניית האפשרויות ───
                    const currentVal = selectEl.dataset.currentValue || '';

                    // ─── הוסף ערך נוכחי אם לא קיים ברשימה ───
                    if (currentVal && !uniqueValues.includes(currentVal)) {
                        uniqueValues.unshift(currentVal);
                    }

                    // ─── בנה options ───
                    uniqueValues.forEach(v => {
                        const opt = document.createElement('option');
                        opt.value = v;
                        opt.textContent = v;
                        if (v === currentVal) opt.selected = true;
                        selectEl.appendChild(opt);
                    });
                });

            } catch (err) {
                console.warn('loadDynamicOptions error:', err);
                // ─── fallback: המר select חזרה ל-input ───
                document.querySelectorAll('.vld-dynamic-select')
                    .forEach(sel => {
                        const input = document.createElement('input');
                        input.type = 'text';
                        input.id = sel.id;
                        input.className = 'vld-input';
                        input.value = sel.dataset.currentValue || '';
                        sel.parentNode.replaceChild(input, sel);
                    });
            }
        }

        // ── טען נתוני מערכת ──────────────────────────────────
        async function loadSystem() {
            try {
                const res = await fetch(
                    `/SystemsCatalog/GetSystemById?id=${encodeURIComponent(SYSTEM_ID)}`,
                    { credentials: 'include' }
                );
                const data = await res.json();

                document.getElementById('vldLoading').style.display = 'none';

                if (!data.success) {
                    document.getElementById('vldErrorState').style.display = 'flex';
                    document.getElementById('vldErrorMsg').textContent =
                        data.error || 'מערכת לא נמצאה';
                    return;
                }

                populateForm(data.system);
                document.getElementById('vldFormWrap').style.display = 'block';

            } catch (err) {
                document.getElementById('vldLoading').style.display = 'none';
                document.getElementById('vldErrorState').style.display = 'flex';
                document.getElementById('vldErrorMsg').textContent =
                    'שגיאה בטעינת הנתונים: ' + err.message;
            }
        }

        function _updateAutomationNoteVisibility(autoVal) {
            const noteWrap = document.getElementById('vldAutomationNoteWrap');
            if (!noteWrap) return;

            if (autoVal === 'קיימות') {
                noteWrap.style.opacity       = '1';
                noteWrap.style.pointerEvents = 'auto';
            } else {
                noteWrap.style.opacity       = '0.4';
                noteWrap.style.pointerEvents = 'none';
            }
        }

        // ── מלא את הטופס ─────────────────────────────────────
        function populateForm(s) {
            // ── שמור עותק של הנתונים המקוריים לביטול שינויים ──
            _originalData = JSON.parse(JSON.stringify(s)); // ← הוסף שורה זו בתחילת הפונקציה

            document.getElementById('vldSystemBadge').textContent =
                s.name || SYSTEM_ID;
            document.getElementById('vldNameBadge').textContent =
                s.name || '';

            document.getElementById('vldNumber').value       = s.number                  || '';
            document.getElementById('vldName').value         = s.name                    || '';
            document.getElementById('vldNameEn').value       = s.nameEn                  || '';
            document.getElementById('vldDesc').value         = s.description             || '';
            document.getElementById('vldManager').value      = s.systemManager           || '';

            document.getElementById('vldPublisher').value    = s.publisher               || '';
            document.getElementById('vldVendor').value       = s.supportVendor           || '';

            const dynamicFields = {
                'vldEnv':          s.environment             || '',
                'vldDomain':       s.domain                  || '',
                'vldDept':         s.department              || '',
                'vldTeam':         s.team                    || '',
                'vldBizDiv':       s.businessDivision        || '',
                'vldAppClass':     s.appClassification       || '',
                'vldAppType':      s.appType                 || '',
                'vldCriticality':  s.businessCriticality     || '',
                'vldAvailability': s.availabilityRequirement || '',
            };

            Object.entries(dynamicFields).forEach(([elId, val]) => {
                const el = document.getElementById(elId);
                if (!el) return;

                if (el.tagName === 'SELECT') {
                    // ─── שמור ערך ב-dataset לשימוש ב-loadDynamicOptions ───
                    el.dataset.currentValue = val;

                    // ─── נסה להגדיר ישירות (אם options כבר נטענו) ───
                    const exists = [...el.options]
                        .some(o => o.value === val);

                    if (exists) {
                        el.value = val;
                    } else if (val) {
                        // ─── הוסף option זמני ───
                        const opt = document.createElement('option');
                        opt.value = val;
                        opt.textContent = val;
                        opt.selected = true;
                        el.appendChild(opt);
                    }
                } else {
                    // ─── fallback: input רגיל ───
                    el.value = val;
                }
            });

            // מלא שדות אוטומציה
            const autoVal = s.hasAutomation || 'לא קיימות';
            document.getElementById('vldHasAutomation').value = autoVal;
            document.getElementById('vldAutomationNote').value = s.automationNote || '';

            // הצג/הסתר שדה הערה לפי ערך האוטומציה
            _updateAutomationNoteVisibility(autoVal);

            // ─── טיפול בסטטוס עם fallback לערך לא מוכר ───
            const statusSelect = document.getElementById('vldStatus');
            const statusValue  = s.status || '';

            // ─── בדוק אם הערך קיים ב-options ───
            const optionExists = Array.from(statusSelect.options)
                .some(opt => opt.value === statusValue);

            if (optionExists) {
                // ─── ערך קיים - הגדר ישירות ───
                statusSelect.value = statusValue;
            } else if (statusValue) {
                // ─── ערך לא קיים - הוסף option דינמי ───
                const newOption = document.createElement('option');
                newOption.value = statusValue;
                newOption.textContent = statusValue;
                newOption.style.color = '#fcd34d'; // ← צהוב להדגשה
                // ─── הוסף אחרי האפשרות הראשונה (— לא הוגדר —) ───
                statusSelect.insertBefore(newOption, statusSelect.options[1]);
                statusSelect.value = statusValue;
            } else {
                // ─── ריק - הגדר ברירת מחדל ───
                statusSelect.value = '';
            }
        }

        // ── בטל שינויים - חזור לנתונים המקוריים ──────────────
        function resetForm() {
            if (!_originalData) {
                showToast('אין נתונים מקוריים לשחזור', 'info');
                return;
            }

            // ── אישור מהמשתמש ──
            if (!confirm('האם לבטל את כל השינויים ולחזור לנתונים המקוריים?')) {
                return;
            }

            populateForm(_originalData);
            showToast('↩️ השינויים בוטלו - הנתונים שוחזרו', 'info');
        }

        // ── שמור נתונים ──────────────────────────────────────
        async function saveSystem() {
            const saveBtn = document.getElementById('vldSaveBtn');
            if (saveBtn) {
                saveBtn.disabled = true;
                saveBtn.innerHTML =
                    '<i class="fas fa-spinner fa-spin"></i> שומר...';
            }

            try {
                // ─── חפש מייל מנהל אוטומטית ─────────────────────────
                const managerName = document.getElementById('vldManager')
                    ?.value?.trim() || '';
                let managerEmail = '';

                if (managerName.length >= 2) {
                    try {
                        const emailRes = await fetch(
                            `/PhoneDirectory/GetManagerEmail?name=` +
                            `${encodeURIComponent(managerName)}`,
                            { credentials: 'include' }
                        );
                        const emailData = await emailRes.json();
                        if (emailData.success && emailData.email) {
                            managerEmail = emailData.email;
                        }
                    } catch (err) {
                        console.warn('GetManagerEmail error:', err);
                    }
                }

                // ─── בנה payload ──────────────────────────────────────
                const payload = {
                    systemId:                SYSTEM_ID,
                    number:                  document.getElementById('vldNumber').value.trim()          || null,
                    name:                    document.getElementById('vldName').value.trim()            || null,
                    nameEn:                  document.getElementById('vldNameEn').value.trim()          || null,
                    description:             document.getElementById('vldDesc').value.trim()            || null,
                    status:                  document.getElementById('vldStatus').value                 || null,
                    systemManager:           document.getElementById('vldManager').value.trim()         || null,
                    managerEmail:            managerEmail || null,  // ← מייל שנמצא אוטומטית
                    environment:             _getFieldValue('vldEnv'),
                    domain:                  _getFieldValue('vldDomain'),
                    department:              _getFieldValue('vldDept'),
                    team:                    _getFieldValue('vldTeam'),
                    businessDivision:        _getFieldValue('vldBizDiv'),
                    appClassification:       _getFieldValue('vldAppClass'),
                    appType:                 _getFieldValue('vldAppType'),
                    businessCriticality:     _getFieldValue('vldCriticality'),
                    availabilityRequirement: _getFieldValue('vldAvailability'),
                    publisher:               document.getElementById('vldPublisher').value.trim()       || null,
                    supportVendor:           document.getElementById('vldVendor').value.trim()          || null,
                    hasAutomation:           document.getElementById('vldHasAutomation').value          || 'לא קיימות',
                    automationNote:          document.getElementById('vldAutomationNote').value.trim()  || null,
                };

                const res = await fetch('/SystemsCatalog/UpdateSystemPublic', {
                    method:  'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body:    JSON.stringify(payload)
                });
                const data = await res.json();

                if (!data.success)
                    throw new Error(data.error || 'שגיאה בשמירה');

                // ── הצג success overlay ───────────────────────────────
                document.getElementById('vldFormWrap').style.display = 'none';
                const overlay = document.getElementById('vldSuccessOverlay');
                overlay.style.display = 'flex';

                document.getElementById('vldSuccessMsg').textContent =
                    `המערכת "${data.system?.name || ''}" עודכנה בהצלחה` +
                    (managerEmail
                        ? ` | מייל אישור נשלח ל-${managerEmail}`
                        : '');

                document.getElementById('vldSystemBadge').textContent =
                    '✓ ' + (data.system?.name || '');

                showToast(
                    managerEmail
                        ? `✅ הנתונים נשמרו ומייל אישור נשלח`
                        : `✅ הנתונים נשמרו בהצלחה`,
                    'success'
                );

            } catch (err) {
                console.error('saveSystem error:', err);
                showToast('שגיאה: ' + err.message, 'error');

                if (saveBtn) {
                    saveBtn.disabled = false;
                    saveBtn.innerHTML =
                        '<i class="fas fa-save"></i> שמור ואשר נתונים';
                }
            }
        }

        // ══════════════════════════════════════════════════════
        // Auto-fill שיוך ארגוני לפי שם מנהל מערכת
        // ══════════════════════════════════════════════════════
        async function autoFillOrgInfo(managerName) {
            if (!managerName || managerName.trim().length < 2) {
                showToast('הזן שם מנהל מערכת תחילה', 'info');
                return;
            }

            const btn = document.getElementById('vldAutoFillBtn');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            }

            try {
                const res = await fetch(
                    `/PhoneDirectory/GetEmployeeOrgInfo?name=` +
                    `${encodeURIComponent(managerName.trim())}`,
                    { credentials: 'include' }
                );
                const data = await res.json();

                if (!data.success || !data.employee) {
                    showToast(
                        `⚠️ לא נמצא עובד בשם: ${managerName}`,
                        'info'
                    );
                    return;
                }

                const emp = data.employee;

                // ─── מפה: id שדה → ערך מהעובד ───────────────
                const fields = [
                    { id: 'vldTeam',   val: emp.team,       label: 'צוות'   },
                    { id: 'vldDept',   val: emp.department, label: 'מחלקה'  },
                    { id: 'vldDomain', val: emp.domain,     label: 'תחום'   },
                ];

                const filled   = [];
                const skipped  = [];

                fields.forEach(({ id, val, label }) => {
                    const el = document.getElementById(id);
                    if (!el || !val) return;

                    // ─── בדוק אם ריק ───────────────────────
                    const isEmpty = !el.value || el.value.trim() === '';
                    if (!isEmpty) {
                        skipped.push(label);
                        return;
                    }

                    // ─── select דינמי ──────────────────────
                    if (el.tagName === 'SELECT') {
                        const exists = [...el.options]
                            .some(o => o.value === val);

                        if (!exists) {
                            // ─── הוסף option אם לא קיים ───
                            const opt = document.createElement('option');
                            opt.value = val;
                            opt.textContent = val;
                            el.appendChild(opt);
                        }
                        el.value = val;
                    } else {
                        // ─── input רגיל ────────────────────
                        el.value = val;
                    }

                    // ─── אנימציית הדגשה ────────────────────
                    el.classList.add('vld-autofilled');
                    setTimeout(() =>
                        el.classList.remove('vld-autofilled'), 3000
                    );

                    filled.push(label);
                });

                // ─── הצג תוצאה ─────────────────────────────
                if (filled.length > 0) {
                    showToast(
                        `✅ מולאו: ${filled.join(', ')} (${emp.fullName})`,
                        'success'
                    );
                } else if (skipped.length > 0) {
                    showToast(
                        `ℹ️ כל השדות כבר מלאים (${emp.fullName})`,
                        'info'
                    );
                } else {
                    showToast(
                        `ℹ️ לא נמצאו נתונים למילוי (${emp.fullName})`,
                        'info'
                    );
                }

            } catch (err) {
                console.error('autoFillOrgInfo error:', err);
                showToast('שגיאה בחיפוש עובד', 'error');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML =
                        '<i class="fas fa-magic"></i> מלא אוטומטית';
                }
            }

            // ─── חפש מייל מנהל אוטומטית ───────────────────────────
            const emailEl = document.getElementById('vldManagerEmail');
            if (emailEl && (!emailEl.value || emailEl.value.trim() === '')) {
                try {
                    const emailRes = await fetch(
                        `/PhoneDirectory/GetManagerEmail?name=` +
                        `${encodeURIComponent(managerName.trim())}`,
                        { credentials: 'include' }
                    );
                    const emailData = await emailRes.json();
                    if (emailData.success && emailData.email) {
                        emailEl.value = emailData.email;
                        emailEl.classList.add('vld-autofilled');
                        setTimeout(() =>
                            emailEl.classList.remove('vld-autofilled'), 3000
                        );
                    }
                } catch (err) {
                    console.warn('GetManagerEmail error:', err);
                }
            }
        }

            
        // ── אירועים ──────────────────────────────────────────
        document.getElementById('vldSaveBtn')
            .addEventListener('click', saveSystem);

        document.getElementById('vldResetBtn')
            .addEventListener('click', resetForm);

        document.getElementById('vldHasAutomation')
            .addEventListener('change', function() {
                _updateAutomationNoteVisibility(this.value);
            });

        // ─── כפתור Auto-fill ───────────────────────────────
        document.getElementById('vldAutoFillBtn')
            ?.addEventListener('click', () => {
                const name = document.getElementById('vldManager')
                    ?.value?.trim();
                autoFillOrgInfo(name);
            });

        // ─── Auto-fill אוטומטי בעזיבת שדה המנהל ──────────
        document.getElementById('vldManager')
            ?.addEventListener('blur', e => {
                const val = e.target.value?.trim();
                if (val?.length >= 2) {
                    autoFillOrgInfo(val);
                }
            });

        // ── טען בעמוד ─────────────────────────────────────────
        // ─── טען במקביל: נתוני מערכת + ערכים דינמיים ───
        Promise.all([
            loadSystem(),
            loadDynamicOptions()
        ]).then(() => {
            // ─── לאחר טעינת שניהם - ודא שהערכים מוגדרים נכון ───
            document.querySelectorAll('.vld-dynamic-select')
                .forEach(sel => {
                    const savedVal = sel.dataset.currentValue;
                    if (savedVal && sel.value !== savedVal) {
                        // ─── נסה שוב להגדיר ───
                        const exists = [...sel.options]
                            .some(o => o.value === savedVal);
                        if (exists) {
                            sel.value = savedVal;
                        } else if (savedVal) {
                            const opt = document.createElement('option');
                            opt.value = savedVal;
                            opt.textContent = savedVal;
                            opt.selected = true;
                            sel.appendChild(opt);
                            sel.value = savedVal;
                        }
                    }
                });
        });
    </script>

</body>
</html>