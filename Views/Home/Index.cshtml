    <script>
        // ==========================================
        // Portal Theme Toggle (Dark/Light Mode)
        // ==========================================
        
        function initPortalTheme() {
            const savedTheme = userSettings.getItem('portalColorTheme') || 'light';
            applyPortalTheme(savedTheme);
        }

        function togglePortalTheme() {
            const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            applyPortalTheme(newTheme);
            userSettings.setItem('portalColorTheme', newTheme);
        }

        function applyPortalTheme(theme) {
            const root = document.documentElement;
            const btn = document.getElementById('portalThemeBtn');

            if (theme === 'dark') {
                root.setAttribute('data-theme', 'dark');
                if (btn) {
                    btn.innerHTML = '<i class="fas fa-sun"></i>';
                    btn.title = 'עבור ל-Light Mode';
                }
            } else {
                root.removeAttribute('data-theme');
                if (btn) {
                    btn.innerHTML = '<i class="fas fa-moon"></i>';
                    btn.title = 'עבור ל-Dark Mode';
                }
            }
        }

        // אתחול בטעינת הדף
        document.addEventListener('DOMContentLoaded', () => {
            initPortalTheme();
        });
        
        // אתחול מיידי למניעת flash
        (function() {
            const savedTheme = userSettings.getItem('portalColorTheme');
            if (savedTheme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();
    </script>
    <script>
        (function () {
            const btn = document.getElementById('scrollToTopBtn');
            
            if (!btn) return;

            btn.style.cssText = `
                position: fixed;
                bottom: 30px;
                left: 30px;
                width: 46px;
                height: 46px;
                border-radius: 50%;
                background: linear-gradient(135deg, #7c3aed, #a78bfa);
                color: white;
                border: none;
                cursor: pointer;
                font-size: 1.1rem;
                display: flex;
                align-items: center;
                justify-content: center;
                box-shadow: 0 4px 16px rgba(124,58,237,0.45);
                opacity: 0;
                pointer-events: none;
                transition: opacity 0.3s ease, transform 0.3s ease;
                transform: translateY(10px);
            `;

            // פונקציות הצגה/הסתרה ישירות על style - לא על class
            const showBtn = () => {
                btn.style.opacity = '1';
                btn.style.pointerEvents = 'auto';
                btn.style.transform = 'translateY(0)';
            };

            const hideBtn = () => {
                btn.style.opacity = '0';
                btn.style.pointerEvents = 'none';
                btn.style.transform = 'translateY(10px)';
            };

            const onScroll = () => {
                const scrollTop = window.scrollY 
                            || document.documentElement.scrollTop;

                if (scrollTop > window.innerHeight / 2) {
                    showBtn();
                } else {
                    hideBtn();
                }
            };

            window.addEventListener('scroll', onScroll, { passive: true });

            btn.addEventListener('click', () => {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });

            btn.addEventListener('mouseenter', () => {
                btn.style.transform = 'translateY(-3px) scale(1.08)';
                btn.style.boxShadow = '0 8px 24px rgba(124,58,237,0.55)';
            });

            btn.addEventListener('mouseleave', () => {
                btn.style.transform = 'translateY(0) scale(1)';
                btn.style.boxShadow = '0 4px 16px rgba(124,58,237,0.45)';
            });

        })();

        function clearUserLocalStorage() {
            // מחק נתוני משתמש מ-localStorage
            const keysToRemove = [
                'currentUser',
                'lastSelectedEmployee'
            ];
            
            keysToRemove.forEach(key => userSettings.removeItem(key));
            
            // מחק מ-sessionStorage
            sessionStorage.removeItem('currentUser');
            
        }
        // ══════════════════════════════════════════════════════════════════
        // PhoneChangesAlert - ניהול התראת שינויים ספר טלפונים
        // ══════════════════════════════════════════════════════════════════
        const PhoneChangesAlert = {

            // ─── מפתח localStorage ───────────────────────────────────────
            STORAGE_KEY: 'phoneChangesAlertDismissed',

            // ─── אתחול ───────────────────────────────────────────────────
            async init() {
                // ─── בדוק אם Admin או NOC ────────────────────────────────
                // הפונקציה תרוץ רק אם הכפתור קיים ב-DOM
                const alertBtn = document.getElementById('phoneChangesAlertBtn');
                if (!alertBtn) return;

                await this.checkForChanges();
            },

            // ─── בדוק שינויים מהשרת ──────────────────────────────────────
            async checkForChanges() {
                try {
                    const res  = await fetch(
                        '/PhoneDirectoryChanges/GetPendingChangesCount',
                        { method: 'GET' }
                    );
                    const data = await res.json();

                    if (!data.success) return;

                    // ← בדוק גם pending וגם reApprove
                    const hasPending   = data.pendingCount   > 0;
                    const hasReApprove = data.reApproveCount > 0;
                    if (!hasPending && !hasReApprove) {
                        const btn = document.getElementById('phoneChangesAlertBtn');
                        if (btn) {
                            btn.classList.remove('visible');
                        }
                        return;
                    }
                    // ─── עדכן כפתור ──────────────────────────────────────
                    this.updateAlertButton(data.pendingCount, data.reApproveCount);

                    // ─── הצג פופאפ (אם לא נדחה היום) ────────────────────
                    if (!this.isDismissedToday()) {
                        this.showPopup(data);
                    }

                } catch (err) {
                    console.warn('PhoneChangesAlert: לא ניתן לבדוק שינויים', err);
                }
            },

            // ─── עדכן כפתור התראה ────────────────────────────────────────
            updateAlertButton(pendingCount, reApproveCount = 0) {
                    const btn     = document.getElementById('phoneChangesAlertBtn');
                    const countEl = document.getElementById('phoneChangesCount');

                    if (!btn) return;

                    btn.classList.add('visible');

                    // ← הצג מונה כולל
                    const total = (pendingCount || 0) + (reApproveCount || 0);
                    if (countEl) countEl.textContent = total;
                },

            // ─── הצג פופאפ ───────────────────────────────────────────────
            showPopup(data) {
                const overlay = document.getElementById(
                    'phoneChangesPopupOverlay');
                if (!overlay) return;

                this.updatePopupData(data);

                // ← הוסף class לכותרת אם יש reApprove
                const subtitle = document.getElementById('popupSubtitle');
                if (subtitle) {
                    subtitle.classList.toggle(
                        'has-reapprove',
                        (data.reApproveCount ?? 0) > 0
                    );
                }

                overlay.classList.add('visible');
                document.body.style.overflow = 'hidden';
            },

            // ─── עדכן נתונים בפופאפ ──────────────────────────────────────
            updatePopupData(data) {
                // ─── כותרת משנה ──────────────────────────────────────────
                const subtitle = document.getElementById('popupSubtitle');
                if (subtitle) {
                    const parts = [];
                    if (data.pendingCount > 0)
                        parts.push(`${data.pendingCount} ממתינים לאישור`);
                    if (data.reApproveCount > 0)
                        parts.push(`${data.reApproveCount} ממתינים לאישור מחדש`);

                    subtitle.textContent = parts.length > 0
                        ? parts.join(' | ')
                        : 'נמצאו שינויים';
                }

                // ─── כרטיסי סיכום ────────────────────────────────────────
                const newEl     = document.getElementById('popupNewCount');
                const removedEl = document.getElementById('popupRemovedCount');
                const changedEl = document.getElementById('popupChangedCount');
                const reApproveEl = document.getElementById('popupReApproveCount');

                if (newEl     && data.summary)
                    newEl.textContent     = data.summary.newEmployees     ?? 0;
                if (removedEl && data.summary)
                    removedEl.textContent = data.summary.removedEmployees ?? 0;
                if (changedEl && data.summary)
                    changedEl.textContent = data.summary.fieldChanges     ?? 0;
                if (reApproveEl && data.reApproveCount)
                    reApproveEl.textContent = data.reApproveCount     ?? 0;

                // ─── תאריך קובץ ──────────────────────────────────────────
                const dateEl = document.getElementById('popupFileDate');
                if (dateEl && data.fileDate)
                    dateEl.textContent = data.fileDate;
            },

            // ─── סגור פופאפ ──────────────────────────────────────────────
            close() {
                const overlay = document.getElementById(
                    'phoneChangesPopupOverlay');
                if (!overlay) return;

                // ─── בדוק "אל תציג שוב היום" ─────────────────────────────
                const dontShow = document.getElementById('dontShowTodayCheck');
                if (dontShow?.checked) {
                    this.dismissToday();
                }

                overlay.classList.remove('visible');
                document.body.style.overflow = '';
            },

            // ─── סגור בלחיצה על overlay ──────────────────────────────────
            closeOnOverlay(event) {
                // ─── סגור רק אם לחצו על ה-overlay עצמו ──────────────────
                if (event.target === event.currentTarget) {
                    this.close();
                }
            },

            // ─── שמור דחייה להיום ────────────────────────────────────────
            dismissToday() {
                const today = new Date().toDateString();
                userSettings.setItem(this.STORAGE_KEY, today);
            },

            // ─── בדוק אם נדחה היום ───────────────────────────────────────
            isDismissedToday() {
                const stored = userSettings.getItem(this.STORAGE_KEY);
                if (!stored) return false;
                return stored === new Date().toDateString();
            }
        };

        // ── אתחול בטעינת הדף ──────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', () => {
            PhoneChangesAlert.init();
        });

        // ── סגירה ב-Escape ────────────────────────────────────────────────
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                PhoneChangesAlert.close();
            }
        });
    </script>
</body>

</html>