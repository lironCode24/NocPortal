@{
    ViewData["Title"] = "NOC Dashboards";
    Layout = null;
}
<!DOCTYPE html>
<html lang="he" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="https://www.menoramivt.co.il/customers-homepage/static/img/favicon.ico">
    <link rel="stylesheet" href="https://cdn.menoramivt.co.il/public/fonts/fonts.css">
    <link rel="stylesheet" href="/fontawesome/css/all.min.css">
    <link rel="stylesheet" href="~/css/noc-portal.css">
    <link rel="stylesheet" href="/lib/flatpickr-4.6.13/dist/flatpickr.min.css">
    <script src="/lib/flatpickr-4.6.13/dist/flatpickr.min.js"></script>
    <script src="/lib/flatpickr-4.6.13/dist/l10n/he.js"></script>
    <script src="/lib/xlsx/xlsx.full.min.js"></script>
    <script src="/lib/xlsx/exceljs.min.js"></script>
    <script src="/lib/xlsx/FileSaver.min.js"></script>
    <script src="/lib/html2canvas/html2canvas.min.js"></script>
    <script src="/lib/npm/chart.js"></script>
    <script src="/lib/npm/chartjs-adapter-date-fns.bundle.min.js"></script>
    <style>
        body {
            font-family: 'Assistant', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f5f5f5;
        }
    </style>
</head>

<body>
    <div id="userMenuTemplate" style="display:none">
        <div class="user-menu-section">
            <div class="user-menu-section-right">
                <div class="user-info" id="userHi">
                    <i class="fas fa-user-circle"></i>
                    <span class="user-display-name">
                        היי, @User.FindFirst("DisplayName")?.Value
                    </span>
                </div>

                <!-- ══ הודעות ממתינות ══════════════════════════════════════ -->
                <div class="user-messages-row" id="userMessagesRow" 
                    style="display:none">
                    <button class="btn-messages-indicator" 
                            id="btnMessagesIndicator"
                            onclick="openPendingMessages()">
                        <div class="messages-bell-wrap">
                            <i class="fas fa-bell"></i>
                            <span class="messages-badge" 
                                id="messagesBadge">0</span>
                        </div>
                        <span class="messages-indicator-text">
                            הודעות הממתינות לאישור
                        </span>
                        <i class="fas fa-chevron-left messages-arrow"></i>
                    </button>
                </div>
                <!-- ══════════════════════════════════════════════════════════ -->
            </div>
            <div class="user-info">
                <form method="post" action="/Auth/Logout" onsubmit="clearUserLocalStorage()">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-header-logout">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Logout</span>
                    </button>
                </form>
                <button id="backToPortalBtn"
                        style="display:none"
                        class="dashboard-toolbar-btn"
                        onclick="window.location.href='/home'">
                    Back to Portal
                </button>
            </div>
        </div>
    </div>
    <!-- תוכן הדף יוכנס דינמית על ידי DashboardsManager -->
    <script src="~/js/DashboardsManager.js"asp-append-version="true"></script>
    <script src="~/js/message-popup.js"></script>
</body>

</html>

<script>
        function clearUserLocalStorage() {
            // מחק נתוני משתמש מ-localStorage
            const keysToRemove = [
                'currentUser',
                'lastSelectedEmployee'
            ];
            
            keysToRemove.forEach(key => localStorage.removeItem(key));
            
            // מחק מ-sessionStorage
            sessionStorage.removeItem('currentUser');
            
        }
</script>