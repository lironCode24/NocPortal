<!-- ============ JAVASCRIPT ============ -->
<script>
// ─────────────────────────────────────────
//  SEARCH
// ─────────────────────────────────────────
const searchInput     = document.getElementById('userSearchInput');
const searchClearBtn  = document.getElementById('searchClearBtn');
const searchInfo      = document.getElementById('searchResultsInfo');
const searchInfoText  = document.getElementById('searchResultsText');
const noResults       = document.getElementById('noSearchResults');
const noResultsTerm   = document.getElementById('noResultsTerm');
const allUsersCount   = document.getElementById('allUsersCount');

// כל השורות בשתי הטבלאות
const allRows = [
    ...document.querySelectorAll('#allUsersBody tr'),
    ...document.querySelectorAll('#pendingTable tbody tr')
];

let activeFilter = 'all';
let searchTerm   = '';

function runSearch() {
    searchTerm = searchInput.value.trim().toLowerCase();

    // כפתור ניקוי
    searchClearBtn.classList.toggle('visible', searchTerm.length > 0);

    applyFilters();
}

function applyFilters() {
    let visibleCount = 0;

    allRows.forEach(row => {
        const username    = row.dataset.username    || '';
        const displayname = row.dataset.displayname || '';
        const role        = row.dataset.role        || '';
        const status      = row.dataset.status      || '';

        // בדיקת filter chip
        let chipMatch = true;
        if (activeFilter === 'pending') {
            chipMatch = status === 'pending';
        } else if (activeFilter !== 'all') {
            chipMatch = role === activeFilter;
        }

        // בדיקת חיפוש טקסט
        let searchMatch = true;
        if (searchTerm) {
            searchMatch =
                username.includes(searchTerm)    ||
                displayname.includes(searchTerm) ||
                role.toLowerCase().includes(searchTerm);
        }

        const isVisible = chipMatch && searchMatch;

        row.classList.toggle('search-hidden', !isVisible);
        row.classList.toggle('search-highlight', isVisible && searchTerm.length > 0);

        if (isVisible) {
            visibleCount++;
            // הדגשת טקסט תואם
            if (searchTerm) highlightRow(row, searchTerm);
            else            clearHighlight(row);
        } else {
            clearHighlight(row);
        }
    });

    // עדכון מונה
    if (allUsersCount) allUsersCount.textContent = visibleCount;

    // הודעת תוצאות
    updateSearchInfo(visibleCount);
}

function highlightRow(row, term) {
    row.querySelectorAll('[data-field]').forEach(el => {
        const original = el.getAttribute('data-original') || el.textContent;
        el.setAttribute('data-original', original);

        const regex   = new RegExp(`(${escapeRegex(term)})`, 'gi');
        el.innerHTML  = original.replace(
            regex,
            '<span class="search-match-text">$1</span>'
        );
    });
}

function clearHighlight(row) {
    row.querySelectorAll('[data-field]').forEach(el => {
        const original = el.getAttribute('data-original');
        if (original) {
            el.textContent = original;
            el.removeAttribute('data-original');
        }
    });
}

function updateSearchInfo(count) {
    if (!searchTerm && activeFilter === 'all') {
        searchInfo.style.display = 'none';
        if (noResults) noResults.style.display = 'none';
        return;
    }

    searchInfo.style.display = 'flex';

    if (count === 0) {
        searchInfo.classList.remove('has-results');
        searchInfoText.textContent = 'לא נמצאו תוצאות';
        if (noResults) {
            noResults.style.display = 'block';
            if (noResultsTerm) noResultsTerm.textContent = searchTerm;
        }
    } else {
        searchInfo.classList.add('has-results');
        searchInfoText.textContent = `נמצאו ${count} משתמשים`;
        if (noResults) noResults.style.display = 'none';
    }
}

function escapeRegex(str) {
    return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

// אירועי חיפוש
searchInput.addEventListener('input', runSearch);

searchInput.addEventListener('keydown', e => {
    if (e.key === 'Escape') clearSearch();
});

searchClearBtn.addEventListener('click', clearSearch);

function clearSearch() {
    searchInput.value = '';
    searchTerm = '';
    searchClearBtn.classList.remove('visible');
    applyFilters();
    searchInput.focus();
}

// ─────────────────────────────────────────
//  FILTER CHIPS
// ─────────────────────────────────────────
document.querySelectorAll('.filter-chip').forEach(chip => {
    chip.addEventListener('click', () => {
        document.querySelectorAll('.filter-chip').forEach(c =>
            c.classList.remove('active')
        );
        chip.classList.add('active');
        activeFilter = chip.dataset.filter;
        applyFilters();
    });
});

// ─────────────────────────────────────────
//  SORT
// ─────────────────────────────────────────
let sortState = { col: null, dir: 'asc' };

document.querySelectorAll('.users-table th.sortable').forEach(th => {
    th.addEventListener('click', () => {
        const col = th.dataset.col;

        if (sortState.col === col) {
            sortState.dir = sortState.dir === 'asc' ? 'desc' : 'asc';
        } else {
            sortState.col = col;
            sortState.dir = 'asc';
        }

        // עדכון אייקונים
        document.querySelectorAll('.users-table th.sortable').forEach(t => {
            t.classList.remove('sort-asc', 'sort-desc');
            t.querySelector('.sort-icon').className = 'fas fa-sort sort-icon';
        });

        th.classList.add(`sort-${sortState.dir}`);
        th.querySelector('.sort-icon').className =
            `fas fa-sort-${sortState.dir === 'asc' ? 'up' : 'down'} sort-icon`;

        sortTable(col, sortState.dir);
    });
});

function sortTable(col, dir) {
    const tbody = document.getElementById('allUsersBody');
    if (!tbody) return;

    const rows = Array.from(tbody.querySelectorAll('tr'));

    rows.sort((a, b) => {
        let valA = '';
        let valB = '';

        switch (col) {
            case 'name':
                valA = a.dataset.displayname || '';
                valB = b.dataset.displayname || '';
                break;
            case 'username':
                valA = a.dataset.username || '';
                valB = b.dataset.username || '';
                break;
            case 'role':
                valA = a.dataset.role || '';
                valB = b.dataset.role || '';
                break;
            case 'status':
                valA = a.dataset.status || '';
                valB = b.dataset.status || '';
                break;
            case 'date':
                valA = a.dataset.date || '';
                valB = b.dataset.date || '';
                break;
        }

        const cmp = valA.localeCompare(valB, 'he');
        return dir === 'asc' ? cmp : -cmp;
    });

    rows.forEach(r => tbody.appendChild(r));
}

// ─────────────────────────────────────────
//  CONFIRM DELETE
// ─────────────────────────────────────────
function confirmDelete(username) {
    return confirm(`האם למחוק את המשתמש "${username}"?\nפעולה זו אינה ניתנת לביטול.`);
}

// ─────────────────────────────────────────
//  TOAST
// ─────────────────────────────────────────
function showToast(message, type = 'info') {
    const container = document.getElementById('toastContainer');
    const toast     = document.createElement('div');

    toast.className = `toast toast-${type}`;
    toast.innerHTML = `
        <i class="fas fa-${type === 'success' ? 'check-circle' :
                           type === 'error'   ? 'exclamation-circle' :
                                                'info-circle'}"></i>
        <span>${message}</span>
    `;

    container.appendChild(toast);

    setTimeout(() => {
        toast.classList.add('toast-out');
        setTimeout(() => toast.remove(), 300);
    }, 3500);
}

// הצגת toast אם יש הודעת הצלחה
@if (TempData["Success"] != null)
{
    <text>
    document.addEventListener('DOMContentLoaded', () => {
        showToast('@TempData["Success"]', 'success');
    });
    </text>
}

// ─────────────────────────────────────────
//  KEYBOARD SHORTCUT  Ctrl+F → focus search
// ─────────────────────────────────────────
// ── מאחד את כל ה-Escape handlers ──
document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;

    // סגור מודאלים פתוחים
    closePermissionsModal();
    closeResetPasswordModal();
    closeEmailModal();
    closeEditUserModal();
    closeRejectModal();

    // סגור role edit forms
    document.querySelectorAll('.role-edit-form').forEach(form => {
        if (form.style.display !== 'none') {
            const userId   = form.id.replace('role-form-', '');
            const select   = document.getElementById(`role-select-${userId}`);
            const origRole = select?.getAttribute('data-original-role');
            if (origRole) closeRoleEdit(userId, origRole);
        }
    });
});

// ─────────────────────────────────────────
//  ROLE CHANGE
// ─────────────────────────────────────────

// פתיחת טופס עריכת תפקיד
function openRoleEdit(userId, currentRole) {
    const display = document.getElementById(`role-display-${userId}`);
    const form    = document.getElementById(`role-form-${userId}`);
    const select  = document.getElementById(`role-select-${userId}`);

    if (!display || !form) return;

    display.style.display = 'none';
    form.style.display    = 'block';

    // וודא שה-select מציג את התפקיד הנוכחי
    if (select) select.value = currentRole;

    // נקה תצוגה מקדימה
    updateRolePreview(userId, currentRole, currentRole);

    // פוקוס על ה-select
    setTimeout(() => select && select.focus(), 50);
}

// סגירת טופס עריכת תפקיד (ביטול)
function closeRoleEdit(userId, originalRole) {
    const display = document.getElementById(`role-display-${userId}`);
    const form    = document.getElementById(`role-form-${userId}`);
    const select  = document.getElementById(`role-select-${userId}`);

    if (!display || !form) return;

    // החזר לתפקיד המקורי
    if (select) select.value = originalRole;

    form.style.display    = 'none';
    display.style.display = 'flex';
}

// תצוגה מקדימה של שינוי תפקיד
function previewRoleChange(userId, newRole) {
    const row         = document.querySelector(`tr[data-username]`);
    const currentRole = document.getElementById(`role-select-${userId}`)
                            ?.getAttribute('data-original-role');

    updateRolePreview(userId, currentRole, newRole);
}

function updateRolePreview(userId, currentRole, newRole) {
    const preview = document.getElementById(`role-preview-${userId}`);
    const select  = document.getElementById(`role-select-${userId}`);
    if (!preview) return;

    // שמור תפקיד מקורי
    if (select && !select.getAttribute('data-original-role')) {
        select.setAttribute('data-original-role', currentRole);
    }

    const origRole = select?.getAttribute('data-original-role') || currentRole;

    if (newRole === origRole) {
        preview.className = 'role-preview';
        preview.innerHTML = '';
        return;
    }

    const roleLabels = {
        'NOC':       { label: 'NOC',       cls: 'role-NOC'       },
        'Dashboard': { label: 'Dashboard', cls: 'role-Dashboard'  }
    };

    const newRoleInfo = roleLabels[newRole];
    if (!newRoleInfo) return;

    preview.className = 'role-preview has-change';
    preview.innerHTML = `
        <i class="fas fa-arrow-left preview-arrow"></i>
        <span class="preview-new-role ${newRoleInfo.cls}">
            ${newRoleInfo.label}
        </span>
        <span style="color:rgba(255,255,255,0.25)">יישמר לאחר אישור</span>
    `;
}

// ─────────────────────────────────────────
//  BACK DROPDOWN
// ─────────────────────────────────────────
function toggleBackDropdown() {
    const menu    = document.getElementById('backDropdownMenu');
    const chevron = document.getElementById('backChevron');
    const isOpen  = menu.classList.contains('open');

    if (isOpen) {
        menu.classList.remove('open');
        chevron.classList.remove('open');
    } else {
        menu.classList.add('open');
        chevron.classList.add('open');
    }
}

// סגירת הדרופדאון בלחיצה מחוץ לו
document.addEventListener('click', e => {
    const wrapper = document.querySelector('.back-dropdown-wrapper');
    if (wrapper && !wrapper.contains(e.target)) {
        document.getElementById('backDropdownMenu')
            ?.classList.remove('open');
        document.getElementById('backChevron')
            ?.classList.remove('open');
    }
});

// ─────────────────────────────────────────
//  PERMISSIONS MODAL
// ─────────────────────────────────────────

// נתוני הרשאות לכל משתמש (מגיע מה-Razor)
const userPermissions = {
    @if (allUsers != null)
    {
        foreach (var u in allUsers)
        {
            @:  '@u.Id': @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            u.AllowedDashboards ?? new List<string>())),
        }
    }
};

function openPermissionsModal(userId, displayName) {
    const modal       = document.getElementById('permissionsModal');
    const userInfo    = document.getElementById('modalUserInfo');
    const userIdInput = document.getElementById('permissionsUserId');

    userInfo.innerHTML = `
        <i class="fas fa-user"></i>
        <strong>${displayName}</strong>
    `;

    userIdInput.value = userId;

    // קבל הרשאות נוכחיות
    const currentPerms = userPermissions[userId] || [];

    document.querySelectorAll('.perm-checkbox').forEach(cb => {
        const card      = cb.closest('.permission-card');
        const isChecked = currentPerms.includes(cb.value);

        cb.checked = isChecked;

        if (isChecked) {
            card.classList.add('checked');
        } else {
            card.classList.remove('checked');
        }
    });

    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
}

function closePermissionsModal() {
    const modal = document.getElementById('permissionsModal');
    modal.style.display = 'none';
    document.body.style.overflow = '';
}

// Toggle permission cards
document.querySelectorAll('.permission-card').forEach(card => {
    card.addEventListener('click', () => {
        const cb = card.querySelector('.perm-checkbox');
        cb.checked = !cb.checked;
        card.classList.toggle('checked', cb.checked);
    });
});

// ─────────────────────────────────────────
//  RESET PASSWORD MODAL
// ─────────────────────────────────────────

function openResetPasswordModal(userId, displayName, username) {
    const modal       = document.getElementById('resetPasswordModal');
    const userInfo    = document.getElementById('resetModalUserInfo');
    const userIdInput = document.getElementById('resetPasswordUserId');

    // מלא פרטי משתמש
    userInfo.innerHTML = `
        <i class="fas fa-user"></i>
        <strong>${displayName}</strong>
        <span style="color:rgba(255,255,255,0.4); font-size:0.85rem">
            (${username})
        </span>
    `;

    userIdInput.value = userId;

    // נקה שדות
    document.getElementById('resetNewPassword').value     = '';
    document.getElementById('resetConfirmPassword').value = '';
    document.getElementById('resetErrorMsg').style.display = 'none';

    // הסתר אינדיקטור חוזק
    document.getElementById('passwordStrengthWrapper').style.display = 'none';

    modal.style.display  = 'flex';
    document.body.style.overflow = 'hidden';

    // פוקוס על שדה הסיסמה
    setTimeout(() => {
        document.getElementById('resetNewPassword').focus();
    }, 100);
}

function closeResetPasswordModal() {
    hideResetLoader();
    
    const modal = document.getElementById('resetPasswordModal');
    modal.style.display = 'none';
    document.body.style.overflow = '';

    document.getElementById('resetNewPassword').value = '';
    document.getElementById('resetConfirmPassword').value = '';
    document.getElementById('resetErrorMsg').style.display = 'none';
    document.getElementById('passwordStrengthWrapper').style.display = 'none';
}

// ולידציה לפני שליחת הטופס
function validateResetForm() {
    const newPass     = document.getElementById('resetNewPassword').value;
    const confirmPass = document.getElementById('resetConfirmPassword').value;
    const errorMsg    = document.getElementById('resetErrorMsg');
    const errorText   = document.getElementById('resetErrorText');

    // בדיקת אורך מינימלי
    if (newPass.length < 6) {
        errorText.textContent  = 'הסיסמה חייבת להכיל לפחות 6 תווים';
        errorMsg.style.display = 'flex';
        return false;
    }

    // בדיקת התאמה
    if (newPass !== confirmPass) {
        errorText.textContent  = 'הסיסמאות אינן תואמות';
        errorMsg.style.display = 'flex';
        return false;
    }

    errorMsg.style.display = 'none';
    return true;
}

function handleResetFormSubmit() {
    const isValid = validateResetForm();

    if (isValid) {
        showResetLoader(); // ← מציג loader רק אם הולידציה עברה
    }

    return isValid; // ← אם false, הטופס לא נשלח (כמו קודם)
}


function showResetLoader() {
    const loader = document.getElementById('resetPasswordLoader');
    const form   = document.getElementById('resetPasswordForm');
    
    if (loader) loader.style.display = 'flex';
    
    // מנטרל את כפתורי הטופס למניעת לחיצה כפולה
    form.querySelectorAll('button').forEach(btn => {
        btn.disabled = true;
    });
}

// הסתר loader (לשימוש בסגירת המודל)
function hideResetLoader() {
    const loader = document.getElementById('resetPasswordLoader');
    const form   = document.getElementById('resetPasswordForm');
    
    if (loader) loader.style.display = 'none';
    
    form.querySelectorAll('button').forEach(btn => {
        btn.disabled = false;
    });
}

// הצגת/הסתרת סיסמה
function togglePasswordVisibility(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon  = document.getElementById(iconId);

    if (input.type === 'password') {
        input.type      = 'text';
        icon.className  = 'fas fa-eye-slash';
    } else {
        input.type      = 'password';
        icon.className  = 'fas fa-eye';
    }
}

// אינדיקטור חוזק סיסמה
document.getElementById('resetNewPassword')
    .addEventListener('input', function () {
        const val     = this.value;
        const wrapper = document.getElementById('passwordStrengthWrapper');
        const fill    = document.getElementById('passwordStrengthFill');
        const text    = document.getElementById('passwordStrengthText');

        if (val.length === 0) {
            wrapper.style.display = 'none';
            return;
        }

        wrapper.style.display = 'block';

        // חישוב חוזק
        let strength = 0;
        if (val.length >= 6)                        strength++;
        if (val.length >= 10)                       strength++;
        if (/[A-Z]/.test(val))                      strength++;
        if (/[0-9]/.test(val))                      strength++;
        if (/[^A-Za-z0-9]/.test(val))               strength++;

        const levels = [
            { label: 'חלשה מאוד', color: '#e74c3c', width: '20%'  },
            { label: 'חלשה',      color: '#e67e22', width: '40%'  },
            { label: 'בינונית',   color: '#f0a500', width: '60%'  },
            { label: 'חזקה',      color: '#2ecc71', width: '80%'  },
            { label: 'חזקה מאוד', color: '#27ae60', width: '100%' }
        ];

        const level       = levels[Math.min(strength - 1, 4)] || levels[0];
        fill.style.width  = level.width;
        fill.style.background = level.color;
        text.textContent  = level.label;
        text.style.color  = level.color;
    });

    // ─────────────────────────────────────────
    //  EDIT USER MODAL
    // ─────────────────────────────────────────

    // ערכים מקוריים לזיהוי שינויים
    let _editOriginalValues = {};

    function openEditUserModal(userId, displayName, username, email) {
        const modal     = document.getElementById('editUserModal');
        const userInfo  = document.getElementById('editModalUserInfo');
        const userIdBox = document.getElementById('editUserId');

        // מלא פרטי משתמש בכותרת
        userInfo.innerHTML = `
            <i class="fas fa-user"></i>
            <strong>${displayName}</strong>
            <span style="color:rgba(255,255,255,0.4); font-size:0.85rem">
                (${username})
            </span>
        `;

        // שמור ערכים מקוריים
        _editOriginalValues = {
            displayName: displayName,
            username:    username,
            email:       email || ''
        };

        // מלא שדות
        userIdBox.value = userId;
        document.getElementById('editDisplayName').value = displayName;
        document.getElementById('editUsername').value    = username;
        document.getElementById('editEmail').value       = email || '';

        // נקה סטייט
        document.getElementById('editErrorMsg').style.display = 'none';
        resetEditChangesUI();

        // הצג מודאל
        modal.style.display          = 'flex';
        document.body.style.overflow = 'hidden';

        // פוקוס
        setTimeout(() => {
            document.getElementById('editDisplayName').focus();
        }, 100);
    }

    function closeEditUserModal() {
        const modal = document.getElementById('editUserModal');

        hideEditLoader();
        modal.style.display          = 'none';
        document.body.style.overflow = '';

        // נקה שדות
        ['editDisplayName', 'editUsername', 'editEmail'].forEach(id => {
            const el = document.getElementById(id);
            if (el) {
                el.value = '';
                el.classList.remove('changed');
            }
        });

        document.getElementById('editErrorMsg').style.display = 'none';
        resetEditChangesUI();
        _editOriginalValues = {};
    }

    // ── מעקב שינויים ──
    function trackEditChange(input, fieldKey) {
        const original = _editOriginalValues[fieldKey] || '';
        const current  = input.value;

        // סמן שדה שהשתנה
        input.classList.toggle('changed',
            current.trim() !== original.trim()
        );

        updateEditChangesSummary();
    }

    function updateEditChangesSummary() {
        const summary     = document.getElementById('editChangesSummary');
        const summaryText = document.getElementById('editChangesSummaryText');

        const fields = [
            {
                id:    'editDisplayName',
                key:   'displayName',
                label: 'שם תצוגה'
            },
            {
                id:    'editUsername',
                key:   'username',
                label: 'שם משתמש'
            },
            {
                id:    'editEmail',
                key:   'email',
                label: 'מייל'
            }
        ];

        const changed = fields.filter(f => {
            const el = document.getElementById(f.id);
            return el && el.value.trim() !== (_editOriginalValues[f.key] || '').trim();
        });

        if (changed.length === 0) {
            summary.classList.remove('has-changes');
            summaryText.textContent = 'לא בוצעו שינויים עדיין';
        } else {
            summary.classList.add('has-changes');
            const labels = changed.map(f => f.label).join(', ');
            summaryText.textContent =
                `${changed.length} שינוי${changed.length > 1 ? 'ם' : ''}: ${labels}`;
        }
    }

    function resetEditChangesUI() {
        const summary     = document.getElementById('editChangesSummary');
        const summaryText = document.getElementById('editChangesSummaryText');

        if (summary) {
            summary.classList.remove('has-changes');
        }
        if (summaryText) {
            summaryText.textContent = 'לא בוצעו שינויים עדיין';
        }
    }

    // ── ולידציה ──
    function validateEditForm() {
        const displayName = document.getElementById('editDisplayName').value.trim();
        const username    = document.getElementById('editUsername').value.trim();
        const email       = document.getElementById('editEmail').value.trim();
        const errorMsg    = document.getElementById('editErrorMsg');
        const errorText   = document.getElementById('editErrorText');

        const showError = (msg) => {
            errorText.textContent  = msg;
            errorMsg.style.display = 'flex';
            return false;
        };

        // שם תצוגה
        if (displayName.length < 2) {
            return showError('שם תצוגה חייב להכיל לפחות 2 תווים');
        }

        // שם משתמש
        if (username.length < 3) {
            return showError('שם משתמש חייב להכיל לפחות 3 תווים');
        }

        if (!/^[a-zA-Z0-9._-]+$/.test(username)) {
            return showError(
                'שם משתמש יכול להכיל רק אותיות באנגלית, מספרים ו- . _ -'
            );
        }

        // מייל (אופציונלי)
        if (email && !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) {
            return showError('כתובת מייל לא תקינה');
        }

        errorMsg.style.display = 'none';
        return true;
    }

    // ── שליחת טופס ──
    function handleEditFormSubmit() {
        if (!validateEditForm()) return false;

        showEditLoader();
        return true;
    }

    // ── Loader ──
    function showEditLoader() {
        const loader = document.getElementById('editUserLoader');
        const form   = document.getElementById('editUserForm');

        if (loader) loader.style.display = 'flex';

        form.querySelectorAll('button').forEach(btn => {
            btn.disabled = true;
        });
    }

    function hideEditLoader() {
        const loader = document.getElementById('editUserLoader');
        const form   = document.getElementById('editUserForm');

        if (loader) loader.style.display = 'none';

        if (form) {
            form.querySelectorAll('button').forEach(btn => {
                btn.disabled = false;
            });
        }
    }

    // ─────────────────────────────────────────
    //  REJECT USER MODAL
    // ─────────────────────────────────────────

    function openRejectModal(userId, username, displayName, email) {
        const modal     = document.getElementById('rejectUserModal');
        const userInfo  = document.getElementById('rejectModalUserInfo');
        const userIdBox = document.getElementById('rejectUserId');

        // מלא פרטי משתמש
        userInfo.innerHTML = `
            <i class="fas fa-user"></i>
            <strong>${displayName}</strong>
            <span style="color:rgba(255,255,255,0.4); font-size:0.85rem">
                (${username})
            </span>
        `;

        userIdBox.value = userId;

        // טיפול בסטייט המייל
        const emailSection   = document.getElementById('rejectEmailSection');
        const noEmailSection = document.getElementById('rejectNoEmailSection');
        const emailPreview   = document.getElementById('rejectEmailPreview');
        const emailCheck     = document.getElementById('sendRejectionEmailCheck');
        const emailIcon      = document.getElementById('rejectEmailIcon');

        if (email && email.trim() !== '') {
            // יש מייל - הצג אפשרות
            emailSection.style.display   = 'block';
            noEmailSection.style.display = 'none';

            emailPreview.textContent = email;

            // ברירת מחדל: מסומן לשליחה
            emailCheck.checked = true;
            emailIcon.style.color = '#4a9eff';
        } else {
            // אין מייל - הסתר אפשרות
            emailSection.style.display   = 'none';
            noEmailSection.style.display = 'block';
            emailCheck.checked = false;
        }

        modal.style.display          = 'flex';
        document.body.style.overflow = 'hidden';
    }

    function closeRejectModal() {
        const modal = document.getElementById('rejectUserModal');
        modal.style.display          = 'none';
        document.body.style.overflow = '';

        // נקה
        document.getElementById('rejectUserId').value = '';
        document.getElementById('sendRejectionEmailCheck').checked = false;
    }
</script>
</body>
</html>