@model NocPortal.Models.ForgotPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "שכחתי סיסמה";
}
<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon"
          href="https://www.menoramivt.co.il/customers-homepage/static/img/favicon.ico">
    <link rel="stylesheet" href="https://cdn.menoramivt.co.il/public/fonts/fonts.css">
    <link rel="stylesheet" href="/fontawesome/css/all.min.css">
    <link rel="stylesheet" href="~/css/noc-portal.css">
    <style>
        body {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Rubik', sans-serif;
        }

        .card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 40px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
        }

        /* ── לוגו ── */
        .logo {
            text-align: center;
            margin-bottom: 28px;
        }

        .logo img {
            height: 46px;
            filter: brightness(0) invert(1);
        }

        /* ── כותרת ── */
        .page-title {
            color: #fff;
            font-size: 1.4rem;
            font-weight: 700;
            text-align: center;
            margin-bottom: 8px;
        }

        .page-subtitle {
            color: rgba(255,255,255,0.45);
            font-size: 0.88rem;
            text-align: center;
            margin-bottom: 28px;
            line-height: 1.6;
        }

        /* ── אייקון גדול ── */
        .icon-circle {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: rgba(74, 158, 255, 0.15);
            border: 2px solid rgba(74, 158, 255, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
            font-size: 1.6rem;
            color: #4a9eff;
        }

        /* ── שדות ── */
        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            color: rgba(255,255,255,0.8);
            font-size: 0.9rem;
            margin-bottom: 8px;
            font-weight: 500;
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper i.field-icon {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(255,255,255,0.4);
            font-size: 0.9rem;
            pointer-events: none;
        }

        .form-group input {
            width: 100%;
            padding: 12px 40px 12px 16px;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 8px;
            color: #fff;
            font-size: 0.95rem;
            font-family: inherit;
            transition: border-color 0.2s, background 0.2s;
            box-sizing: border-box;
        }

        .form-group input:focus {
            outline: none;
            border-color: #4a9eff;
            background: rgba(255,255,255,0.12);
        }

        .form-group input::placeholder {
            color: rgba(255,255,255,0.3);
        }

        /* ── כפתור ראשי ── */
        .btn-primary {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #4a9eff, #0066cc);
            border: none;
            border-radius: 8px;
            color: #fff;
            font-size: 1rem;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: opacity 0.2s, transform 0.1s;
            margin-top: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-primary:hover   { opacity: 0.9; }
        .btn-primary:active  { transform: scale(0.98); }
        .btn-primary:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        /* ── הודעות ── */
        .alert {
            border-radius: 8px;
            padding: 14px 16px;
            font-size: 0.9rem;
            margin-bottom: 20px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            line-height: 1.5;
        }

        .alert-error {
            background: rgba(220, 53, 69, 0.15);
            border: 1px solid rgba(220, 53, 69, 0.35);
            color: #ff6b7a;
        }

        .alert-success {
            background: rgba(40, 167, 69, 0.15);
            border: 1px solid rgba(40, 167, 69, 0.35);
            color: #5dd879;
        }

        .alert i { margin-top: 2px; flex-shrink: 0; }

        /* ── כפתור חזרה ── */
        .back-link {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            margin-top: 22px;
            color: rgba(255,255,255,0.45);
            font-size: 0.88rem;
            text-decoration: none;
            transition: color 0.2s;
        }

        .back-link:hover { color: #4a9eff; }

        /* ── הסבר תחתי ── */
        .help-text {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 8px;
            padding: 14px 16px;
            margin-top: 20px;
            font-size: 0.82rem;
            color: rgba(255,255,255,0.4);
            line-height: 1.6;
        }

        .help-text i {
            color: rgba(74,158,255,0.6);
            margin-left: 4px;
        }

        /* ── מצב הצלחה (אחרי שליחה) ── */
        .success-state {
            text-align: center;
        }

        .success-state .icon-circle-success {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: rgba(40, 167, 69, 0.15);
            border: 2px solid rgba(40, 167, 69, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            font-size: 1.8rem;
            color: #5dd879;
        }

        .success-state h2 {
            color: #fff;
            font-size: 1.2rem;
            margin-bottom: 10px;
        }

        .success-state p {
            color: rgba(255,255,255,0.55);
            font-size: 0.9rem;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .btn-outline {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 11px 24px;
            background: transparent;
            border: 1px solid rgba(74,158,255,0.4);
            border-radius: 8px;
            color: #4a9eff;
            font-size: 0.9rem;
            font-family: inherit;
            font-weight: 500;
            cursor: pointer;
            text-decoration: none;
            transition: background 0.2s, border-color 0.2s;
        }

        .btn-outline:hover {
            background: rgba(74,158,255,0.1);
            border-color: #4a9eff;
        }
    </style>
</head>
<body>
    <div class="card">

        <!-- לוגו -->
        <div class="logo">
            <img src="https://cdn.menoramivt.co.il/public/images/20260113/3ggtc2mkccjb39-menora-logo-ido.png"
                 alt="מנורה מבטחים">
        </div>

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <!-- ══ מצב הצלחה ══ -->
            <div class="success-state">
                <div class="icon-circle-success">
                    <i class="fas fa-envelope-open-text"></i>
                </div>
                <h2>המייל נשלח!</h2>
                <p>@Model.SuccessMessage</p>
                <p style="font-size:0.82rem; color:rgba(255,255,255,0.35);">
                    לא קיבלת מייל? בדוק את תיקיית הספאם,
                    או פנה למנהל המערכת.
                </p>

                <!-- כפתור מעבר לאיפוס עם קוד -->
                <a asp-action="ResetPassword" asp-controller="Auth"
                   class="btn-outline" style="margin-bottom:12px; width:100%;
                   justify-content:center; box-sizing:border-box;">
                    <i class="fas fa-key"></i>
                    יש לי קוד - אפס סיסמה
                </a>

                <a asp-action="Login" asp-controller="Auth" class="back-link">
                    <i class="fas fa-arrow-right"></i>
                    חזרה לכניסה
                </a>
            </div>
        }
        else
        {
            <!-- ══ טופס בקשת איפוס ══ -->
            <div class="icon-circle">
                <i class="fas fa-unlock-alt"></i>
            </div>

            <h1 class="page-title">שכחתי סיסמה</h1>
            <p class="page-subtitle">
                הכנס את שם המשתמש שלך ונשלח אליך<br>
                קוד לאיפוס הסיסמה במייל
            </p>

            <!-- הודעת שגיאה -->
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-error">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            <!-- טופס -->
            <form method="post"
                  asp-action="ForgotPassword"
                  asp-controller="Auth"
                  id="forgotForm">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label for="username">שם משתמש</label>
                    <div class="input-wrapper">
                        <i class="fas fa-user field-icon"></i>
                        <input type="text"
                               id="username"
                               name="Username"
                               placeholder="הכנס שם משתמש"
                               value="@Model.Username"
                               autocomplete="username"
                               autofocus
                               required />
                    </div>
                </div>

                <button type="submit" class="btn-primary" id="submitBtn">
                    <i class="fas fa-paper-plane" id="submitIcon"></i>
                    <span id="submitText">שלח קוד לאיפוס</span>
                </button>
            </form>

            <!-- הסבר -->
            <div class="help-text">
                <i class="fas fa-info-circle"></i>
                הקוד יישלח לכתובת המייל הרשומה בחשבונך
                ויהיה תקף למשך <strong style="color:rgba(255,255,255,0.6)">
                30 דקות</strong> בלבד.
            </div>

            <!-- חזרה לכניסה -->
            <a asp-action="Login" asp-controller="Auth" class="back-link">
                <i class="fas fa-arrow-right"></i>
                חזרה לכניסה למערכת
            </a>
        }

    </div>

    <script>
        // Loading state בעת שליחה
        const form = document.getElementById('forgotForm');
        if (form) {
            form.addEventListener('submit', function () {
                const btn  = document.getElementById('submitBtn');
                const icon = document.getElementById('submitIcon');
                const text = document.getElementById('submitText');

                btn.disabled     = true;
                icon.className   = 'fas fa-spinner fa-spin';
                text.textContent = 'שולח...';
            });
        }
    </script>
</body>
</html>