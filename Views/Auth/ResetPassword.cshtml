@model NocPortal.Models.ResetPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "איפוס סיסמה";
}
<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon"
          href="https://www.menoramivt.co.il/customers-homepage/static/img/favicon.ico">
    <link rel="stylesheet" href="https://cdn.menoramivt.co.il/public/fonts/fonts.css">
    <link rel="stylesheet" href="/fontawesome/css/all.min.css">
    <link rel="stylesheet" href="~/css/noc-portal.css">
    <style>
        body {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Rubik', sans-serif;
        }

        .card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 40px;
            width: 100%;
            max-width: 440px;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
        }

        .logo {
            text-align: center;
            margin-bottom: 28px;
        }

        .logo img {
            height: 46px;
            filter: brightness(0) invert(1);
        }

        .icon-circle {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: rgba(74, 158, 255, 0.15);
            border: 2px solid rgba(74, 158, 255, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 22px;
            font-size: 1.6rem;
            color: #4a9eff;
        }

        .page-title {
            color: #fff;
            font-size: 1.4rem;
            font-weight: 700;
            text-align: center;
            margin-bottom: 8px;
        }

        .page-subtitle {
            color: rgba(255,255,255,0.45);
            font-size: 0.88rem;
            text-align: center;
            margin-bottom: 28px;
            line-height: 1.6;
        }

        /* ── שדות ── */
        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            color: rgba(255,255,255,0.8);
            font-size: 0.88rem;
            margin-bottom: 7px;
            font-weight: 500;
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper i.field-icon {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(255,255,255,0.4);
            font-size: 0.88rem;
            pointer-events: none;
        }

        .toggle-btn {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: rgba(255,255,255,0.4);
            cursor: pointer;
            padding: 0;
            font-size: 0.88rem;
            transition: color 0.2s;
        }

        .toggle-btn:hover { color: rgba(255,255,255,0.8); }

        .form-group input {
            width: 100%;
            padding: 12px 40px 12px 40px;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 8px;
            color: #fff;
            font-size: 0.95rem;
            font-family: inherit;
            transition: border-color 0.2s, background 0.2s;
            box-sizing: border-box;
        }

        .form-group input:focus {
            outline: none;
            border-color: #4a9eff;
            background: rgba(255,255,255,0.12);
        }

        .form-group input::placeholder {
            color: rgba(255,255,255,0.3);
        }

        /* ── שדה קוד ── */
        .code-input {
            text-align: center;
            letter-spacing: 6px;
            font-size: 1.3rem !important;
            font-weight: 700 !important;
            padding: 14px 16px !important;
        }

        /* ── חוזק סיסמה ── */
        .strength-bar {
            height: 4px;
            border-radius: 2px;
            background: rgba(255,255,255,0.1);
            margin-top: 8px;
            overflow: hidden;
        }

        .strength-fill {
            height: 100%;
            border-radius: 2px;
            transition: width 0.3s, background 0.3s;
            width: 0%;
        }

        .strength-text {
            font-size: 0.78rem;
            margin-top: 5px;
            color: rgba(255,255,255,0.4);
        }

        /* ── כפתור ראשי ── */
        .btn-primary {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #4a9eff, #0066cc);
            border: none;
            border-radius: 8px;
            color: #fff;
            font-size: 1rem;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: opacity 0.2s, transform 0.1s;
            margin-top: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-primary:hover    { opacity: 0.9; }
        .btn-primary:active   { transform: scale(0.98); }
        .btn-primary:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        /* ── הודעות ── */
        .alert {
            border-radius: 8px;
            padding: 13px 16px;
            font-size: 0.88rem;
            margin-bottom: 18px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            line-height: 1.5;
        }

        .alert-error {
            background: rgba(220, 53, 69, 0.15);
            border: 1px solid rgba(220, 53, 69, 0.35);
            color: #ff6b7a;
        }

        .alert-success {
            background: rgba(40, 167, 69, 0.15);
            border: 1px solid rgba(40, 167, 69, 0.35);
            color: #5dd879;
        }

        .alert i { margin-top: 2px; flex-shrink: 0; }

        /* ── מצב הצלחה ── */
        .success-state {
            text-align: center;
        }

        .icon-circle-success {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: rgba(40, 167, 69, 0.15);
            border: 2px solid rgba(40, 167, 69, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            font-size: 1.8rem;
            color: #5dd879;
        }

        .success-state h2 {
            color: #fff;
            font-size: 1.2rem;
            margin-bottom: 10px;
        }

        .success-state p {
            color: rgba(255,255,255,0.5);
            font-size: 0.9rem;
            line-height: 1.6;
            margin-bottom: 22px;
        }

        /* ── כפתור כניסה ── */
        .btn-login-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #4a9eff, #0066cc);
            border: none;
            border-radius: 8px;
            color: #fff;
            font-size: 1rem;
            font-weight: 600;
            font-family: inherit;
            text-decoration: none;
            box-sizing: border-box;
            transition: opacity 0.2s;
        }

        .btn-login-link:hover { opacity: 0.9; }

        /* ── קישור חזרה ── */
        .back-link {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            margin-top: 20px;
            color: rgba(255,255,255,0.4);
            font-size: 0.85rem;
            text-decoration: none;
            transition: color 0.2s;
        }

        .back-link:hover { color: #4a9eff; }

        /* ── מפריד ── */
        .divider {
            height: 1px;
            background: rgba(255,255,255,0.08);
            margin: 20px 0;
        }

        /* ── טיפ ── */
        .tip-box {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 8px;
            padding: 12px 14px;
            font-size: 0.8rem;
            color: rgba(255,255,255,0.38);
            line-height: 1.6;
            margin-top: 16px;
        }

        .tip-box i { color: rgba(74,158,255,0.5); }
    </style>
</head>
<body>
    <div class="card">

        <!-- לוגו -->
        <div class="logo">
            <img src="https://cdn.menoramivt.co.il/public/images/20260113/3ggtc2mkccjb39-menora-logo-ido.png"
                 alt="מנורה מבטחים">
        </div>

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <!-- ══ מצב הצלחה ══ -->
            <div class="success-state">
                <div class="icon-circle-success">
                    <i class="fas fa-check"></i>
                </div>
                <h2>הסיסמה אופסה בהצלחה!</h2>
                <p>
                    @Model.SuccessMessage<br>
                    <span style="font-size:0.82rem;
                          color:rgba(255,255,255,0.3);">
                        נשלח אליך מייל אישור.
                    </span>
                </p>
                <a asp-action="Login" asp-controller="Auth"
                   class="btn-login-link">
                    <i class="fas fa-sign-in-alt"></i>
                    כניסה למערכת
                </a>
            </div>
        }
        else
        {
            <!-- ══ טופס איפוס ══ -->
            <div class="icon-circle">
                <i class="fas fa-key"></i>
            </div>

            <h1 class="page-title">איפוס סיסמה</h1>
            <p class="page-subtitle">
                הכנס את הקוד שקיבלת במייל<br>
                ובחר סיסמה חדשה
            </p>

            <!-- שגיאה -->
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-error">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            <form method="post"
                  asp-action="ResetPassword"
                  asp-controller="Auth"
                  id="resetForm">
                @Html.AntiForgeryToken()

                <!-- שם משתמש -->
                <div class="form-group">
                    <label for="username">שם משתמש</label>
                    <div class="input-wrapper">
                        <i class="fas fa-user field-icon"></i>
                        <input type="text"
                               id="username"
                               name="Username"
                               placeholder="הכנס שם משתמש"
                               value="@Model.Username"
                               autocomplete="username"
                               required />
                    </div>
                </div>

                <!-- קוד איפוס -->
                <div class="form-group">
                    <label for="token">קוד איפוס (6 ספרות)</label>
                    <div class="input-wrapper">
                        <input type="text"
                               id="token"
                               name="Token"
                               placeholder="000000"
                               value="@Model.Token"
                               maxlength="6"
                               inputmode="numeric"
                               pattern="[0-9]{6}"
                               class="code-input"
                               autocomplete="one-time-code"
                               required />
                    </div>
                </div>

                <div class="divider"></div>

                <!-- סיסמה חדשה -->
                <div class="form-group">
                    <label for="newPassword">סיסמה חדשה</label>
                    <div class="input-wrapper">
                        <i class="fas fa-lock field-icon"></i>
                        <input type="password"
                               id="newPassword"
                               name="NewPassword"
                               placeholder="לפחות 6 תווים"
                               autocomplete="new-password"
                               required />
                        <button type="button"
                                class="toggle-btn"
                                onclick="togglePass('newPassword','icon1')"
                                tabindex="-1">
                            <i class="fas fa-eye" id="icon1"></i>
                        </button>
                    </div>
                    <!-- חוזק סיסמה -->
                    <div class="strength-bar">
                        <div class="strength-fill" id="strengthFill"></div>
                    </div>
                    <div class="strength-text" id="strengthText"></div>
                </div>

                <!-- אימות סיסמה -->
                <div class="form-group">
                    <label for="confirmPassword">אימות סיסמה חדשה</label>
                    <div class="input-wrapper">
                        <i class="fas fa-lock field-icon"></i>
                        <input type="password"
                               id="confirmPassword"
                               name="ConfirmPassword"
                               placeholder="הכנס שוב את הסיסמה החדשה"
                               autocomplete="new-password"
                               required />
                        <button type="button"
                                class="toggle-btn"
                                onclick="togglePass('confirmPassword','icon2')"
                                tabindex="-1">
                            <i class="fas fa-eye" id="icon2"></i>
                        </button>
                    </div>
                    <!-- אינדיקטור התאמה -->
                    <div class="strength-text" id="matchText"></div>
                </div>

                <button type="submit"
                        class="btn-primary"
                        id="submitBtn">
                    <i class="fas fa-shield-alt" id="submitIcon"></i>
                    <span id="submitText">אפס סיסמה</span>
                </button>
            </form>

            <div class="tip-box">
                <i class="fas fa-clock"></i>
                הקוד תקף ל-<strong style="color:rgba(255,255,255,0.55)">
                30 דקות</strong> בלבד.
                לא קיבלת קוד?
                <a asp-action="ForgotPassword" asp-controller="Auth"
                   style="color:#4a9eff; text-decoration:none;">
                    שלח שוב
                </a>
            </div>

            <a asp-action="Login" asp-controller="Auth" class="back-link">
                <i class="fas fa-arrow-right"></i>
                חזרה לכניסה
            </a>
        }

    </div>

    <script>
        // ── Toggle הצגת סיסמה ─────────────────────────────────────────
        function togglePass(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon  = document.getElementById(iconId);
            const show  = input.type === 'password';
            input.type  = show ? 'text' : 'password';
            icon.className = show ? 'fas fa-eye-slash' : 'fas fa-eye';
        }

        // ── חוזק סיסמה ───────────────────────────────────────────────
        document.getElementById('newPassword')
            ?.addEventListener('input', function () {
                const val    = this.value;
                const fill   = document.getElementById('strengthFill');
                const text   = document.getElementById('strengthText');
                let score    = 0;

                if (val.length >= 6)  score++;
                if (val.length >= 10) score++;
                if (/[A-Z]/.test(val)) score++;
                if (/[0-9]/.test(val)) score++;
                if (/[^A-Za-z0-9]/.test(val)) score++;

                const levels = [
                    { w: '0%',   c: 'transparent', t: '' },
                    { w: '25%',  c: '#dc3545',      t: 'חלשה מאוד' },
                    { w: '50%',  c: '#fd7e14',      t: 'חלשה' },
                    { w: '70%',  c: '#ffc107',      t: 'בינונית' },
                    { w: '85%',  c: '#20c997',      t: 'חזקה' },
                    { w: '100%', c: '#28a745',      t: 'חזקה מאוד' },
                ];

                const lvl        = levels[Math.min(score, 5)];
                fill.style.width      = val.length ? lvl.w : '0%';
                fill.style.background = lvl.c;
                text.textContent      = val.length ? `חוזק סיסמה: ${lvl.t}` : '';
                text.style.color      = lvl.c;

                checkMatch();
            });

        // ── בדיקת התאמת סיסמאות ──────────────────────────────────────
        document.getElementById('confirmPassword')
            ?.addEventListener('input', checkMatch);

        function checkMatch() {
            const p1   = document.getElementById('newPassword')?.value     ?? '';
            const p2   = document.getElementById('confirmPassword')?.value ?? '';
            const text = document.getElementById('matchText');
            if (!text) return;

            if (!p2) {
                text.textContent = '';
                return;
            }

            if (p1 === p2) {
                text.textContent  = '✓ הסיסמאות תואמות';
                text.style.color  = '#5dd879';
            } else {
                text.textContent  = '✗ הסיסמאות אינן תואמות';
                text.style.color  = '#ff6b7a';
            }
        }

        // ── קוד ספרות בלבד ───────────────────────────────────────────
        document.getElementById('token')
            ?.addEventListener('input', function () {
                this.value = this.value.replace(/\D/g, '').slice(0, 6);
            });

        // ── Loading state ─────────────────────────────────────────────
        document.getElementById('resetForm')
            ?.addEventListener('submit', function (e) {
                const p1 = document.getElementById('newPassword').value;
                const p2 = document.getElementById('confirmPassword').value;

                if (p1 !== p2) {
                    e.preventDefault();
                    document.getElementById('matchText').textContent =
                        '✗ הסיסמאות אינן תואמות';
                    document.getElementById('matchText').style.color = '#ff6b7a';
                    return;
                }

                const btn  = document.getElementById('submitBtn');
                const icon = document.getElementById('submitIcon');
                const text = document.getElementById('submitText');

                btn.disabled     = true;
                icon.className   = 'fas fa-spinner fa-spin';
                text.textContent = 'מאפס...';
            });
    </script>
</body>
</html>