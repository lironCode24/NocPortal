@model NocPortal.Models.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "הרשמה למערכת";
}
<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon"
          href="https://www.menoramivt.co.il/customers-homepage/static/img/favicon.ico">
    <link rel="stylesheet" href="https://cdn.menoramivt.co.il/public/fonts/fonts.css">
    <link rel="stylesheet" href="/lib/font-awesome/css/all.min.css">
    <link rel="stylesheet" href="~/css/noc-portal.css">
    <style>
        body {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Rubik', sans-serif;
        }
        .register-container {
            background: rgba(255,255,255,0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 16px;
            padding: 40px;
            width: 100%;
            max-width: 460px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.5);
        }
        .logo-section { text-align: center; margin-bottom: 24px; }
        .logo-section img {
            height: 45px;
            filter: brightness(0) invert(1);
        }
        .register-title {
            color: #fff;
            font-size: 1.4rem;
            font-weight: 700;
            text-align: center;
            margin-bottom: 6px;
        }
        .register-subtitle {
            color: rgba(255,255,255,0.5);
            font-size: 0.85rem;
            text-align: center;
            margin-bottom: 28px;
        }
        .form-group { margin-bottom: 18px; }
        .form-group label {
            display: block;
            color: rgba(255,255,255,0.8);
            font-size: 0.88rem;
            margin-bottom: 7px;
            font-weight: 500;
        }
        .input-wrapper { position: relative; }
        .input-wrapper i.field-icon {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(255,255,255,0.4);
            font-size: 0.85rem;
            pointer-events: none;
        }
        .toggle-btn {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: rgba(255,255,255,0.4);
            cursor: pointer;
            padding: 0;
            font-size: 0.88rem;
            transition: color 0.2s;
        }
        .toggle-btn:hover { color: rgba(255,255,255,0.8); }

        .form-group input,
        .form-group select {
            width: 100%;
            padding: 12px 40px 12px 40px;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 8px;
            color: #fff;
            font-size: 0.92rem;
            font-family: inherit;
            transition: border-color 0.2s;
            box-sizing: border-box;
        }
        .form-group select option { background: #1a1a2e; color: #fff; }
        .form-group input:focus,
        .form-group select:focus {
            outline: none;
            border-color: #4a9eff;
            background: rgba(255,255,255,0.12);
        }
        .form-group input::placeholder { color: rgba(255,255,255,0.3); }

        .strength-bar {
            height: 4px;
            border-radius: 2px;
            background: rgba(255,255,255,0.1);
            margin-top: 8px;
            overflow: hidden;
        }
        .strength-fill {
            height: 100%;
            border-radius: 2px;
            transition: width 0.3s, background 0.3s;
            width: 0%;
        }
        .strength-text {
            font-size: 0.78rem;
            margin-top: 5px;
            color: rgba(255,255,255,0.4);
        }

        /*  תיבת חוקי סיסמה */
        .password-rules {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 8px;
            padding: 10px 14px;
            margin-top: 10px;
        }

        .rule {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.35);
            padding: 3px 0;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: color 0.2s;
        }

        .rule-icon {
            font-size: 0.45rem;  /* נקודה קטנה כברירת מחדל */
            transition: all 0.2s;
            flex-shrink: 0;
        }

        .rule.passed {
            color: #5dd879;
        }

        .rule.passed .rule-icon {
            font-size: 0.8rem;  /* גדל כשעובר */
        }

        /*  כלל שנכשל בזמן הקלדה - אדום */
        .rule.failed {
            color: #ff6b7a;
        }

        .btn-register {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #28a745, #1e7e34);
            border: none;
            border-radius: 8px;
            color: #fff;
            font-size: 1rem;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: opacity 0.2s;
            margin-top: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        .btn-register:hover { opacity: 0.9; }
        .btn-register:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
        .alert {
            border-radius: 8px;
            padding: 12px 16px;
            font-size: 0.9rem;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .alert-danger {
            background: rgba(220,53,69,0.2);
            border: 1px solid rgba(220,53,69,0.4);
            color: #ff6b7a;
        }
        .alert-success {
            background: rgba(40,167,69,0.2);
            border: 1px solid rgba(40,167,69,0.4);
            color: #6fcf97;
        }
        .login-link {
            text-align: center;
            margin-top: 22px;
            color: rgba(255,255,255,0.5);
            font-size: 0.9rem;
        }
        .login-link a {
            color: #4a9eff;
            text-decoration: none;
            font-weight: 500;
        }
        .login-link a:hover { text-decoration: underline; }
    </style>
</head>
<body>
<div class="register-container">

    <div class="logo-section">
        <img src="https://cdn.menoramivt.co.il/public/images/20260113/3ggtc2mkccjb39-menora-logo-ido.png"
             alt="מנורה מבטחים">
    </div>

    <h1 class="register-title">הרשמה לפורטל NOC</h1>
    <p class="register-subtitle">לאחר ההרשמה, חשבונך יאושר על ידי מנהל המערכת</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-circle"></i>
            @Model.ErrorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i>
            @Model.SuccessMessage
        </div>
    }

    @if (string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <form method="post"
              asp-action="Register"
              asp-controller="Auth"
              id="registerForm">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="displayName">שם מלא</label>
                <div class="input-wrapper">
                    <i class="fas fa-id-card field-icon"></i>
                    <input type="text"
                           id="displayName"
                           name="DisplayName"
                           placeholder="הכנס שם מלא"
                           value="@Model.DisplayName"
                           required />
                </div>
            </div>

            <div class="form-group">
                <label for="username">שם משתמש</label>
                <div class="input-wrapper">
                    <i class="fas fa-user field-icon"></i>
                    <input type="text"
                           id="username"
                           name="Username"
                           placeholder="הכנס שם משתמש (באנגלית)"
                           value="@Model.Username"
                           autocomplete="username"
                           required />
                </div>
            </div>

            <div class="form-group">
                <label for="email">כתובת מייל</label>
                <div class="input-wrapper">
                    <i class="fas fa-envelope field-icon"></i>
                    <input type="email"
                           id="email"
                           name="Email"
                           placeholder="הכנס כתובת מייל"
                           value="@Model.Email"
                           autocomplete="email"
                           required />
                </div>
            </div>

            <div class="form-group">
                <label for="password">סיסמה</label>
                <div class="input-wrapper">
                    <i class="fas fa-lock field-icon"></i>
                    <input type="password"
                           id="password"
                           name="Password"
                           placeholder="הכנס סיסמה"
                           autocomplete="new-password"
                           required />
                    <button type="button"
                            class="toggle-btn"
                            onclick="togglePass('password','iconPass1')"
                            tabindex="-1">
                        <i class="fas fa-eye" id="iconPass1"></i>
                    </button>
                </div>
                <div class="strength-bar">
                    <div class="strength-fill" id="strengthFill"></div>
                </div>
                <div class="strength-text" id="strengthText"></div>
            </div>

            <div class="form-group">
                <label for="confirmPassword">אימות סיסמה</label>
                <div class="input-wrapper">
                    <i class="fas fa-lock field-icon"></i>
                    <input type="password"
                           id="confirmPassword"
                           name="ConfirmPassword"
                           placeholder="הכנס סיסמה שוב"
                           autocomplete="new-password"
                           required />
                    <button type="button"
                            class="toggle-btn"
                            onclick="togglePass('confirmPassword','iconPass2')"
                            tabindex="-1">
                        <i class="fas fa-eye" id="iconPass2"></i>
                    </button>
                </div>
                <div class="strength-text" id="matchText"></div>
                <div class="password-rules" id="passwordRules">
                    <div class="rule" id="rule-length">
                        <i class="fas fa-circle rule-icon"></i>
                        לפחות 6 תווים
                    </div>
                    <div class="rule" id="rule-upper">
                        <i class="fas fa-circle rule-icon"></i>
                        אות גדולה אחת לפחות (A-Z)
                    </div>
                    <div class="rule" id="rule-lower">
                        <i class="fas fa-circle rule-icon"></i>
                        אות קטנה אחת לפחות (a-z)
                    </div>
                    <div class="rule" id="rule-number">
                        <i class="fas fa-circle rule-icon"></i>
                        ספרה אחת לפחות (0-9)
                    </div>
                </div>
            </div>

            <button type="submit"
                    class="btn-register"
                    id="submitBtn">
                <i class="fas fa-user-plus" id="submitIcon"></i>
                <span id="submitText">שלח בקשת הרשמה</span>
            </button>
        </form>
    }

    <div class="login-link">
        כבר יש לך חשבון?
        <a asp-action="Login" asp-controller="Auth">כניסה למערכת</a>
    </div>

</div>

<script>
    // ── Toggle הצגת סיסמה ─────────────────────────────────────────
    function togglePass(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon  = document.getElementById(iconId);
        const show  = input.type === 'password';
        input.type     = show ? 'text' : 'password';
        icon.className = show ? 'fas fa-eye-slash' : 'fas fa-eye';
    }

    // ── חוזק סיסמה ───────────────────────────────────────────────
    document.getElementById('password')
        ?.addEventListener('input', function () {
            const val  = this.value;
            const fill = document.getElementById('strengthFill');
            const text = document.getElementById('strengthText');
            const rules = document.getElementById('passwordRules');

            //  הצג את תיבת החוקים ברגע שמתחילים להקליד
            rules.style.display = val.length ? 'block' : 'none';

            //  בדוק כל חוק בנפרד
            const checks = {
                'rule-length':  val.length >= 6,
                'rule-upper':   /[A-Z]/.test(val),
                'rule-lower':   /[a-z]/.test(val),
                'rule-number':  /[0-9]/.test(val),
            };

            Object.entries(checks).forEach(([id, passed]) => {
                const el   = document.getElementById(id);
                const icon = el.querySelector('.rule-icon');

                el.classList.toggle('passed', passed);
                el.classList.toggle('failed', !passed && val.length > 0);

                //  החלף אייקון: וי כשעובר, X כשנכשל, נקודה כשריק
                if (passed) {
                    icon.className = 'fas fa-check-circle rule-icon';
                } else if (val.length > 0) {
                    icon.className = 'fas fa-times-circle rule-icon';
                } else {
                    icon.className = 'fas fa-circle rule-icon';
                }
            });

            //  חישוב חוזק
            let score = 0;
            if (val.length >= 6)           score++;
            if (val.length >= 10)          score++;
            if (/[A-Z]/.test(val))         score++;
            if (/[a-z]/.test(val))         score++;
            if (/[0-9]/.test(val))         score++;
            if (/[^A-Za-z0-9]/.test(val))  score++;

            const levels = [
                { w: '0%',   c: 'transparent', t: '' },
                { w: '25%',  c: '#dc3545',      t: 'חלשה מאוד' },
                { w: '50%',  c: '#fd7e14',      t: 'חלשה' },
                { w: '70%',  c: '#ffc107',      t: 'בינונית' },
                { w: '85%',  c: '#20c997',      t: 'חזקה' },
                { w: '100%', c: '#28a745',      t: 'חזקה מאוד' },
            ];

            const lvl             = levels[Math.min(score, 5)];
            fill.style.width      = val.length ? lvl.w : '0%';
            fill.style.background = lvl.c;
            text.textContent      = val.length ? `חוזק סיסמה: ${lvl.t}` : '';
            text.style.color      = lvl.c;

            checkMatch();
        });

    // ── בדיקת התאמת סיסמאות ──────────────────────────────────────
    document.getElementById('confirmPassword')
        ?.addEventListener('input', checkMatch);

    function checkMatch() {
        const p1   = document.getElementById('password')?.value        ?? '';
        const p2   = document.getElementById('confirmPassword')?.value ?? '';
        const text = document.getElementById('matchText');
        if (!text) return;

        if (!p2) {
            text.textContent = '';
            return;
        }

        if (p1 === p2) {
            text.textContent = '✓ הסיסמאות תואמות';
            text.style.color = '#5dd879';
        } else {
            text.textContent = '✗ הסיסמאות אינן תואמות';
            text.style.color = '#ff6b7a';
        }
    }

    // ── מניעת שליחה + Loading state ──────────────────────────────
    document.getElementById('registerForm')
        ?.addEventListener('submit', function (e) {
            const p1 = document.getElementById('password').value;
            const p2 = document.getElementById('confirmPassword').value;

            //  בדיקת חוקי סיסמה
            const allRulesPassed =
                p1.length >= 6          &&
                /[A-Z]/.test(p1)        &&
                /[a-z]/.test(p1)        &&
                /[0-9]/.test(p1);

            if (!allRulesPassed) {
                e.preventDefault();
                // הצג את תיבת החוקים עם סימוני שגיאה
                document.getElementById('passwordRules').style.display = 'block';
                document.getElementById('password').dispatchEvent(new Event('input'));
                document.getElementById('password').focus();
                return;
            }

            // בדיקת התאמת סיסמאות
            if (p1 !== p2) {
                e.preventDefault();
                const text = document.getElementById('matchText');
                text.textContent = '✗ הסיסמאות אינן תואמות';
                text.style.color = '#ff6b7a';
                document.getElementById('confirmPassword').focus();
                return;
            }

            // Loading state
            const btn  = document.getElementById('submitBtn');
            const icon = document.getElementById('submitIcon');
            const span = document.getElementById('submitText');
            btn.disabled     = true;
            icon.className   = 'fas fa-spinner fa-spin';
            span.textContent = 'שולח...';
    });
</script>
</body>
</html>