@model NocPortal.Models.MessageStatsViewModel
@{
    Layout = null;
    var israelTz = TimeZoneInfo.FindSystemTimeZoneById(
        "Israel Standard Time");
    var pct = Model.TotalRecipients > 0
        ? (int)((double)Model.AcknowledgedCount
                / Model.TotalRecipients * 100)
        : 0;
}
<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="UTF-8"/>
    <title>סטטיסטיקת הודעה</title>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
    <link rel="icon" type="image/x-icon" href="https://www.menoramivt.co.il/customers-homepage/static/img/favicon.ico">
    <style>
        * { box-sizing:border-box; margin:0; padding:0; }
        body {
            background:#0d1117; color:#e6edf3;
            font-family:'Segoe UI',sans-serif; direction:rtl;
        }
        .page-header {
            background:#161b22; border-bottom:1px solid #30363d;
            padding:1rem 2rem; display:flex;
            align-items:center; justify-content:space-between;
        }
        .page-header h1 {
            font-size:1.2rem; color:#58a6ff;
            display:flex; align-items:center; gap:.5rem;
        }
        .content {
            max-width:900px; margin:2rem auto; padding:0 1.5rem;
        }
        .card {
            background:#161b22; border:1px solid #30363d;
            border-radius:12px; padding:1.5rem; margin-bottom:1.5rem;
        }
        .card-title {
            font-size:1rem; font-weight:600; color:#58a6ff;
            margin-bottom:1.2rem;
            display:flex; align-items:center; gap:.5rem;
        }
        /* ── Stats Grid ── */
        .stats-grid {
            display:grid; grid-template-columns:repeat(3,1fr);
            gap:1rem; margin-bottom:1.5rem;
        }
        .stat-box {
            background:#0d1117; border:1px solid #30363d;
            border-radius:10px; padding:1rem; text-align:center;
        }
        .stat-box .val {
            font-size:2rem; font-weight:700; line-height:1;
        }
        .stat-box .lbl {
            font-size:.8rem; color:rgba(255,255,255,.4);
            margin-top:.3rem;
        }
        .val-blue   { color:#58a6ff; }
        .val-green  { color:#3fb950; }
        .val-orange { color:#f0a500; }

        /* ── Progress ── */
        .big-progress {
            background:#21262d; border-radius:8px;
            height:14px; overflow:hidden; margin-bottom:.5rem;
        }
        .big-progress-fill {
            height:100%; background:#238636;
            border-radius:8px; transition:width .4s;
        }
        .progress-label {
            display:flex; justify-content:space-between;
            font-size:.82rem; color:rgba(255,255,255,.4);
        }

        /* ── Users Lists ── */
        .users-grid {
            display:grid; grid-template-columns:1fr 1fr; gap:1rem;
        }
        .user-list-box {
            background:#0d1117; border:1px solid #30363d;
            border-radius:10px; padding:1rem;
        }
        .user-list-title {
            font-size:.85rem; font-weight:600;
            margin-bottom:.8rem;
            display:flex; align-items:center; gap:.4rem;
        }
        .user-list-title.green { color:#3fb950; }
        .user-list-title.orange { color:#f0a500; }
        .user-row {
            display:flex; align-items:center;
            gap:.6rem; padding:.4rem 0;
            border-bottom:1px solid rgba(255,255,255,.05);
            font-size:.85rem;
        }
        .user-row:last-child { border-bottom:none; }
        .user-avatar-sm {
            width:28px; height:28px; border-radius:50%;
            display:flex; align-items:center; justify-content:center;
            font-size:.75rem; font-weight:700;
            background:#1f6feb; color:#fff; flex-shrink:0;
        }
        .ack-time {
            margin-right:auto; font-size:.72rem;
            color:rgba(255,255,255,.3);
        }
        .btn {
            display:inline-flex; align-items:center; gap:.4rem;
            padding:.5rem 1rem; border-radius:8px; border:none;
            cursor:pointer; font-size:.88rem; font-weight:500;
            text-decoration:none; transition:all .2s;
        }
        .btn-secondary {
            background:#21262d; color:#e6edf3;
            border:1px solid #30363d;
        }
        .btn-secondary:hover { background:#30363d; }
        .empty-note {
            color:rgba(255,255,255,.3); font-size:.85rem;
            text-align:center; padding:1rem;
        }
    </style>
</head>
<body>

<header class="page-header">
    <h1>
        <i class="fas fa-chart-pie"></i>
        סטטיסטיקת הודעה
    </h1>
    <a href="/UserMessages/Index" class="btn btn-secondary">
        <i class="fas fa-arrow-right"></i> חזור
    </a>
</header>

<div class="content">

    <!-- ── פרטי הודעה ── -->
    <div class="card">
        <div class="card-title">
            <i class="fas fa-bell"></i>
            @Model.Message.Title
        </div>
        <p style="color:rgba(255,255,255,.6); font-size:.9rem;
                  line-height:1.6; margin-bottom:1rem">
            @Model.Message.Content
        </p>
        <div style="font-size:.78rem; color:rgba(255,255,255,.3)">
            <i class="fas fa-user"></i> נוצר על ידי
            @Model.Message.CreatedBy &nbsp;|&nbsp;
            <i class="fas fa-clock"></i>
            @(TimeZoneInfo.ConvertTimeFromUtc(
                Model.Message.CreatedAt, israelTz)
                .ToString("dd/MM/yyyy HH:mm"))
            &nbsp;|&nbsp;
            <i class="fas fa-users"></i>
            @(Model.Message.TargetUserIds == null
                ? "כל המשתמשים"
                : $"{Model.Message.TargetUserIds.Count} משתמשים")
        </div>
    </div>

    <!-- ── סטטיסטיקה ── -->
    <div class="stats-grid">
        <div class="stat-box">
            <div class="val val-blue">@Model.TotalRecipients</div>
            <div class="lbl">סה"כ נמענים</div>
        </div>
        <div class="stat-box">
            <div class="val val-green">@Model.AcknowledgedCount</div>
            <div class="lbl">אישרו קריאה</div>
        </div>
        <div class="stat-box">
            <div class="val val-orange">@Model.PendingCount</div>
            <div class="lbl">טרם קראו</div>
        </div>
    </div>

    <!-- ── Progress Bar ── -->
    <div class="card">
        <div class="card-title">
            <i class="fas fa-tasks"></i>
            אחוז אישורים
        </div>
        <div class="big-progress">
            <div class="big-progress-fill"
                 style="width:@pct%"></div>
        </div>
        <div class="progress-label">
            <span>@Model.AcknowledgedCount אישרו</span>
            <span>@pct%</span>
            <span>@Model.PendingCount ממתינים</span>
        </div>
    </div>

    <!-- ── רשימות משתמשים ── -->
    <div class="users-grid">

        <!-- אישרו -->
        <div class="user-list-box">
            <div class="user-list-title green">
                <i class="fas fa-check-circle"></i>
                קראו ואישרו (@Model.AcknowledgedCount)
            </div>
            @if (!Model.AcknowledgedUsers.Any())
            {
                <div class="empty-note">אין אישורים עדיין</div>
            }
            else
            {
                @foreach (var u in Model.AcknowledgedUsers)
                {
                    var ack = Model.Message.Acknowledgments
                        .FirstOrDefault(a => a.UserId == u.Id);
                    <div class="user-row">
                        <div class="user-avatar-sm">
                            @u.DisplayName.Substring(0,1).ToUpper()
                        </div>
                        <div>
                            <div style="font-size:.85rem">
                                @u.DisplayName
                            </div>
                            <div style="font-size:.72rem;
                                        color:rgba(255,255,255,.35)">
                                @u.Username
                            </div>
                        </div>
                        @if (ack != null)
                        {
                            <span class="ack-time">
                                @(TimeZoneInfo.ConvertTimeFromUtc(
                                    ack.AcknowledgedAt, israelTz)
                                    .ToString("dd/MM HH:mm"))
                            </span>
                        }
                    </div>
                }
            }
        </div>

        <!-- טרם קראו -->
        <div class="user-list-box">
            <div class="user-list-title orange">
                <i class="fas fa-clock"></i>
                טרם קראו (@Model.PendingCount)
            </div>
            @if (!Model.PendingUsers.Any())
            {
                <div class="empty-note">
                    <i class="fas fa-check-double"
                       style="color:#3fb950"></i>
                    כולם קראו!
                </div>
            }
            else
            {
                @foreach (var u in Model.PendingUsers)
                {
                    <div class="user-row">
                        <div class="user-avatar-sm"
                             style="background:#f0a500">
                            @u.DisplayName.Substring(0,1).ToUpper()
                        </div>
                        <div>
                            <div style="font-size:.85rem">
                                @u.DisplayName
                            </div>
                            <div style="font-size:.72rem;
                                        color:rgba(255,255,255,.35)">
                                @u.Username
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
</body>
</html>