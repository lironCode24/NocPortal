@model NocPortal.Models.CreateMessageViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "הודעות מערכת";
    var messages = ViewBag.Messages as List<NocPortal.Models.SystemMessage>
                   ?? new List<NocPortal.Models.SystemMessage>();
    var allUsers = ViewBag.AllUsers as List<NocPortal.Models.AppUser>
                   ?? new List<NocPortal.Models.AppUser>();
    var israelTz = TimeZoneInfo.FindSystemTimeZoneById("Israel Standard Time");
}

@* ── CSS ספציפי לדף ── *@
@section Styles {
    
    <link rel="icon" type="image/x-icon"
          href="https://www.menoramivt.co.il/customers-homepage/static/img/favicon.ico">
    <link rel="stylesheet" href="https://cdn.menoramivt.co.il/public/fonts/fonts.css">
    <link rel="stylesheet" href="/lib/font-awesome/css/all.min.css">
    <link rel="stylesheet" href="~/css/admin-panel.css">
}

@* ── Scripts ספציפיים לדף ── *@
@section Scripts {
<script>
// ── קהל יעד - טופס יצירה ──────────────────────────────────────────────
function setAudience(all) {
    document.getElementById('sendToAllInput').value = all ? 'true' : 'false';
    document.getElementById('specificWrapper').style.display =
        all ? 'none' : 'block';
    document.getElementById('btnAll').classList.toggle('active', all);
    document.getElementById('btnSpecific').classList.toggle('active', !all);
}

// ── סינון משתמשים לפי תפקיד (משותף ליצירה ועריכה) ────────────────────
function onRoleToggle(roleCheckbox, listId) {
    const selectedRole = roleCheckbox.value;
    const isChecked    = roleCheckbox.checked;

    document.querySelectorAll(`#${listId} input[type="checkbox"]`)
        .forEach(userCheckbox => {
            if (userCheckbox.dataset.role === selectedRole) {
                userCheckbox.checked = isChecked;
            }
        });
}

// ── קהל יעד - טופס עריכה ─────────────────────────────────────────────
function setEditAudience(all) {
    document.getElementById('editSendToAll').value = all ? 'true' : 'false';
    document.getElementById('editSpecificWrapper').style.display =
        all ? 'none' : 'block';
    document.getElementById('editBtnAll').classList.toggle('active',  all);
    document.getElementById('editBtnSpecific').classList.toggle('active', !all);
}

// ── פתיחת מודל עריכה ─────────────────────────────────────────────────
function openEditModal(id, title, content, sendToAll, targetIds) {
    document.getElementById('editMessageId').value = id;
    document.getElementById('editTitle').value     = title;
    document.getElementById('editContent').value   = content.replace(/\\n/g, '\n');

    // אפס תיבות תפקיד
    document.querySelectorAll('#editSpecificWrapper .role-check-item input')
        .forEach(cb => cb.checked = false);

    // סמן משתמשים
    document.querySelectorAll('.edit-user-check').forEach(cb => {
        cb.checked = !sendToAll && targetIds.includes(cb.dataset.userid);
    });

    setEditAudience(sendToAll);
    document.getElementById('editModal').style.display = 'flex';
}

function closeEditModal() {
    document.getElementById('editModal').style.display = 'none';
}

// ══ עימוד וחיפוש ══════════════════════════════════════════════════════
const ROWS_PER_PAGE = 9;
let currentPage    = 1;
let filteredRows   = [];

function getAllRows() {
    return Array.from(document.querySelectorAll('.msg-row'));
}

function filterMessages() {
    const q = (document.getElementById('msgSearch')?.value || '')
                .trim().toLowerCase();
    const allRows = getAllRows();

    filteredRows = allRows.filter(row => {
        if (!q) return true;
        const title   = row.dataset.title   || '';
        const content = row.dataset.content || '';
        const users   = row.dataset.users   || '';
        return title.includes(q) || content.includes(q) || users.includes(q);
    });

    allRows.forEach(r => r.style.display = 'none');
    currentPage = 1;
    renderPage();
}

function renderPage() {
    const allRows = getAllRows();
    allRows.forEach(r => r.style.display = 'none');

    const total      = filteredRows.length;
    const totalPages = Math.max(1, Math.ceil(total / ROWS_PER_PAGE));
    if (currentPage > totalPages) currentPage = totalPages;

    const start = (currentPage - 1) * ROWS_PER_PAGE;
    const end   = Math.min(start + ROWS_PER_PAGE, total);

    for (let i = start; i < end; i++) {
        filteredRows[i].style.display = '';
    }

    const noRes = document.getElementById('noResults');
    if (noRes) noRes.style.display = total === 0 ? 'block' : 'none';

    const pageInfo = document.getElementById('pageInfo');
    if (pageInfo) {
        pageInfo.textContent = total > 0
            ? `מציג ${start + 1}–${end} מתוך ${total} הודעות`
            : '';
    }

    renderPagination(totalPages);
}

function renderPagination(totalPages) {
    const container = document.getElementById('paginationControls');
    if (!container) return;
    container.innerHTML = '';
    if (totalPages <= 1) return;

    const prevBtn = document.createElement('button');
    prevBtn.className = 'page-btn';
    prevBtn.innerHTML = '<i class="fas fa-chevron-right"></i>';
    prevBtn.disabled  = currentPage === 1;
    prevBtn.onclick   = () => goToPage(currentPage - 1);
    container.appendChild(prevBtn);

    getPageRange(currentPage, totalPages).forEach(p => {
        if (p === '...') {
            const dots = document.createElement('span');
            dots.textContent = '…';
            dots.style.cssText = 'color:rgba(255,255,255,.3); padding:0 .3rem';
            container.appendChild(dots);
        } else {
            const btn = document.createElement('button');
            btn.className = 'page-btn' +
                (p === currentPage ? ' active-page' : '');
            btn.textContent = p;
            btn.onclick = () => goToPage(p);
            container.appendChild(btn);
        }
    });

    const nextBtn = document.createElement('button');
    nextBtn.className = 'page-btn';
    nextBtn.innerHTML = '<i class="fas fa-chevron-left"></i>';
    nextBtn.disabled  = currentPage === totalPages;
    nextBtn.onclick   = () => goToPage(currentPage + 1);
    container.appendChild(nextBtn);
}

function getPageRange(current, total) {
    if (total <= 7) return Array.from({length: total}, (_, i) => i + 1);
    const pages = [1];
    if (current > 3) pages.push('...');
    for (let i = Math.max(2, current - 1);
             i <= Math.min(total - 1, current + 1); i++) {
        pages.push(i);
    }
    if (current < total - 2) pages.push('...');
    pages.push(total);
    return pages;
}

function goToPage(p) {
    currentPage = p;
    renderPage();
    document.querySelector('.msg-table')?.scrollIntoView(
        {behavior: 'smooth', block: 'start'});
}

function clearSearch() {
    const inp = document.getElementById('msgSearch');
    if (inp) inp.value = '';
    filterMessages();
}

// ── אתחול ─────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.edit-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            openEditModal(
                this.dataset.id,
                this.dataset.title,
                this.dataset.content,
                this.dataset.sendtoall === 'True' ||
                this.dataset.sendtoall === 'true',
                JSON.parse(this.dataset.targetids)
            );
        });
    });

    filteredRows = getAllRows();
    renderPage();
});

// ══ מודל אישורים ══════════════════════════════════════════════════════
let currentAckMessageId = null;
let ackData             = null;

async function openAckModal(messageId) {
    currentAckMessageId = messageId;
    ackData             = null;

    document.getElementById('ackModal').style.display  = 'flex';
    document.getElementById('ackLoading').style.display = 'block';
    document.getElementById('pendingList').innerHTML    = '';
    document.getElementById('ackedList').innerHTML      = '';

    try {
        const res = await fetch(`/api/userMessages/stats/${messageId}`);
        if (!res.ok) throw new Error('שגיאה בטעינת נתונים');

        ackData = await res.json();
        renderAckModal();
    } catch (e) {
        document.getElementById('ackLoading').style.display = 'none';
        document.getElementById('pendingList').innerHTML =
            `<div class="empty-state">
                <i class="fas fa-exclamation-triangle"></i>
                <p>שגיאה בטעינת נתונים</p>
             </div>`;
    }
}

function renderAckModal() {
    if (!ackData) return;

    document.getElementById('ackLoading').style.display = 'none';

    document.getElementById('pendingCount').textContent = ackData.pendingCount;
    document.getElementById('ackedCount').textContent   = ackData.acknowledgedCount;

    const pendingList = document.getElementById('pendingList');
    if (ackData.pendingUsers.length === 0) {
        pendingList.innerHTML =
            `<div class="empty-state">
                <i class="fas fa-check-double"></i>
                <p>כל המשתמשים אישרו!</p>
             </div>`;
        document.getElementById('btnResendAll').style.display = 'none';
    } else {
        document.getElementById('btnResendAll').style.display = '';
        pendingList.innerHTML = ackData.pendingUsers
            .map(u => `
                <div class="ack-user-row" id="row-pending-${u.userId}">
                    <div class="ack-user-info">
                        <span class="ack-user-name">${escHtml(u.displayName)}</span>
                        <span class="ack-user-meta">${escHtml(u.username)}</span>
                    </div>
                    <button class="btn btn-primary btn-sm"
                            onclick="resendToUser(
                                '${currentAckMessageId}',
                                '${u.userId}',
                                '${escHtml(u.displayName)}')">
                        <i class="fas fa-paper-plane"></i>
                        שלח מחדש
                    </button>
                </div>`)
            .join('');
    }

    const ackedList = document.getElementById('ackedList');
    if (ackData.acknowledgedUsers.length === 0) {
        ackedList.innerHTML =
            `<div class="empty-state">
                <i class="fas fa-clock"></i>
                <p>אף משתמש לא אישר עדיין</p>
             </div>`;
    } else {
        ackedList.innerHTML = ackData.acknowledgedUsers
            .map(u => {
                const ackAt = u.acknowledgedAt
                    ? new Date(u.acknowledgedAt)
                        .toLocaleString('he-IL', {timeZone: 'Asia/Jerusalem'})
                    : '';
                return `
                <div class="ack-user-row" id="row-acked-${u.userId}">
                    <div class="ack-user-info">
                        <span class="ack-user-name">${escHtml(u.displayName)}</span>
                        <span class="ack-user-meta">
                            ${escHtml(u.username)}
                            ${ackAt ? ` · אישר ב-${ackAt}` : ''}
                        </span>
                    </div>
                    <button class="btn btn-secondary btn-sm"
                            onclick="resendToUser(
                                '${currentAckMessageId}',
                                '${u.userId}',
                                '${escHtml(u.displayName)}')">
                        <i class="fas fa-redo"></i>
                        שלח שוב
                    </button>
                </div>`;
            })
            .join('');
    }

    switchTab('pending');
}

function switchTab(tab) {
    const isPending = tab === 'pending';
    document.getElementById('panelPending').style.display =
        isPending ? 'block' : 'none';
    document.getElementById('panelAcked').style.display   =
        isPending ? 'none'  : 'block';
    document.getElementById('tabPending')
        .classList.toggle('tab-active',  isPending);
    document.getElementById('tabAcked')
        .classList.toggle('tab-active', !isPending);
}

async function resendToUser(messageId, userId, displayName) {
    if (!confirm(`לשלוח את ההודעה מחדש ל-${displayName}?`)) return;

    const token = document.querySelector(
        'input[name="__RequestVerificationToken"]')?.value;

    try {
        const res = await fetch('/UserMessages/Resend', {
            method:  'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: `messageId=${encodeURIComponent(messageId)}`
                + `&userId=${encodeURIComponent(userId)}`
        });

        const data = await res.json();
        if (data.success) {
            showToast(`ההודעה תישלח מחדש ל-${displayName}`, 'success');
            await openAckModal(messageId);
        } else {
            showToast(data.message || 'שגיאה', 'error');
        }
    } catch {
        showToast('שגיאת רשת', 'error');
    }
}

async function resendAll() {
    if (!ackData || !currentAckMessageId) return;
    const count = ackData.pendingUsers.length;
    if (!confirm(`לשלוח מחדש ל-${count} משתמשים שלא אישרו?`)) return;

    const token = document.querySelector(
        'input[name="__RequestVerificationToken"]')?.value;

    let successCount = 0;
    for (const u of ackData.pendingUsers) {
        try {
            const res = await fetch('/UserMessages/Resend', {
                method:  'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `messageId=${encodeURIComponent(currentAckMessageId)}`
                    + `&userId=${encodeURIComponent(u.userId)}`
            });
            const data = await res.json();
            if (data.success) successCount++;
        } catch { /* המשך לשאר */ }
    }

    showToast(`נשלח מחדש ל-${successCount} משתמשים`, 'success');
    await openAckModal(currentAckMessageId);
}

function closeAckModal() {
    document.getElementById('ackModal').style.display = 'none';
    currentAckMessageId = null;
    ackData             = null;
}

// ── Toast ──────────────────────────────────────────────────────────────
function showToast(msg, type = 'success') {
    const toast = document.createElement('div');
    toast.style.cssText = `
        position: fixed;
        bottom: 1.5rem;
        left: 50%;
        transform: translateX(-50%);
        background: ${type === 'success' ? '#238636' : '#da3633'};
        color: #fff;
        padding: .7rem 1.4rem;
        border-radius: 8px;
        font-size: .9rem;
        z-index: 99999;
        box-shadow: 0 4px 12px rgba(0,0,0,.4);
        display: flex;
        align-items: center;
        gap: .5rem;
    `;
    toast.innerHTML = `
        <i class="fas fa-${type === 'success'
            ? 'check-circle' : 'exclamation-circle'}"></i>
        ${escHtml(msg)}`;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 3000);
}

// ── XSS protection ────────────────────────────────────────────────────
function escHtml(str) {
    return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}
</script>
}

@* ══ ALERTS ══════════════════════════════════════════════════════════ *@
<div style="max-width:1200px; margin:1rem auto; padding:0 1.5rem">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error">
            <i class="fas fa-exclamation-circle"></i>
            @TempData["Error"]
        </div>
    }
</div>

@* ══ MAIN CONTENT ════════════════════════════════════════════════════ *@
<div class="admin-main-content page-content">

    @* ══ טופס יצירת הודעה ══ *@
    <div class="card">
        <div class="card-title">
            <i class="fas fa-plus-circle"></i>
            הודעה חדשה
        </div>

        <form method="post" asp-action="Create" asp-controller="UserMessages">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>כותרת ההודעה</label>
                <input type="text"
                       name="Title"
                       class="form-control"
                       placeholder="לדוגמה: עדכון מערכת חשוב"
                       required />
            </div>

            <div class="form-group">
                <label>תוכן ההודעה</label>
                <textarea name="Content"
                          class="form-control"
                          placeholder="כתוב את תוכן ההודעה כאן..."
                          required></textarea>
            </div>

            @* ── קהל יעד ── *@
            <div class="form-group">
                <label>קהל יעד</label>
                <div class="audience-toggle">
                    <button type="button"
                            class="audience-btn active"
                            id="btnAll"
                            onclick="setAudience(true)">
                        <i class="fas fa-users"></i>
                        כל המשתמשים
                    </button>
                    <button type="button"
                            class="audience-btn"
                            id="btnSpecific"
                            onclick="setAudience(false)">
                        <i class="fas fa-user-check"></i>
                        משתמשים ספציפיים
                    </button>
                </div>
                <input type="hidden" name="SendToAll" id="sendToAllInput" value="true" />

                <div id="specificWrapper" style="display:none; margin-top:.8rem">
                    <div class="role-users-grid">

                        <div>
                            <div style="font-size:.78rem; color:rgba(255,255,255,.4);
                                        margin-bottom:.4rem">
                                סנן לפי תפקיד
                            </div>
                            <div class="role-checklist">
                                @foreach (var role in new[] { "NOC", "Admin", "Dashboard" })
                                {
                                    <label class="role-check-item">
                                        <input type="checkbox"
                                               value="@role"
                                               onchange="onRoleToggle(this, 'usersChecklist')" />
                                        <span>@role</span>
                                    </label>
                                }
                            </div>
                        </div>

                        <div>
                            <div style="font-size:.78rem; color:rgba(255,255,255,.4);
                                        margin-bottom:.4rem">
                                בחר משתמשים
                            </div>
                            <div class="users-checklist" id="usersChecklist">
                                @foreach (var u in allUsers)
                                {
                                    <label class="user-check-item">
                                        <input type="checkbox"
                                               name="targetUserIds"
                                               value="@u.Id"
                                               data-role="@u.Role" />
                                        <span>@u.DisplayName</span>
                                        <span style="color:rgba(255,255,255,.35);
                                                     font-size:.78rem;
                                                     margin-right:auto">
                                            @u.Role
                                        </span>
                                    </label>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%">
                <i class="fas fa-paper-plane"></i>
                שלח הודעה
            </button>
        </form>
    </div>

    @* ══ רשימת הודעות ══ *@
    <div class="card">
        <div class="card-title">
            <i class="fas fa-list"></i>
            הודעות שנשלחו
            <span style="margin-right:auto; font-size:.8rem; color:rgba(255,255,255,.35)">
                סה"כ @messages.Count
            </span>
        </div>

        @if (messages.Any())
        {
            <div style="margin-bottom:1rem; display:flex; gap:.6rem; align-items:center">
                <div style="position:relative; flex:1">
                    <i class="fas fa-search" style="position:absolute; right:.8rem;
                       top:50%; transform:translateY(-50%);
                       color:rgba(255,255,255,.3); font-size:.85rem;
                       pointer-events:none"></i>
                    <input type="text"
                           id="msgSearch"
                           class="form-control"
                           placeholder="חיפוש לפי כותרת / תוכן / משתמש..."
                           style="padding-right:2.2rem"
                           oninput="filterMessages()" />
                </div>
                <button class="btn btn-secondary btn-sm" onclick="clearSearch()">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div id="noResults" style="display:none" class="empty-state">
                <i class="fas fa-search"></i>
                <p>לא נמצאו הודעות תואמות</p>
            </div>
        }

        @if (!messages.Any())
        {
            <div class="empty-state">
                <i class="fas fa-bell-slash"></i>
                <p>אין הודעות עדיין</p>
            </div>
        }
        else
        {
            <table class="msg-table">
                <thead>
                    <tr>
                        <th>כותרת</th>
                        <th>תאריך</th>
                        <th>אישורים</th>
                        <th>מי אישר</th>
                        <th>סטטוס</th>
                        <th>פעולות</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var msg in messages)
                    {
                        var ackCount    = msg.Acknowledgments.Count;
                        var targetCount = msg.TargetUserIds?.Count ?? allUsers.Count;
                        var pct         = targetCount > 0
                            ? (int)((double)ackCount / targetCount * 100)
                            : 0;

                        <tr class="msg-row"
                            data-title="@msg.Title.ToLower()"
                            data-content="@msg.Content.ToLower()"
                            data-users="@(msg.TargetUserIds == null
                                ? "כל המשתמשים"
                                : string.Join(" ", allUsers
                                    .Where(u => msg.TargetUserIds.Contains(u.Id))
                                    .Select(u => u.DisplayName.ToLower())))">
                            <td>
                                <div style="font-weight:500">@msg.Title</div>
                                <div style="font-size:.75rem;
                                            color:rgba(255,255,255,.35);
                                            margin-top:.2rem">
                                    @(msg.TargetUserIds == null
                                        ? "כל המשתמשים"
                                        : $"{msg.TargetUserIds.Count} משתמשים")
                                </div>
                            </td>
                            <td style="font-size:.78rem; color:rgba(255,255,255,.4)">
                                @(msg.CreatedAt.Kind == DateTimeKind.Utc
                                    ? TimeZoneInfo.ConvertTimeFromUtc(
                                        msg.CreatedAt, israelTz).ToString("dd/MM/yy HH:mm")
                                    : msg.CreatedAt.ToString("dd/MM/yy HH:mm"))
                            </td>
                            <td>
                                <div class="progress-wrap">
                                    <div class="progress-bar-bg">
                                        <div class="progress-bar-fill"
                                             style="width:@pct%"></div>
                                    </div>
                                    <span style="white-space:nowrap; font-size:.78rem;
                                                 direction:ltr; color:rgba(255,255,255,.5)">
                                        @ackCount / @targetCount
                                    </span>
                                </div>
                            </td>
                            <td>
                                <button type="button"
                                        class="btn btn-secondary btn-sm"
                                        onclick="openAckModal('@msg.Id')"
                                        title="הצג פרטי אישורים">
                                    <i class="fas fa-users"></i>
                                    <span style="font-size:.75rem">
                                        @ackCount/@targetCount
                                    </span>
                                </button>
                            </td>
                            <td>
                                @if (msg.IsActive)
                                {
                                    <span class="badge badge-active">
                                        <i class="fas fa-circle" style="font-size:.5rem"></i>
                                        פעיל
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-inactive">
                                        <i class="fas fa-ban"></i>
                                        בוטל
                                    </span>
                                }
                            </td>
                            <td>
                                <div style="display:flex; gap:.4rem; flex-wrap:wrap">
                                    <a asp-action="Stats"
                                       asp-controller="UserMessages"
                                       asp-route-messageId="@msg.Id"
                                       class="btn btn-secondary btn-sm"
                                       title="סטטיסטיקה">
                                        <i class="fas fa-chart-pie"></i>
                                    </a>
                                    @if (msg.IsActive)
                                    {
                                        <button type="button"
                                                class="btn btn-secondary btn-sm edit-btn"
                                                data-id="@msg.Id"
                                                data-title="@msg.Title"
                                                data-content="@msg.Content"
                                                data-sendtoall="@(msg.TargetUserIds == null)"
                                                data-targetids='@Html.Raw(
                                                    System.Text.Json.JsonSerializer.Serialize(
                                                        msg.TargetUserIds ?? new List<string>()))'
                                                title="עריכה">
                                            <i class="fas fa-pen"></i>
                                        </button>

                                        <form method="post"
                                              asp-action="Deactivate"
                                              asp-controller="UserMessages"
                                              style="margin:0"
                                              onsubmit="return confirm('לבטל את ההודעה?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden"
                                                   name="messageId"
                                                   value="@msg.Id" />
                                            <button type="submit"
                                                    class="btn btn-danger btn-sm"
                                                    title="בטל הודעה">
                                                <i class="fas fa-ban"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div id="paginationControls"
                 style="display:flex; align-items:center; justify-content:center;
                        gap:.5rem; margin-top:1rem; flex-wrap:wrap">
            </div>
            <div id="pageInfo"
                 style="text-align:center; font-size:.78rem;
                        color:rgba(255,255,255,.3); margin-top:.4rem">
            </div>
        }
    </div>
</div>

@* ══ EDIT MODAL ══ *@
<div class="modal-overlay" id="editModal" style="display:none"
     onclick="if(event.target===this) closeEditModal()">
    <div class="modal-box">
        <div class="modal-header">
            <div class="modal-title">
                <i class="fas fa-pen"></i>
                עריכת הודעה
            </div>
            <button class="modal-close-btn"
                    onclick="closeEditModal()">&times;</button>
        </div>

        <form method="post"
              asp-action="Edit"
              asp-controller="UserMessages"
              id="editForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="messageId" id="editMessageId" />
            <input type="hidden" name="sendToAll" id="editSendToAll" value="true" />

            <div class="form-group">
                <label>כותרת</label>
                <input type="text"
                       name="title"
                       id="editTitle"
                       class="form-control"
                       required />
            </div>

            <div class="form-group">
                <label>תוכן</label>
                <textarea name="content"
                          id="editContent"
                          class="form-control"
                          required></textarea>
            </div>

            <div class="form-group">
                <label>קהל יעד</label>
                <div class="audience-toggle">
                    <button type="button"
                            class="audience-btn"
                            id="editBtnAll"
                            onclick="setEditAudience(true)">
                        <i class="fas fa-users"></i>
                        כל המשתמשים
                    </button>
                    <button type="button"
                            class="audience-btn"
                            id="editBtnSpecific"
                            onclick="setEditAudience(false)">
                        <i class="fas fa-user-check"></i>
                        ספציפיים
                    </button>
                </div>

                <div id="editSpecificWrapper" style="display:none; margin-top:.8rem">
                    <div class="role-users-grid">

                        <div>
                            <div style="font-size:.78rem; color:rgba(255,255,255,.4);
                                        margin-bottom:.4rem">
                                סנן לפי תפקיד
                            </div>
                            <div class="role-checklist">
                                @foreach (var role in new[] { "NOC", "Admin", "Dashboard" })
                                {
                                    <label class="role-check-item">
                                        <input type="checkbox"
                                               value="@role"
                                               onchange="onRoleToggle(this, 'editUsersChecklist')" />
                                        <span>@role</span>
                                    </label>
                                }
                            </div>
                        </div>

                        <div>
                            <div style="font-size:.78rem; color:rgba(255,255,255,.4);
                                        margin-bottom:.4rem">
                                בחר משתמשים
                            </div>
                            <div class="users-checklist" id="editUsersChecklist">
                                @foreach (var u in allUsers)
                                {
                                    <label class="user-check-item">
                                        <input type="checkbox"
                                               name="targetUserIds"
                                               value="@u.Id"
                                               class="edit-user-check"
                                               data-userid="@u.Id"
                                               data-role="@u.Role" />
                                        <span>@u.DisplayName</span>
                                        <span style="color:rgba(255,255,255,.35);
                                                     font-size:.78rem;
                                                     margin-right:auto">
                                            @u.Role
                                        </span>
                                    </label>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div style="display:flex; gap:.8rem; justify-content:flex-end">
                <button type="button"
                        class="btn btn-secondary"
                        onclick="closeEditModal()">
                    <i class="fas fa-times"></i> ביטול
                </button>
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save"></i> שמור
                </button>
            </div>
        </form>
    </div>
</div>

@* ══ ACKNOWLEDGMENT MODAL ══ *@
<div class="modal-overlay" id="ackModal" style="display:none"
     onclick="if(event.target===this) closeAckModal()">
    <div class="modal-box" style="max-width:700px">
        <div class="modal-header">
            <div class="modal-title">
                <i class="fas fa-users"></i>
                סטטוס אישורים
            </div>
            <button class="modal-close-btn"
                    onclick="closeAckModal()">&times;</button>
        </div>

        <div style="display:flex; gap:.5rem; margin-bottom:1rem">
            <button class="btn btn-secondary btn-sm"
                    id="tabPending"
                    onclick="switchTab('pending')"
                    style="flex:1">
                <i class="fas fa-clock"></i>
                ממתינים
                <span id="pendingCount"
                      style="background:#da3633; color:#fff;
                             border-radius:10px; padding:.1rem .4rem;
                             font-size:.75rem; margin-right:.3rem">
                </span>
            </button>
            <button class="btn btn-secondary btn-sm"
                    id="tabAcked"
                    onclick="switchTab('acked')"
                    style="flex:1">
                <i class="fas fa-check-circle"></i>
                אישרו
                <span id="ackedCount"
                      style="background:#238636; color:#fff;
                             border-radius:10px; padding:.1rem .4rem;
                             font-size:.75rem; margin-right:.3rem">
                </span>
            </button>
        </div>

        <div id="panelPending">
            <div style="display:flex; justify-content:flex-end; margin-bottom:.6rem">
                <button class="btn btn-primary btn-sm"
                        id="btnResendAll"
                        onclick="resendAll()">
                    <i class="fas fa-paper-plane"></i>
                    שלח מחדש לכולם
                </button>
            </div>
            <div id="pendingList"></div>
        </div>

        <div id="panelAcked" style="display:none">
            <div id="ackedList"></div>
        </div>

        <div id="ackLoading"
             style="text-align:center; padding:2rem;
                    color:rgba(255,255,255,.4); display:none">
            <i class="fas fa-spinner fa-spin"></i>
            טוען...
        </div>
    </div>
</div>