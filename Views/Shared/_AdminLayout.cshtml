@* Views/Shared/_AdminLayout.cshtml *@
<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NOC Admin</title>
    <link rel="icon" type="image/x-icon"
          href="https://www.menoramivt.co.il/customers-homepage/static/img/favicon.ico">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="/lib/font-awesome/css/all.min.css">

    <!-- Admin Navbar CSS -->
    <link rel="stylesheet" href="~/css/admin-panel.css" />
    <link rel="stylesheet" href="~/css/noc-portal.css" />

    <!-- CSS ספציפי לדף -->
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-body">

    <!-- ══ NAVBAR קבוע בראש המסך ══ -->
    @await Html.PartialAsync("_AdminNavBar")

    <!-- ══ תוכן הדף ══ -->
    <main class="admin-main-content">
        @RenderBody()
    </main>

    <!-- Scripts -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>