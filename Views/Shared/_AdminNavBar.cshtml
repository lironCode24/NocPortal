@* Views/Shared/_AdminNavBar.cshtml *@
@using System.Security.Claims

@{
    var displayName = User.FindFirst("DisplayName")?.Value ?? "מנהל";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<header class="admin-navbar">
    
    <!-- ══ שורה עליונה: לוגו + מידע משתמש ══ -->
    <div class="admin-navbar-top">
        <div class="navbar-brand">
            <i class="fas fa-shield-alt"></i>
            <span>NOC Portal - ניהול</span>
        </div>

        <div class="navbar-user-info">
            <i class="fas fa-user-shield"></i>
            <span>@displayName</span>
            
            <form method="post" action="/Auth/Logout" onsubmit="clearUserLocalStorage()">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-logout btn-header-logout" title="התנתק">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>יציאה</span>
                </button>
            </form>
        </div>
    </div>

    <!-- ══ שורת ניווט קבועה ══ -->
    <nav class="admin-navbar-nav">

        <!-- דשבורד ניהול -->
        <a asp-action="AdminPanel" 
           asp-controller="Auth"
           class="nav-item @(currentAction == "AdminPanel" ? "active" : "")"
           title="דשבורד ראשי מסך ניהול">
            <i class="fas fa-th-large"></i>
            <span>מסך ראשי - ניהול</span>
        </a>

        <!-- ניהול משתמשים -->
        <a asp-action="Users" 
           asp-controller="Auth"
           class="nav-item @(currentAction == "Users" ? "active" : "")"
           title="ניהול משתמשים">
            <i class="fas fa-users-cog"></i>
            <span>משתמשים</span>
            @* Badge למשתמשים ממתינים *@
            @if (ViewBag.PendingCount != null && (int)ViewBag.PendingCount > 0)
            {
                <span class="nav-badge">@ViewBag.PendingCount</span>
            }
        </a>

        <!-- לוג פעילות -->
        <a asp-action="AuditLog" 
           asp-controller="Auth"
           class="nav-item @(currentAction == "AuditLog" ? "active" : "")"
           title="לוג פעילות">
            <i class="fas fa-clipboard-list"></i>
            <span>לוג פעילות</span>
        </a>

        <!-- הודעות מערכת -->
        <a asp-action="Index" 
           asp-controller="UserMessages"
           class="nav-item @(currentController == "UserMessages" ? "active" : "")"
           title="הודעות מערכת">
            <i class="fas fa-bell"></i>
            <span>הודעות מערכת</span>
        </a>

        <!-- ניהול שינויים - ספר טלפונים -->
        <a asp-action="Index"
        asp-controller="PhoneDirectoryChanges"
        class="nav-item @(currentController == "PhoneDirectoryChanges" ? "active" : "")"
        title="ניהול שינויים - ספר טלפונים">
            <i class="fas fa-exchange-alt"></i>
            <span>שינויים - ספר טלפונים</span>
        </a>

        <!-- ניהול שליחת אישורי כניסה אוטומטים - מייל אישור כניסה -->
        <a asp-action="BlockedDaysManager"
        asp-controller="Messages"
        class="nav-item @(currentAction == "BlockedDaysManager" ? "active" : "")"
        title="ניהול שליחת אישורי כניסה אוטומטים">
            <i class="fas fa-calendar-times"></i>
            <span>ניהול שליחת אישורי כניסה אוטומטים</span>
        </a>
        
        <!-- מפריד -->
        <div class="nav-separator"></div>
        <div class="nav-spacer"></div>

        <!-- דשבורדים -->
        <a href="/dashboards"
           class="nav-item nav-action-btn"
           title="דשבורדים">
            <i class="fas fa-chart-bar"></i>
            <span>מעבר לדשבורדים</span>
        </a>

        <!-- פורטל ראשי -->
        <a href="/Home"
           class="nav-item nav-action-btn"
           title="פורטל ראשי">
            <i class="fas fa-home"></i>
            <span>מעבר לפורטל</span>
        </a>

    </nav>
</header>

<script>
        function clearUserLocalStorage() {
            // מחק נתוני משתמש מ-localStorage
            const keysToRemove = [
                'currentUser',
                'lastSelectedEmployee'
            ];
            
            keysToRemove.forEach(key => userSettings.removeItem(key));
            
            // מחק מ-sessionStorage
            sessionStorage.removeItem('currentUser');
            
        }
</script>